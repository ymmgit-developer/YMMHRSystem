@model DtoProcess
@using YMMHRSystemLogic
@{
    Layout = null;
}
<div class="dialog-title">Processes</div>

<div class="dialog-content">
    <form id="ProcessForm" data-role="validator" data-on-validate-form="AddProcess()" action="javascript:">

        <div class="row">
            <div class="cell-md-12">
                <div class="row mb-2">
                    <div class="cell">
                        <input type="text" name="Name" id="Name" data-role="input" data-prepend="Name:" data-validate="required" class="process" autocomplete="off" value="@Model.Name">
                        <span class="invalid_feedback">
                            Enter a Name
                        </span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <input type="text" name="Code" id="Code" data-role="input" data-prepend="Code:" data-validate="required" class="process" autocomplete="off" value="@Model.Code">
                        <span class="invalid_feedback">
                            Enter a Code
                        </span>
                    </div>
                </div>
            </div>
        </div>
        @Html.Hidden("UserCreated", Model.UserCreated)
        @Html.Hidden("DateAdded", Model.DateAdded)
        <div class="row">
            <div class="row mt-2 mb-2">
                <div class="dialog-actions p-0 d-flex flex-justify-start">
                    @if (HttpContext.Current.Session["CanSaveProcess"].Equals(true))
                    {
                        <div><button id="SaveProcess" class="button my-control-colors"><span class="mif-floppy-disk"></span> Save </button></div>
                    }
                    <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>

                </div>
            </div>
        </div>
    </form>
</div>

