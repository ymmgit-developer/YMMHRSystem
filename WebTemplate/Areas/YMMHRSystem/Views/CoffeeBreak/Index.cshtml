@model List<DtoCoffeeBreak>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Coffee Break";
}
<head>
    <script>
        $SaveCoffeeBreak = '@Url.Action("SaveCoffeeBreak", "CoffeeBreak", new { area = "YMMHRSystem" })';
        $LoadCoffeeBreak = '@Url.Action("LoadCoffeeBreak", "CoffeeBreak", new { area = "YMMHRSystem" })';
        $StartCoffeeBreak = '@Url.Action("StartCoffeeBreak", "CoffeeBreak", new { area = "YMMHRSystem" })';
        $EndCoffeeBreak = '@Url.Action("EndCoffeeBreak", "CoffeeBreak", new { area = "YMMHRSystem" })';
        $DeleteCoffeeBreak = '@Url.Action("DeleteCoffeeBreak", "CoffeeBreak", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/CoffeeBreak.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Coffee Break</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSaveCoffeeBreak"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' onclick="CoffeeBreakDetailDialog(0)"><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>

    <div class="container-fluid mt-5">
        <div id="CoffeeBreaksTable" data-step="2" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttCoffeeBreaks" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th style="text-align: center">Responsable</th>
                        <th style="text-align: center">Start Date</th>
                        <th style="text-align: center">Finish Date</th>
                        <th style="text-align: center">Start Time</th>
                        <th style="text-align: center">Finish Time</th>
                        <th style="text-align: center">Room</th>
                        <th style="text-align: center">Status</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                    <tr>

                        <td style="text-align: center">
                            <span> @item.Responsable </span>
                        </td>

                        <td style="text-align: center">
                            <span> @(item.StartDate?.ToShortDateString()) </span>
                        </td>

                        <td style="text-align: center">
                            <span> @(item.FinishDate?.ToShortDateString()) </span>
                        </td>

                        <td style="text-align: center">
                            <span> @item.StartTime </span>
                        </td>

                        <td style="text-align: center">
                            <span> @item.FinishTime </span>
                        </td>

                        <td style="text-align: center">
                            <span> @item.Room </span>
                        </td>

                        <td style="text-align: center">
                            <span> @(item.Status == 3 ? "Complete" : item.Status == 2 ? "In Progress" : "New") </span>
                        </td>

                        <td style="text-align: center">
                            <a class="button bg-black fg-white" style="cursor: pointer;" onclick="CoffeeBreakDetailDialog(@item.CoffeeBreakId)"><span class="mif-eye"></span><span class="actionButton"> View</span></a>
                            @if (HttpContext.Current.Session["CanDeleteCoffeeBreak"].Equals(true))
                            {
                                <a class="button bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteCoffeeBreak(@item.CoffeeBreakId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                            }
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-width="1000" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="CoffeeBreakDetail" name="CoffeeBreakDetail" class="dialog" data-role="dialog">
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="Error" name="Error" class="dialog" data-role="dialog">
        <div class="dialog-title">Error</div>
        <div class="dialog-content">
            <p>- Coffee Break already exists</p>
        </div>
        <div class="dialog-actions ml-auto">
            <button class="button alert" onclick="Metro.dialog.close('#Error')">OK</button>
        </div>
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteCoffeeBreak" name="DeleteCoffeeBreak" class="dialog" data-role="dialog">
        <div class="dialog-title">Delete</div>
        <div class="dialog-content"> Are you sure you want to delete this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="DeleteCoffeeBreak()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#DeleteCoffeeBreak')"> No</button>
        </div>
    </div>
</body>

