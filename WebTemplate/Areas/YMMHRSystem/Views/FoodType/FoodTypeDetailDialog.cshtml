@model DtoFoodType
@using YMMHRSystemLogic
@{
    Layout = null;
}
<div class="dialog-title">Food Type</div>

<div class="dialog-content">
    <form id="FoodTypeForm" data-role="validator" data-on-validate-form="AddFoodType()" action="javascript:">

        <div class="row">
            <div class="cell-md-12">
                <div class="row mb-2">
                    <div class="cell">
                        <input type="text" name="Name" id="Name" data-role="input" data-prepend="Name:" data-validate="required" class="foodtype" autocomplete="off" value="@Model.Name">
                        <span class="invalid_feedback">
                            Enter a Name
                        </span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <input type="text" name="Code" id="Code" data-role="input" data-prepend="Code:" data-validate="required" class="foodtype" autocomplete="off" value="@Model.Code">
                        <span class="invalid_feedback">
                            Enter a Code
                        </span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <input type="text" data-role="input" value="@Model.Cost" data-validate="required" data-prepend="Cost: $" id="Cost" name="Cost">
                        <span class="invalid_feedback">
                            Enter a Cost
                        </span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        @if (Model.Extraordinary)
                        {
                            <input type="checkbox" data-role="checkbox" data-style="2" checked="checked" data-caption="Extraordinary" class="foodtypeCheck">
                        }
                        else
                        {
                            <input type="checkbox" data-role="checkbox" data-style="2" data-caption="Extraordinary" class="foodtypeCheck">
                        }
                    </div>
                </div>
            </div>
        </div>
        @Html.Hidden("Extraordinary", Model.Extraordinary)
        @Html.Hidden("UserCreated", Model.UserCreated)
        @Html.Hidden("DateAdded", Model.DateAdded)
        <div class="row">
            <div class="row mt-2 mb-2">
                <div class="dialog-actions p-0 d-flex flex-justify-start">
                    @if (HttpContext.Current.Session["CanSaveFoodType"].Equals(true))
                    {
                        <div><button id="SaveFoodType" class="button my-control-colors"><span class="mif-floppy-disk"></span> Save </button></div>
                    }
                    <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>

                </div>
            </div>
        </div>
    </form>
</div>
<script type="text/javascript">
    $(document).ready(function () {

        $(".foodtypeCheck").on("change", function (e) {
            if (e.target.checked) {
                $('#Extraordinary').val("true");
            } else {
                $('#Extraordinary').val("false");
            }
        });

        setInterval(function () {
            $("#Cost").val($("#Cost").val().toString().match(/^-?\d+(?:\.\d{0,2})?/));
        }, 500);
    });
</script>

