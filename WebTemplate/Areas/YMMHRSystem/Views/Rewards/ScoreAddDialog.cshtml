@model DtoImprovements
@using YMMHRSystemLogic


@{
    ViewBag.Title = "Add Score";
    List<DtoImprovements> improvement = ViewBag.Improvements;
    List<DtoWorkerFile> workerFiles = ViewBag.Workers;

    var workers = ViewBag.Workers as List<DtoWorkerFile> ?? new List<DtoWorkerFile>();
    var improvements = ViewBag.Improvements as List<DtoImprovements> ?? new List<DtoImprovements>();

    var staffWorkers = workers.Where(w => (w.Type ?? "").Equals("Staff", StringComparison.OrdinalIgnoreCase)).ToList();
    var unionWorkers = workers.Where(w => (w.Type ?? "").Equals("Union Worker", StringComparison.OrdinalIgnoreCase)).ToList();

    bool hasStaff = staffWorkers.Any();
    bool hasUnion = unionWorkers.Any();

    // Improvements por WorkerType (A/B/C)
    var impA = improvements.Where(i => (i.WorkerType ?? "") == "A").ToList();
    var impB = improvements.Where(i => (i.WorkerType ?? "") == "B").ToList();
    var impC = improvements.Where(i => (i.WorkerType ?? "") == "C").ToList();

    // Determinar qué bloques mostrar según selección real
    bool showA = hasUnion && impA.Any();
    bool showB = hasStaff && impB.Any();
    bool showC = improvements.Any(i => (i.WorkerType ?? "") == "C"); // C generalmente aplica si existe

    @functions{
        string GetJobStyle(string job)
        {
            return job == "ASSOCIATE PRODUCTION" ? "bg-blue fg-white" :
                   job == "TEAM LEADER" ? "bg-indigo fg-white" :
                   job == "COORDINATOR" ? "bg-brown fg-white" :
                   job == "ADVANCED TECHNICAL STAFF" ? "bg-magenta fg-white" :
                   job == "ASSISTANT  MANAGER" ? "bg-orange fg-white" :
                   job == "MANAGER" ? "bg-violet fg-white" :
                   job == "SENIOR MANAGER" ? "bg-red fg-white" :
                   job == "VICE PRESIDENT" ? "bg-red fg-white" :
                   "bg-black fg-white";
        }
    }
}

<head>
    <script>

    </script>
</head>

<style>
    /* 20% alto visible y scroll interno */
    .rw-list {
        height: 20vh;
        overflow-y: auto;
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 10px;
        background: #fff;
    }
    /* Activa el scroll en el dialog */
    .dialog-content {
        overflow-y: auto;
        overflow-x: hidden;
        padding-right: 10px; /* evita que el scroll tape contenido */
    }
    /* Divisor */
    .imp-divider-metro {
        height: 2px;
        background: linear-gradient(to right, #1976d2, #42a5f5);
        margin: 25px 0;
        border-radius: 2px;
    }
</style>

<div class="dialog-title">Add Scores</div>

<div class="dialog-content" data-height="auto">
    <div class="container">
        <input type="hidden" id="trustedWorkerIds" value="@string.Join(",", staffWorkers.Select(w => w.WorkerId))" />
        <input type="hidden" id="associateWorkerIds" value="@string.Join(",", unionWorkers.Select(w => w.WorkerId))" />

        <!-- Workers -->
        <div class="row mb-3">
            @if (hasStaff && hasUnion)
            {
                <div class="col-md-6">
                    <h6>Trusted Personnel</h6>
                    <div class="rw-list">
                        <ul data-role="list" data-cls-list="unstyled-list">
                            @foreach (var w in staffWorkers)
                            {
                                <li><strong>@w.Names</strong> <kbd class="@GetJobStyle(w.Job)">@w.Job</kbd></li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="col-md-6">
                    <h6>Associates</h6>
                    <div class="rw-list">
                        <ul data-role="list" data-cls-list="unstyled-list">
                            @foreach (var w in unionWorkers)
                            {
                                <li><strong>@w.Names</strong> <kbd class="@GetJobStyle(w.Job)">@w.Job</kbd></li>
                            }
                        </ul>
                    </div>
                </div>
            }
            else
            {
                var title = hasStaff ? "Staff" : "Union Worker";
                var list = hasStaff ? staffWorkers : unionWorkers;

                <div class="col-12">
                    <h6>@title</h6>
                    <div class="rw-list">
                        <ul data-role="list" data-cls-list="unstyled-list">
                            @foreach (var w in list)
                            {
                                <li><strong>@w.Names</strong> <kbd class="@GetJobStyle(w.Job)">@w.Job</kbd></li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>

        <div class="row">
            @* ---------- B: Trusted Personnel ---------- *@
            @if (showB)
            {
                var catB = impB
                    .GroupBy(x => string.IsNullOrWhiteSpace(x.CategoryName) ? "General" : x.CategoryName)
                    .OrderBy(g => g.Key)
                    .ToList();

                <div class="col-12 @(showA ? "col-md-6" : "") mt-1">
                    <div data-role="accordion" data-one-frame="false">
                        @foreach (var cat in catB)
                        {
                            <div class="frame">
                                <div class="heading">@cat.Key</div>
                                <div class="content">
                                    <div class="row">
                                        @foreach (var imp in cat.OrderBy(x => x.ImprovemenName))
                                        {
                                            var hint = string.IsNullOrWhiteSpace(imp.DescriptionImpro)
                                                ? null
                                                : System.Web.HttpUtility.HtmlAttributeEncode(imp.DescriptionImpro);

                                            <div class="col-12 col-sm-6 col-lg-3 mt-1">
                                                <label>
                                                    <input type="checkbox" class="imp-check"
                                                           value="@imp.ImprovementId"
                                                           data-score="@imp.ScoreValue"
                                                           data-workertype="@imp.WorkerType" />

                                                    <span class="ml-1">
                                                        <strong
                                                                @Html.Raw(hint == null ? "" : $"data-role=\"hint\" data-hint-text=\"{hint}\" data-hint-position=\"top\"")>
                                                            @imp.ImprovemenName
                                                        </strong>
                                                        <kbd class="bg-green fg-white">@imp.ScoreValue pts</kbd>
                                                    </span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* ---------- A: Associates ---------- *@
            @if (showA)
            {
                var catA = impA
                    .GroupBy(x => string.IsNullOrWhiteSpace(x.CategoryName) ? "General" : x.CategoryName)
                    .OrderBy(g => g.Key)
                    .ToList();

                <div class="col-12 @(showB ? "col-md-6" : "") mt-1">
                    <div data-role="accordion" data-one-frame="false">
                        @foreach (var cat in catA)
                        {
                            <div class="frame">
                                <div class="heading">@cat.Key</div>
                                <div class="content">
                                    <div class="row">
                                        @foreach (var imp in cat.OrderBy(x => x.ImprovemenName))
                                        {
                                            var hint = string.IsNullOrWhiteSpace(imp.DescriptionImpro)
                                                ? null
                                                : System.Web.HttpUtility.HtmlAttributeEncode(imp.DescriptionImpro);

                                            <div class="col-12 col-sm-6 col-lg-3 mt-1">
                                                <label>
                                                    <input type="checkbox" class="imp-check"
                                                           value="@imp.ImprovementId"
                                                           data-score="@imp.ScoreValue"
                                                           data-workertype="@imp.WorkerType" />

                                                    <span class="ml-1">
                                                        <strong
                                                                @Html.Raw(hint == null ? "" : $"data-role=\"hint\" data-hint-text=\"{hint}\" data-hint-position=\"top\"")>
                                                            @imp.ImprovemenName
                                                        </strong>
                                                        <kbd class="bg-green fg-white">@imp.ScoreValue pts</kbd>
                                                    </span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

        </div>

        @* ---------- C: Contingencies (full width) ---------- *@
        @if (showC)
        {
            var catC = impC
                .GroupBy(x => string.IsNullOrWhiteSpace(x.CategoryName) ? "General" : x.CategoryName)
                .OrderBy(g => g.Key)
                .ToList();

            <div class="row mt-1">
                <div class="col-12">
                    <div data-role="accordion" data-one-frame="false">
                        @foreach (var cat in catC)
                        {
                            <div class="frame">
                                <div class="heading">@cat.Key</div>
                                <div class="content">
                                    <div class="row">
                                        @foreach (var imp in cat.OrderBy(x => x.ImprovemenName))
                                        {
                                            var hint = string.IsNullOrWhiteSpace(imp.DescriptionImpro)
                                                ? null
                                                : System.Web.HttpUtility.HtmlAttributeEncode(imp.DescriptionImpro);

                                            <div class="col-12 col-sm-6 col-lg-3 mt-1">
                                                <label>
                                                    <input type="checkbox" class="imp-check"
                                                           value="@imp.ImprovementId"
                                                           data-score="@imp.ScoreValue"
                                                           data-workertype="@imp.WorkerType" />

                                                    <span class="ml-1">
                                                        <strong
                                                                @Html.Raw(hint == null ? "" : $"data-role=\"hint\" data-hint-text=\"{hint}\" data-hint-position=\"top\"")>
                                                            @imp.ImprovemenName
                                                        </strong>
                                                        <kbd class="bg-green fg-white">@imp.ScoreValue pts</kbd>
                                                    </span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>
        }

        <!-- Footer -->
        <div class="row">
            <div class="dialog-actions d-flex flex-justify-start w-100">
                <div class="container-fluid">
                    <div class="row flex-justify-between flex-align-center">
                        <div class="cell-5">
                            <strong>Total selected points:</strong>
                            <p>Associates: <kbd class="bg-white fg-green"><span id="ptsA">0</span></kbd> | Trusted Personnel: <kbd class="bg-white fg-green"><span id="ptsB">0</span></kbd> | Contingencies: <kbd class="bg-white fg-green"><span id="ptsC">0</span></kbd></p>
                        </div>
                        <div class="cell-1">
                            <button id="SaveRegisterRewards" onclick="SubmitAddRewards()" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button>
                            <span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>