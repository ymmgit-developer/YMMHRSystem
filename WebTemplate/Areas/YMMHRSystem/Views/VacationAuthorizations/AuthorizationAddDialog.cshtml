@using YMMHRSystemLogic
@model DtoVacationAuthorizations

@{
    Layout = null;
    WorkerFile workerFile = new WorkerFile();
    var associateList = workerFile.LoadMultiple();
    User user = new User();
    var userlist = user.LoadMultiple();
}

<div class="dialog-title">Authorization</div>

<div class="dialog-content">
    <form id="AuthorizationVacationForm" data-role="validator" data-on-validate-form="SaveAuthorizationVacation()" action="javascript:">
        <div class="row">
            <div class="cell-md-6">
                <div class="row d-flex flex-align-center flex-justify-between mx-5">
                    <div><h6 style="color:black">Associates</h6></div>
                    <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="Metro.dialog.open('#MultiSelectAssociateImporter')"><span class="mif-user-plus"></span><span class="actionButton"> Add </span></a></div>
                </div>
                <div id="AssociateTable">
                    <!---------------------------------------TABLA ------------------------------------------>
                    <table id="dttAssociateList" class="display compact" style="width:100%">
                        <thead>
                            <tr>
                                <th style="text-align: center">Names</th>
                                <th style="text-align: center">Process</th>
                                <th style="text-align: center"></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="cell-md-6">
                <div class="row d-flex flex-align-center flex-justify-between mx-5">
                    <div><h6 style="color:black">Users</h6></div>
                    <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="Metro.dialog.open('#MultiSelectUserImporter')"><span class="mif-user-plus"></span><span class="actionButton"> Add </span></a></div>
                </div>
                <div id="UserTable">
                    <!---------------------------------------TABLA ------------------------------------------>
                    <table id="dttUserList" class="display compact" style="width:100%">
                        <thead>
                            <tr>
                                <th style="text-align: center">Names</th>
                                <th style="text-align: center">Process</th>
                                <th style="text-align: center"></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="dialog-actions d-flex flex-justify-between w-100">
                <div>
                    <button id="SaveAuthorizationVacation" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button>
                    <span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span>
                </div>
            </div>
        </div>
    </form>
</div>

<div data-overlay="true" data-width="900" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="MultiSelectAssociateImporter" name="MultiSelectAssociateImporter" class="dialog" data-role="dialog">
    @Html.Partial("~/Areas/YMMHRSystem/Views/Shared/MultiSelectAssociateList.cshtml", associateList)
</div>

<div data-overlay="true" data-width="900" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="MultiSelectUserImporter" name="MultiSelectUserImporter" class="dialog" data-role="dialog">
    @Html.Partial("~/Areas/YMMHRSystem/Views/Shared/MultiSelectUserList.cshtml", userlist)
</div>

<script>
    $(document).ready(function () {

        table_Associate = $('#dttAssociateList').DataTable({
            responsive: true,
            retrieve: true,
            searching: false,
            info: false,
            compact: true,
            paging: false,
            ordering: false,
            scrollY: "33vh",
            scrollCollapse: true,
        });
    });

    function RemoveAssociate(names) {
        var aux;
        $("#dttAssociateList td").each(function () {
            if ($(this).text() === names) {
                aux = $(this).parents('tr');
            }
        });
        table.row(aux).remove().draw();
        Metro.toast.create("Associate removed.", null, null, "bg-green fg-white");
    }

    $(document).ready(function () {

        table_User = $('#dttUserList').DataTable({
            responsive: true,
            retrieve: true,
            searching: false,
            info: false,
            compact: true,
            paging: false,
            ordering: false,
            scrollY: "33vh",
            scrollCollapse: true,
        });
    });

    function RemoveUser(names) {
        var aux;
        $("#dttUserList td").each(function () {
            if ($(this).text() === names) {
                aux = $(this).parents('tr');
            }
        });
        table.row(aux).remove().draw();
        Metro.toast.create("User removed.", null, null, "bg-green fg-white");
    }
</script>