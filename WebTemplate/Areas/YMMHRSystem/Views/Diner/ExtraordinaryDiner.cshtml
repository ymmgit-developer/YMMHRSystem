@model List<DtoExtraordinaryDiner>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Extraordinary Diner";
}
<head>
    <script>
        $SaveExtraordinaryDiner = '@Url.Action("SaveExtraordinaryDiner", "Diner", new { area = "YMMHRSystem" })';
        $LoadExtraordinaryDiner = '@Url.Action("LoadExtraordinaryDiner", "Diner", new { area = "YMMHRSystem" })';
        $DeleteExtraordinaryDiner = '@Url.Action("DeleteExtraordinaryDiner", "Diner", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/Diner.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Extra Diner</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSaveExtraordinaryDiner"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' onclick="ExtraordinaryDinerDetailDialog(0)"><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>

    <div class="container-fluid mt-5">
        <div id="ExtraordinaryDinerTable" data-step="2" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttExtraordinaryDiner" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th style="text-align: center">Applicant</th>
                        <th style="text-align: center">Process</th>
                        <th style="text-align: center">Associate</th>
                        <th style="text-align: center">Type</th>
                        <th style="text-align: center">Time</th>
                        <th style="text-align: center">Date</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="text-align: center">
                                <span> @item.UserCreated </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Process </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.AssociateName </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Type </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Time </span>
                            </td>

                            <td style="text-align: center">
                                <span> @(item.Date?.ToShortDateString()) </span>
                            </td>

                            <td style="text-align: center">
                                <a class="button bg-black fg-white"  style="cursor: pointer;" onclick="ExtraordinaryDinerDetailDialog(@item.ExtraordinaryDinerId)"><span class="mif-eye"></span><span class="actionButton"> View</span></a>
                                @if (HttpContext.Current.Session["CanDeleteExtraordinaryDiner"].Equals(true))
                                {
                                    if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])))
                                    {
                                        <a class="button bg-red fg-white"style="cursor: pointer;" onclick="ConfirmDeleteExtraordinaryDiner(@item.ExtraordinaryDinerId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                                    }
                                    else if (!Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) && item.Date?.Subtract(DateTime.Now).TotalHours > 2)
                                    {
                                        <a class="button bg-red fg-white"style="cursor: pointer;" onclick="ConfirmDeleteExtraordinaryDiner(@item.ExtraordinaryDinerId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                                    }

                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-width="800" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="ExtraordinaryDinerDetail" name="ExtraordinaryDinerDetail" class="dialog" data-role="dialog">

    </div>


    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="Error" name="Error" class="dialog" data-role="dialog">
        <div class="dialog-title">Error</div>
        <div class="dialog-content">
            <p>- Diner already exists</p>
            <p>- Please request diner within 4 hour window </p>
        </div>
        <div class="dialog-actions ml-auto">
            <button class="button alert" onclick="Metro.dialog.close('#Error')">OK</button>
        </div>
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteExtraordinaryDiner" name="DeleteExtraordinaryDiner" class="dialog" data-role="dialog">
        <div class="dialog-title">Delete</div>
        <div class="dialog-content"> Are you sure you want to delete this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="DeleteExtraordinaryDiner()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#DeleteExtraordinaryDiner')"> No</button>
        </div>
    </div>
</body>

