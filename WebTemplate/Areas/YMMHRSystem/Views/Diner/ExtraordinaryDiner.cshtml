@model List<DtoExtraordinaryDiner>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Extraordinary Diner";
}
<head>
    <script>
        $SaveExtraordinaryDiner = '@Url.Action("SaveExtraordinaryDiner", "Diner", new { area = "YMMHRSystem" })';
        $SaveGuestExtraordinaryDiner = '@Url.Action("SaveGuestExtraordinaryDiner", "Diner", new { area = "YMMHRSystem" })';
        $AddExtraordinaryDiner = '@Url.Action("AddExtraordinaryDiner", "Diner", new { area = "YMMHRSystem" })';
        $AddGuestExtraordinaryDiner = '@Url.Action("AddGuestExtraordinaryDiner", "Diner", new { area = "YMMHRSystem" })';
        $LoadExtraordinaryDiner = '@Url.Action("LoadExtraordinaryDiner", "Diner", new { area = "YMMHRSystem" })';
        $CancelExtraordinaryDiner = '@Url.Action("CancelExtraordinaryDiner", "Diner", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/Diner.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Extra Diner</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSaveExtraordinaryDiner"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new guest register" data-position='auto' onclick="GuestExtraordinaryDinerAddDialog()"><span class="mif-user-plus"></span><span class="actionButton"> Guests </span></a>
                <a class="button flat-button" style="color:white" data-step="2" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' onclick="ExtraordinaryDinerAddDialog()"><span class="mif-user-plus"></span><span class="actionButton"> Associates </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>

    <div class="container-fluid mt-5" style="font-size: 0.8rem">
        <div id="ExtraordinaryDinerTable" style="display: none" data-step="3" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttExtraordinaryDiner" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th style="text-align: center">Applicant</th>
                        <th style="text-align: center">Process</th>
                        <th style="text-align: center">Associates</th>
                        <th style="text-align: center">Type</th>
                        <th style="text-align: center">Time</th>
                        <th style="text-align: center">Date</th>
                        <th style="text-align: center">Status</th>
                        <th style="text-align: center" data-step="4" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="text-align: center">
                                <span> @item.UserCreated </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Process </span>
                            </td>

                            <td style="text-align: center">
                                @*@if ((Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"]))))
            {
                <span> @item.Count </span>
            }
            else
            {
                <span> @item.AssociateName </span>
            }*@
                                <span> @item.AssociateName </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Type </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Time </span>
                            </td>

                            <td style="text-align: center">
                                <span> @(item.Date?.ToShortDateString()) </span>
                            </td>

                            <td style="text-align: center">
                                @{
                                    var statusLabel = item.Status == 1 ? "Generated" :
                                                      item.Status == 3 ? "Confirmed" : "Cancelled";
                                    var statusClass = item.Status == 1 ? "bg-blue fg-white" :
                                                      item.Status == 3 ? "bg-green fg-white" :
                                                      "bg-red fg-white";
                                }
                                <kbd class="@statusClass">@statusLabel</kbd>
                            </td>

                            <td style="text-align: center">
                                <a class="button small bg-black fg-white" style="cursor: pointer;" onclick="ExtraordinaryDinerDetailDialog(@item.ExtraordinaryDinerId)"><span class="mif-eye"></span><span class="actionButton"> View</span></a>
                                @if (HttpContext.Current.Session["CanCancelExtraordinaryDiner"].Equals(true))
                                {
                                    if ((Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"]))) && item.Status != 3 && item.Status != 2)
                                    {
                                        <a class="button small bg-red fg-white" style="cursor: pointer;" onclick="ConfirmCancelExtraordinaryDiner(@item.ExtraordinaryDinerId)"><span class="mif-cancel"></span><span class="actionButton"> Cancel</span></a>
                                    }
                                    else if ((!Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || !Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"]))) && (item.Date + item.Time)?.Subtract(DateTime.Now).TotalHours > 2 && item.Status == 1)
                                    {
                                        <a class="button small bg-red fg-white" style="cursor: pointer;" onclick="ConfirmCancelExtraordinaryDiner(@item.ExtraordinaryDinerId)"><span class="mif-cancel"></span><span class="actionButton"> Cancel</span></a>
                                    }

                                }
                                @if ((Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"]))) && item.Status == 1)
                                {
                                    <a class="button small bg-green fg-white" style="cursor: pointer;" href="@Url.Action("ConfirmExtraordinaryDiner", "Diner", new { Area = "YMMHRSystem", extraordinaryDinerId = item.ExtraordinaryDinerId })"><span class="mif-checkmark"></span><span class="actionButton"> Confirm</span></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-width="800" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="ExtraordinaryDinerDetail" name="ExtraordinaryDinerDetail" class="dialog" data-role="dialog">

    </div>

    <div data-overlay="true" data-width="1500" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="ExtraordinaryDinerAddDialog" name="ExtraordinaryDinerAddDialog" class="dialog" data-role="dialog">

    </div>

    <div data-overlay="true" data-width="900" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="GuestExtraordinaryDinerAddDialog" name="GuestExtraordinaryDinerAddDialog" class="dialog" data-role="dialog">

    </div>

    <div data-overlay="true" data-width="500" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="Error" name="Error" class="dialog" data-role="dialog">
        <div class="dialog-title">Error</div>
        <div class="dialog-content">
            <p></p> <!-- Este contenido será actualizado dinámicamente -->
        </div>
        <div class="dialog-actions ml-auto">
            <button class="button alert" onclick="Metro.dialog.close('#Error')">OK</button>
        </div>
    </div>


    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="CancelExtraordinaryDiner" name="CancelExtraordinaryDiner" class="dialog" data-role="dialog">
        <div class="dialog-title">Cancel</div>
        <div class="dialog-content"> Are you sure you want to cancel this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="CancelExtraordinaryDiner()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#CancelExtraordinaryDiner')"> No</button>
        </div>
    </div>
</body>

