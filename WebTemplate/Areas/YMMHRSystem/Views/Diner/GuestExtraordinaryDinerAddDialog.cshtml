@model DtoExtraordinaryDiner
@using YMMHRSystemLogic
@{
    Layout = null;
    var foodTypeList = new List<string>() { "Box Lunch", "Weekend", "Special", "Shift Change" };
    Process process = new Process();
    var processList = process.LoadMultiple();
}


<div class="dialog-title">Extra Diner</div>

<div class="dialog-content">
    <form id="ExtraDinerForm" data-role="validator" data-on-validate-form="AddGuestExtraordinaryDiner()" action="javascript:">
        <div class="row mb-2">
            <div class="cell-md-6">
                <span>No. of Guests:</span>
                <input type="text" data-role="spinner" name="GuestQuantity" id="GuestQuantity" autocomplete="off" data-buttons-position="right" data-min-value="1" value="@Model.GuestQuantity">
            </div>
            <div class="cell-md-6">
                <label>Process</label>
                <select class="notranslate" data-role="select" id="Process" name="Process">
                    @foreach (var item in processList)
                    {
                        if (Model.Process == item.Name)
                        {
                            <option selected value="@item.Name">@item.Name</option>
                        }
                        else
                        {
                            <option value="@item.Name">@item.Name</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="row flex-align-center flex-justify-between">
            <div class="cell-md-9">
                <div><h6 style="color:black">Email Contacts</h6></div>
            </div>
            <div class="cell-md-3">
                <input type="checkbox" data-role="checkbox" data-style="2" data-caption="Multiple days range" id="range" onclick="EnableFinishDate()">
            </div>
        </div>
        <div class="row mb-2">
            <div class="cell-md-12">
                <input id="Contacts" value="" name="Contacts" data-on-before-tag-add="onBeforeTagAdd" data-max-tags="10" type="text" data-role="taginput">
            </div>
        </div>
        <div class="row mb-2">
            <div class="cell-md-6">
                @if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                {
                    <input data-prepend="Start Date:" data-validate="required" autocomplete="off" id="Date" name="Date" value="" data-role="calendarpicker" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                }
                else
                {
                    <input data-prepend="Start Date:" data-validate="required" autocomplete="off" id="Date" name="Date" value="" data-role="calendarpicker" data-cls-calendar="compact" data-min-date="@DateTime.Now" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                }

            </div>
            <div class="cell-md-6">
                @if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                {
                    <input data-prepend="Finish Date:" disabled="disabled" autocomplete="off" id="FinishDate" name="FinishDate" value="" data-role="calendarpicker" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                }
                else
                {
                    <input data-prepend="Finish Date:" disabled="disabled" autocomplete="off" id="FinishDate" name="FinishDate" value="" data-role="calendarpicker" data-cls-calendar="compact" data-min-date="@DateTime.Now" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                }
            </div>

        </div>
        <div class="row mb-2">
            <div class="cell-md-6">
                <input style="font-size:12px;" data-role="timepicker" data-seconds="false" data-value="0" id="Time" name="Time">
            </div>
            <div class="cell-md-6">
                <select class="notranslate" data-role="select" id="SelectType" name="SelectType" data-prepend="Type:">
                    @foreach (var item in foodTypeList)
                    {
                        if (Model.Type == item)
                        {
                            <option selected value="@item">@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="row mb-2">
            <div class="cell">
                <textarea data-role="textarea" data-prepend="Motive:" name="Motive" id="Motive" data-chars-counter="#chars-counter" data-chars-counter-template=" $1 char(s)" data-validate="required maxlength=400" autocomplete="off">@Model.Motive</textarea>
                <p style="font-size: 0.8rem" id="chars-counter"> 0 char(s)</p>
            </div>
        </div>
        @Html.Hidden("Type", Model.Type)
        @Html.Hidden("Lading", Model.Lading)
        @Html.Hidden("UserCreated", Model.UserCreated)
        @Html.Hidden("DateAdded", Model.DateAdded)
        <div class="row">
            <div class="dialog-actions d-flex flex-justify-start w-100">
                @if (HttpContext.Current.Session["CanSaveExtraordinaryDiner"].Equals(true) && Model.Status != 2)
                {
                    <div><button id="SaveDiner" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button></div>
                }
                <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>
            </div>
        </div>
    </form>
</div>

<script>

    $("#range").on("change", function (e) {
        if (e.target.checked) {
            $('#FinishDate').attr('data-validate="required"');
            $("#FinishDate").parent().addClass('required');
            $("#FinishDate").attr('data-validate', 'required');
            $('#FinishDate').prop("disabled", false);
        } else {
            $('#FinishDate').val(null);
            $("#FinishDate").parent().removeClass('required');
            $("#FinishDate").removeAttr('data-validate');
            $('#FinishDate').prop("disabled", true);
        }
    });

</script>
<script>
    function onBeforeTagAdd(val) {

        var regex = /^[a-zA-Z0-9._-]+@@yachiyo.com.mx\s*$/;
        if (regex.test(val)) {
            return true;
        } else {
            regex = /^[a-zA-Z0-9._-]+@@yachiyo-ind.co.jp\s*$/;
            if (regex.test(val)) {
                return true;
            } else {
                Metro.toast.create("Enter a correct email", null, null, "bg-red fg-white");
                return false;
            }

        }
    }
</script>
