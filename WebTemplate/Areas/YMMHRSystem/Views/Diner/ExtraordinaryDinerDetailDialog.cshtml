@model DtoExtraordinaryDiner
@using YMMHRSystemLogic
@{
    Layout = null;
    WorkerFile workerFile = new WorkerFile();
    var associateList = workerFile.LoadMultiple();
    FoodType foodType = new FoodType();
    var foodTypeList = foodType.LoadMultiple();
}


<div class="dialog-title">Extra Diner</div>

<div class="dialog-content">
    <form id="ExtraDinerForm" data-role="validator" data-on-validate-form="AddExtraordinaryDiner()" action="javascript:">
        <div class="row">
            <div class="cell-md-12">
                <div class="row mb-2">
                    <div class="cell-md-10">
                        <input type="text" name="AssociateName" id="AssociateName" data-validate="required" data-role="input" readonly="readonly" data-prepend="Associate:" autocomplete="off" value="@Model.AssociateName">
                        <span class="invalid_feedback">
                            Select an Associate
                        </span>
                    </div>
                    <div class="cell-md-2">
                        <a class="button my-button-colors" style="cursor: pointer; color: white;" onclick="Metro.dialog.open('#AssociateImporter')"><span class="mif-user-plus"></span><span class="actionButton"> Select</span></a>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-6">
                        <input data-prepend="Start Date:" autocomplete="off" id="Date" name="Date" value="@Model.Date" data-role="calendarpicker" data-cls-calendar="compact" data-input-format="%d/%m/%y">
                    </div>
                    <div class="cell-md-6">
                        <input style="font-size:12px;"  data-role="timepicker" data-seconds="false" data-value="@Model.Time" id="Time" name="Time">
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-6">
                        <select data-on-change="TypeSelected()" data-role="select" id="SelectType" name="SelectType" data-prepend="Type:">
                            @foreach (var item in foodTypeList)
                            {
                                if (Model.Type == item.Name)
                                {
                                    <option selected value="@item.Cost">@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Cost">@item.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <textarea data-role="textarea" data-prepend="Motive:" name="Motive" id="Motive" data-validate="required" autocomplete="off">@Model.Motive</textarea>
                        <span class="invalid_feedback">
                            Enter a Motive
                        </span>
                    </div>
                </div>
                @if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                {
                    <div class="row">
                        <div class="cell-md-5">
                            <input type="text" readonly data-role="input" value="@Model.Cost" data-prepend="Type Cost: $" id="Cost" name="Cost">
                        </div>
                        <div class="cell-md-2">
                            @if (Model.Lading)
                            {
                                <input type="checkbox" id="LadingCheck" name="LadingCheck" data-role="checkbox" data-style="2" checked="checked" data-caption="Lading">
                            }
                            else
                            {
                                <input type="checkbox" id="LadingCheck" name="LadingCheck" data-role="checkbox" data-style="2" data-caption="Lading">
                            }

                        </div>
                        <div class="cell-md-5">
                            <input type="text" data-role="input" value="@Model.LadingCost" data-prepend="Lading Cost: $" id="LadingCost" name="LadingCost">
                        </div>
                    </div>
                }
            </div>
        </div>
        @Html.Hidden("Process", Model.Process)
        @Html.Hidden("Type", Model.Type)
        @Html.Hidden("Lading", Model.Lading)
        @Html.Hidden("UserCreated", Model.UserCreated)
        @Html.Hidden("DateAdded", Model.DateAdded)
        <div class="row">
            <div class="dialog-actions d-flex flex-justify-start w-100">
                @if (HttpContext.Current.Session["CanSaveExtraordinaryDiner"].Equals(true))
                {
                    <div><button id="SaveDiner" class="button my-control-colors"><span class="mif-floppy-disk"></span> Save </button></div>
                }
                <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>
            </div>
        </div>
    </form>
</div>

<div data-overlay="true" data-width="900" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="AssociateImporter" name="AssociateImporter" class="dialog" data-role="dialog">
    @Html.Partial("~/Areas/YMMHRSystem/Views/Shared/AssociateList.cshtml", associateList)
</div>

<script>
    $(document).ready(function () {

        $("#LadingCheck").on("change", function (e) {
            if (e.target.checked) {
                $('#Lading').val(true);
            } else {
                $('#Lading').val(false);
            }
        });

        setInterval(function () {
            $("#LadingCost").val($("#LadingCost").val().toString().match(/^-?\d+(?:\.\d{0,2})?/));
        }, 500);

        TypeSelected();
    });

    function TypeSelected() {
        $("#Cost").val($("#SelectType option:selected").val());
    }
</script>
