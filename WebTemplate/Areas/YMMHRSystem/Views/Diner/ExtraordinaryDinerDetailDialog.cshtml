@model DtoExtraordinaryDiner
@using YMMHRSystemLogic
@{
    Layout = null;
    WorkerFile workerFile = new WorkerFile();
    var associateList = workerFile.LoadMultiple();
    var foodTypeList = new List<string>() { "Box Lunch", "Weekend", "Special", "Shift Change" };
}


<div class="dialog-title">Extra Diner</div>

<div class="dialog-content">
    <form id="ExtraDinerForm" data-role="validator" data-on-validate-form="AddExtraordinaryDiner()" action="javascript:">
        <div class="row">
            <div class="cell-md-12">
                <div class="row mb-2">
                    <div class="cell-md-12">
                        @if (Model.ExtraordinaryDinerId == 0)
                        {
                            <input type="text" name="AssociateName" id="AssociateName" onclick="Metro.dialog.open('#AssociateImporter')" data-validate="required" data-role="input" readonly="readonly" data-prepend="Associate:" autocomplete="off" value="@Model.AssociateName">
                        }
                        else
                        {
                            <input type="text" name="AssociateName" id="AssociateName" data-role="input" readonly="readonly" data-prepend="Associate:" autocomplete="off" value="@Model.AssociateName">
                        }
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-6">
                        <input data-prepend="Start Date:" autocomplete="off" id="Date" name="Date" value="@Model.Date" data-role="calendarpicker" data-cls-calendar="compact" @*data-format="%d/%m/%Y"*@ data-input-format="%d/%m/%Y">
                    </div>
                    <div class="cell-md-6">
                        <div class="row">
                            <div class="cell-12 border bd-gray">
                                <input type="time" style="font-size:15px;" @*data-role="timepicker" data-seconds="false" data-value="@Model.Time"*@ value="@Model.Time" id="Time" name="Time" class="w-100">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-6">
                        <select class="notranslate" data-role="select" id="SelectType" name="SelectType" data-prepend="Type:">
                            @foreach (var item in foodTypeList)
                            {
                                if (Model.Type == item)
                                {
                                    <option selected value="@item">@item</option>
                                }
                                else
                                {
                                    <option value="@item">@item</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <textarea data-role="textarea" data-prepend="Motive:" name="Motive" id="Motive" data-validate="required" autocomplete="off">@Model.Motive</textarea>
                        <span class="invalid_feedback">
                            Enter a Motive
                        </span>
                    </div>
                </div>
                @if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                {
                    <div class="row">
                        <div class="cell-md-6">
                            <input type="text" data-role="input" autocomplete="off" value="@Model.TypeCost" data-prepend="Type Cost: $" id="TypeCost" name="TypeCost">
                        </div>
                        <div class="cell-md-6">
                            <input type="text" data-role="input" autocomplete="off" value="@Model.LadingCost" data-prepend="Lading Cost: $" id="LadingCost" name="LadingCost">
                        </div>
                    </div>
                }
            </div>
        </div>
        @Html.Hidden("Status", Model.Status)
        @Html.Hidden("Process", Model.Process)
        @Html.Hidden("Type", Model.Type)
        @Html.Hidden("Lading", Model.Lading)
        @Html.Hidden("UserCreated", Model.UserCreated)
        @Html.Hidden("CreatedBy", Model.CreatedBy)
        @Html.Hidden("DateAdded", Model.DateAdded)
        <div class="row">
            <div class="dialog-actions d-flex flex-justify-start w-100">
                @if (HttpContext.Current.Session["CanSaveExtraordinaryDiner"].Equals(true) && Model.Status <= 1)
                {
                    <div><button id="SaveDiner" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button></div>
                }
                else if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                {
                    <div><button id="SaveDiner" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button></div>
                }
                <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>
            </div>
        </div>
    </form>
</div>

<div data-overlay="true" data-width="900" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="AssociateImporter" name="AssociateImporter" class="dialog" data-role="dialog">
    @Html.Partial("~/Areas/YMMHRSystem/Views/Shared/AssociateList.cshtml", associateList)
</div>

