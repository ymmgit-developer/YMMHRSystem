@model List<DtoUtilityCar>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Utility Car";
}
<head>
    <script>
        $LoadUtilityCar = '@Url.Action("LoadUtilityCar", "UtilityCar", new { area = "YMMHRSystem" })';
        $DeleteUtilityCar = '@Url.Action("DeleteUtilityCar", "UtilityCar", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/UtilityCar.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Utility Car</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSaveUtilityCar"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' @*onclick="UtilityCarDetailDialog(0)"*@ href="@Url.Action("LoadUtilityCar", "UtilityCar", new { Area = "YMMHRSystem" , nMR4z = 0 })"><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>

    <div class="container-fluid mt-5">
        <div id="UtilityCarsTable" data-step="2" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttUtilityCars" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th style="text-align: center">Associate</th>
                        <th style="text-align: center">Request Date</th>
                        <th style="text-align: center">Departure Date</th>
                        <th style="text-align: center">Arrival Date</th>
                        @if (Role.QueryRole("GA", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                        {
                            <th style="text-align: center">Destination</th>
                            <th style="text-align: center">Passengers</th>
                        }
                        <th style="text-align: center">Status</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td style="text-align: center">
                                <span> @item.Associate </span>
                            </td>

                            <td style="text-align: center">
                                <span> @(item.DateAdded.ToShortDateString()) </span>
                            </td>

                            <td style="text-align: center">
                                <span> @(item.DepartureDate?.ToShortDateString()) </span>
                            </td>

                            <td style="text-align: center">
                                <span> @(item.ArrivalDate?.ToShortDateString()) </span>
                            </td>
                            @if (Role.QueryRole("GA", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                            {
                                <td style="text-align: center">
                                    <span> @item.Destination </span>
                                </td>

                                <td style="text-align: center">
                                    <span> @item.Passengers </span>
                                </td>
                            }
                            <td style="text-align: center">
                                <span> @(item.Status == 3 ? "Complete" : item.Status == 2 ? "In Progress" : "New") </span>
                            </td>

                            <td style="text-align: center">
                                <a class="button bg-black fg-white" style="cursor: pointer;" href="@Url.Action("LoadUtilityCar", "UtilityCar", new { Area = "YMMHRSystem" , nMR4z = item.UtilityCarId })" @*onclick="UtilityCarDetailDialog(@item.UtilityCarId)"*@><span class="mif-eye"></span><span class="actionButton"> View</span></a>
                                @if (Role.QueryRole("GA", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                                {
                                    <a class="button bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteUtilityCar(@item.UtilityCarId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                                }
                                else if (HttpContext.Current.Session["CanDeleteUtilityCar"].Equals(true) && item.Status == 1)
                                {
                                    <a class="button bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteUtilityCar(@item.UtilityCarId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-width="1400" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="UtilityCarDetail" name="UtilityCarDetail" class="dialog" data-role="dialog">
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="Error" name="Error" class="dialog" data-role="dialog">
        <div class="dialog-title">Error</div>
        <div class="dialog-content">
            <p>- Utility car loan already exists</p>
        </div>
        <div class="dialog-actions ml-auto">
            <button class="button alert" onclick="Metro.dialog.close('#Error')">OK</button>
        </div>
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteUtilityCar" name="DeleteUtilityCar" class="dialog" data-role="dialog">
        <div class="dialog-title">Delete</div>
        <div class="dialog-content"> Are you sure you want to delete this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="DeleteUtilityCar()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#DeleteUtilityCar')"> No</button>
        </div>
    </div>
</body>

