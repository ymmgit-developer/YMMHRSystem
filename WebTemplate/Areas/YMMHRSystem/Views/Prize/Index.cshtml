@model List<DtoPrize>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Prizes";
}
<head>
    <script>
        $SavePrize = '@Url.Action("SavePrize", "Prize", new { area = "YMMHRSystem" })';
        $LoadPrize = '@Url.Action("LoadPrize", "Prize", new { area = "YMMHRSystem" })';
        $DeletePrize = '@Url.Action("DeletePrize", "Prize", new { area = "YMMHRSystem" })';
        $LoadPrizeLog = '@Url.Action("LoadPrizeLog", "Prize", new { area = "YMMHRSystem" })';
        $PrizeMovement = '@Url.Action("PrizeMovement", "Prize", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/Prize.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Prize System</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSavePrize"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' onclick="PrizeDetailDialog(0)"><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>
    <div class="container-fluid mt-5">
        <div id="PrizeTable" data-step="2" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttPrizes" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th style="text-align: center">Prize</th>
                        <th style="text-align: center">Points</th>
                        <th style="text-align: center">Quantity</th>
                        <th style="text-align: center">Date</th>
                        <th style="text-align: center">Minimum</th>
                        <th style="text-align: center">Status</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td style="text-align: center">
                                <span> @item.Name </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Points </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Quantity </span>
                            </td>

                            <td style="text-align: center">
                                <span> @(item.Date.ToShortDateString()) </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Minimum </span>
                            </td>

                            <td style="text-align: center">
                                <span> @(item.Status ? "Active" : "Inactive") </span>
                            </td>

                            <td style="text-align: center">
                                <a class="button bg-black fg-white" style="cursor: pointer; " onclick="PrizeLogDialog(@item.PrizeId)"><span class="mif-assignment"></span> <span class="actionButton"> Log</span></a>
                                @if (HttpContext.Current.Session["CanSavePrize"].Equals(true) && item.Status)
                                {
                                    <a class="button bg-green fg-white" style="cursor: pointer;" onclick="MovementDialog(@item.PrizeId)"><span class="mif-tab"></span><span class="actionButton"> Movement</span></a>
                                }
                                @if (HttpContext.Current.Session["CanDeletePrize"].Equals(true) && item.Status)
                                {
                                    <a class="button bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeletePrize(@item.PrizeId, @item.Quantity)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-width="1000" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="PrizeLogDialog" name="PrizeLogDialog" class="dialog" data-role="dialog">
    </div>

    <div data-overlay="true" data-width="800" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="PrizeDetail" name="PrizeDetail" class="dialog" data-role="dialog">
    </div>

    <div data-overlay="true" data-width="400" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="MovementDialog" name="MovementDialog" class="dialog" data-role="dialog">
        <div class="dialog-title">Movement</div>
        <div class="dialog-content">
            <div class="row">
                <div class="cell-md-12">
                    <select data-role="select" id="MovementType" name="MovementType" data-prepend="Type:">
                        <option value="Entry">Resupply</option>
                        <option value="Exit">Remove</option>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="cell-md-12">
                    <label>Quantity: </label>
                    <input type="text" name="MovementQuantity" id="MovementQuantity" data-role="spinner" data-min-value="1" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="dialog-actions d-flex flex-justify-end">
            <button onclick="PrizeMovement()" class="button success"><span class="mif-checkmark"> OK</span></button>
        </div>
    </div>


    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeletePrize" name="DeletePrize" class="dialog" data-role="dialog">
        <div class="dialog-title">Delete</div>
        <div class="dialog-content"> Are you sure you want to delete this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="DeletePrize()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#DeletePrize')"> No</button>
        </div>
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="Error" name="Error" class="dialog" data-role="dialog">
        <div class="dialog-title">Error</div>
        <div class="dialog-content">
            <p>- Prize already exists</p>
        </div>
        <div class="dialog-actions ml-auto">
            <button class="button alert" onclick="Metro.dialog.close('#Error')">OK</button>
        </div>
    </div>


    <div data-overlay="true" data-default-action="false" data-role="dialog" id="preloader" class="dialog">
        <div class="dialog-content">
            <span id="preloaderSave" class="mif-2x mif-spinner4 ani-spin"></span>
            <span>Loading....</span>
        </div>
    </div>
</body>

