@model DtoPrizeAssociatePointLog
@using YMMHRSystemLogic
@{
    Layout = null;

}
<div class="dialog-title">Associate Point Adjustment</div>
<div class="dialog-content">
    <h6>Actual Points: @ViewBag.ActualPoints</h6>
    <form id="AdjustmentForm" data-role="validator" data-on-validate-form="SaveAdjustment()" action="javascript:">
        <div class="row mb-2">
            <div class="cell-md-12">
                <select data-role="select" id="MovementType" name="MovementType" data-prepend="Type:">
                    <option value="Entry">Entry</option>
                    <option value="Exit">Exit</option>
                </select>
            </div>
        </div>
        <div class="row mb-2">
            <div class="cell-md-12">
                <label>Quantity: </label>
                <input type="text" name="Quantity" id="Quantity" data-role="spinner" data-min-value="1" autocomplete="off">
            </div>
        </div>
        <div class="row">
            <div class="cell-md-12">
                <textarea data-role="textarea" data-prepend="Motive:" name="Motive" id="Motive" data-validate="required" autocomplete="off" value=""></textarea>
                <span class="invalid_feedback">
                    Enter a Motive
                </span>
            </div>
        </div>
        <div class="dialog-actions d-flex px-0 flex-justify-between mt-2">
            <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>
            <div><button id="SaveAdjustment" class="button my-control-colors"><span class="mif-checkmark"> OK</span> </button></div>
        </div>
    </form>
</div>


