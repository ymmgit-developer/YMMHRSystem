@model List<DtoPrizeAssociate>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Prize System";
}
<head>
    <script>
        $SavePrizeAssociate = '@Url.Action("SavePrizeAssociate", "PrizeAssociate", new { area = "YMMHRSystem" })';
        $LoadPrizeAssociate = '@Url.Action("LoadPrizeAssociate", "PrizeAssociate", new { area = "YMMHRSystem" })';
        $DeletePrizeAssociate = '@Url.Action("DeletePrizeAssociate", "PrizeAssociate", new { area = "YMMHRSystem" })';
        $ImportWorkers = '@Url.Action("ImportWorkers", "PrizeAssociate", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/PrizeAssociate.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Prize System: Associate</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSavePrizeAssociate"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will allow multiple worker importation" data-position='auto' onclick="ImportWorkers()"><span class="mif-user-plus"></span><span class="actionButton"> Import/Refresh</span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>
    <div class="container-fluid mt-5">
        <div id="PrizeAssociateTable" style="display: none" data-step="2" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttPrizeAssociates" class="display" style="width:100%;">
                <thead>
                    <tr>
                        <th style="text-align: center">Associate</th>
                        <th style="text-align: center">Department</th>
                        <th style="text-align: center">Team</th>
                        <th style="text-align: center">Total Points</th>
                        <th style="text-align: center">Associate Points</th>
                        <th style="text-align: center">Team Points</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td style="text-align: center">
                                <span> @item.Associate </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Department </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Team </span>
                            </td>

                            <td style="text-align: center">
                                <span> @(item.AssociatePoints + item.TeamPoints) </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.AssociatePoints </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.TeamPoints </span>
                            </td>

                            <td style="text-align: center">
                                <a class="button bg-black fg-white" style="cursor: pointer;" href="@Url.Action("LoadPrizeAssociate", "PrizeAssociate", new { Area = "YMMHRSystem" , nMR4z = item.PrizeAssociateId })"><span class="mif-eye"></span><span class="actionButton"> View</span></a>
                                @if (HttpContext.Current.Session["CanDeletePrizeAssociate"].Equals(true))
                                {
                                    <a class="button bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeletePrizeAssociate(@item.PrizeAssociateId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-default-action="false" data-role="dialog" id="preloader" class="dialog">
        <div class="dialog-content">
            <span id="preloaderSave" class="mif-2x mif-spinner4 ani-spin"></span>
            <span>Loading....</span>
        </div>
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeletePrizeAssociate" name="DeletePrizeAssociate" class="dialog" data-role="dialog">
        <div class="dialog-title">Delete</div>
        <div class="dialog-content"> Are you sure you want to delete this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="DeletePrizeAssociate()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#DeletePrizeAssociate')"> No</button>
        </div>
    </div>
</body>

