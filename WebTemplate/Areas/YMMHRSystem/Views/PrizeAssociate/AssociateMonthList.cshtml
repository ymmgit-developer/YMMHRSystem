@model List<DtoPrizeAssociateMonth>
@using YMMHRSystemLogic
@{
    Layout = null;
}

<div class="row d-flex flex-align-center flex-justify-between mx-5">
    <div><h6 style="color:black">Associate of the Month</h6></div>
    <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenAssociateMonthDialog()"><span class="mif-plus"></span><span class="actionButton"> New </span></a></div>
</div>
<div id="AssociateMonthTable" style="display:none;">
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttAssociateMonth" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">Year</th>
                <th style="text-align: center">Month</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="@item.PrizeAssociateMonthId">
                    <td style="text-align: center">
                        <span> @item.Year </span>
                    </td>
                    <td style="text-align: center">
                        <span> @item.Month </span>
                    </td>
                    <td style="text-align: center">
                        @if (HttpContext.Current.Session["CanDeletePrizeAssociate"].Equals(true))
                        {
                            <a class="button small bg-red fg-white" style="cursor: pointer; " onclick="ConfirmDeleteAssociateMonth(@item.PrizeAssociateMonthId)"><span class="mif-bin"></span><span class="actionButton"> Delete </span></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteAssociateMonth" name="DeleteAssociateMonth" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeletePrizeAssociateMonth()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeleteAssociateMonth')"> No</button>
    </div>
</div>

<script>
    var tableAssociateMonth;
    $(document).ready(function () {

        tableAssociateMonth = $('#dttAssociateMonth').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "20vh",
            scrollCollapse: true,
            initComplete: function () {
                $("#AssociateMonthTable").show();
            }
        });

    });

    function DeletePrizeAssociateMonth() {
        var aux;
        $("#dttAssociateMonth tr").each(function () {
            if ($(this).attr("id") == window.$AssociateMonthId) {
                aux = $(this);
            }
        });
        table = $('#dttAssociateMonth').DataTable();
        $.ajax({
            method: "POST",
            url: window.$DeletePrizeAssociateMonth,
            data: { prizeAssociateMonthId: window.$AssociateMonthId },
            success: function (result) {
                if (result === "true") {
                    Metro.toast.create("Associate Month deleted.", null, null, "bg-green fg-white");
                } else {
                    Metro.toast.create("Error deleting the Associate Month.", null, null, "bg-red fg-white");
                }
                tableAssociateMonth.row(aux).remove().draw();
                Metro.dialog.close('#DeleteAssociateMonth')
            }
        });
    }

    function ConfirmDeleteAssociateMonth(associateMonthId) {
        var dialog = Metro.getPlugin('#DeleteAssociateMonth', 'dialog');
        dialog.open();
        window.$AssociateMonthId = associateMonthId;
    }
</script>

