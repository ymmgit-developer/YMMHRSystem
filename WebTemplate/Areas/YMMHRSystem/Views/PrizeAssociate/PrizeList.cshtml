@model List<DtoPrizeAssociatePrize>
@using YMMHRSystemLogic
@{
    Layout = null;
}

<div class="row d-flex flex-align-center flex-justify-between mx-5">
    <div><h6 style="color:black">Prizes</h6></div>
    <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenPrizeDialog()"><span class="mif-plus"></span><span class="actionButton"> New </span></a></div>
</div>
<div id="PrizeTable" style="display:none;">
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttPrize" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">Year</th>
                <th style="text-align: center">Month</th>
                <th style="text-align: center">Prize</th>
                <th style="text-align: center">Points</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr id="@item.PrizeAssociatePrizeId">
                <td style="text-align: center">
                    <span> @item.Year </span>
                </td>

                <td style="text-align: center">
                    <span> @item.Month </span>
                </td>

                <td style="text-align: center">
                    <span> @item.Prize </span>
                </td>

                <td style="text-align: center">
                    <span> @item.Points </span>
                </td>

                <td style="text-align: center">
                    @if (HttpContext.Current.Session["CanDeletePrizeAssociate"].Equals(true) && item.Date.ToShortDateString() == DateTime.Today.ToShortDateString())
                    {
                        <a class="button small bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeletePrize(@item.PrizeAssociatePrizeId)"><span class="mif-bin"></span><span class="actionButton"> Delete </span></a>
                    }
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeletePrize" name="DeletePrize" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeletePrizeAssociatePrize()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeletePrize')"> No</button>
    </div>
</div>

<script>
    var tablePrize;
    $(document).ready(function () {

        tablePrize = $('#dttPrize').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "20vh",
            scrollCollapse: true,
            initComplete: function () {
                $("#PrizeTable").show();
            }
        });

    });

    function DeletePrizeAssociatePrize() {
        var aux;
        $("#dttPrize tr").each(function () {
            if ($(this).attr("id") == window.$PrizeId) {
                aux = $(this);
            }
        });
        table = $('#dttPrize').DataTable();
        $.ajax({
            method: "POST",
            url: window.$DeletePrizeAssociatePrize,
            data: { prizeAssociatePrizeId: window.$PrizeId },
            success: function (result) {
                if (result === "true") {
                    Metro.toast.create("Prize deleted.", null, null, "bg-green fg-white");
                } else {
                    Metro.toast.create("Error deleting the prize.", null, null, "bg-red fg-white");
                }
                tablePrize.row(aux).remove().draw();
                Metro.dialog.close('#DeletePrize')
            }
        });
    }

    function ConfirmDeletePrize(prizeId) {
        var dialog = Metro.getPlugin('#DeletePrize', 'dialog');
        dialog.open();
        window.$PrizeId = prizeId;
    }
</script>

