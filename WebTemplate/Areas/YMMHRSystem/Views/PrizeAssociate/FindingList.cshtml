@model List<DtoPrizeAssociateFinding>
@using YMMHRSystemLogic
@{
    Layout = null;
}

<div class="row d-flex flex-align-center flex-justify-between mx-5">
    <div><h6 style="color:black">Findings</h6></div>
    <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenFindingDialog()"><span class="mif-plus"></span><span class="actionButton"> New </span></a></div>
</div>
<div id="FindingTable" style="display:none;">
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttFinding" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">Year</th>
                <th style="text-align: center">Month</th>
                <th style="text-align: center">Finding</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="@item.PrizeAssociateFindingId">
                    <td style="text-align: center">
                        <span> @item.Year </span>
                    </td>
                    <td style="text-align: center">
                        <span> @item.Month </span>
                    </td>
                    <td style="text-align: center">
                        <span> @item.Finding </span>
                    </td>
                    <td style="text-align: center">
                        @if (HttpContext.Current.Session["CanDeletePrizeAssociate"].Equals(true))
                        {
                            <a class="button small bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteFinding(@item.PrizeAssociateFindingId)"><span class="mif-bin"></span><span class="actionButton"> Delete </span></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteFinding" name="DeleteFinding" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeletePrizeAssociateFinding()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeleteFinding')"> No</button>
    </div>
</div>

<script>
    var tableFinding;
    $(document).ready(function () {

        tableFinding = $('#dttFinding').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "20vh",
            scrollCollapse: true,
            initComplete: function () {
                $("#FindingTable").show();
            }
        });

    });

    function DeletePrizeAssociateFinding() {
        var aux;
        $("#dttFinding tr").each(function () {
            if ($(this).attr("id") == window.$FindingId) {
                aux = $(this);
            }
        });
        table = $('#dttFinding').DataTable();
        $.ajax({
            method: "POST",
            url: window.$DeletePrizeAssociateFinding,
            data: { prizeAssociateFindingId: window.$FindingId },
            success: function (result) {
                if (result === "true") {
                    Metro.toast.create("Finding deleted.", null, null, "bg-green fg-white");
                } else {
                    Metro.toast.create("Error deleting the finding.", null, null, "bg-red fg-white");
                }
                tableFinding.row(aux).remove().draw();
                Metro.dialog.close('#DeleteFinding')
            }
        });
    }

    function ConfirmDeleteFinding(findingId) {
        var dialog = Metro.getPlugin('#DeleteFinding', 'dialog');
        dialog.open();
        window.$FindingId = findingId;
    }
</script>

