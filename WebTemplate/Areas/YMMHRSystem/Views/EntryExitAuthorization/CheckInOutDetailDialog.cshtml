@using YMMHRSystemLogic
@model DtoEntryExitAuthorization

@{
    WorkerFile workerFile = new WorkerFile();
    var associateList = workerFile.LoadMultiple();
    Types type = new Types();
    var types = type.GetTypes();
    Motive motive = new Motive();
    var motives = motive.GetMotives();
}

<div class="dialog-title">Staff check-in/check-out Details</div>

<div class="dialog-content">
    <form id="CheckInOutForm" data-role="validator" data-on-validate-form="UpdateCheckInOut()" action="javascript:">
        <div class="row">
            <div class="cell-md-6">
                <div class="row mb-2">
                    <div class="cell-md-12">
                        <div class="row">
                            <div class="container">
                                <input type="text" readonly data-role="input" data-prepend="IdRegister" id="IdRecordsInOut" name="IdRecordsInOut" value="@Model.IdRecordsInOut" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-12">
                        <div class="row">
                            <div class="container">
                                <input type="text" readonly data-role="input" data-prepend="Associate" id="Associate" name="Associate" value="@Model.Associate" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-12">
                        <div class="row">
                            <div class="container">
                                <input type="text" readonly data-role="input" data-prepend="Process" id="Process" name="Process" value="@Model.Process" />
                            </div>
                        </div>
                    </div>
                </div>
                @if (Model.FirtsAuthorization == true)
                {
                    <div class="row mb-2">
                        <div class="cell-md-12">
                            <div class="row">
                                <div class="container">
                                    <input type="text" readonly data-role="input" data-prepend="Firts Authorization" id="FirtsAuthorization" name="FirtsAuthorization" value="@Model.FirtsAuthorizedby" />
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @if (Model.SecondAuthorization == true)
                {
                    <div class="row mb-2">
                        <div class="cell-md-12">
                            <div class="row">
                                <div class="container">
                                    <input type="text" readonly data-role="input" data-prepend="Second Authorization" id="SecondAuthorization" name="SecondAuthorization" value="@Model.SecondAuthorizedby" />
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <!---SPLIT--->
            <div class="cell-md-6">
                <div class="row mb-2">
                    <div class="cell-md-6">
                        <div class="row">
                            <div class="container">
                                <label for="DateFor">Date for:</label>
                                <!--Date Select, se habilita si:-->
                                <!--CreateBy = HttpContext.Session["Name"]-->
                                <!--CurrentState != 0-->
                                <!--Role.QueryRole("HR", Convert.ToInt64(Session["UserId"]))-->
                                @if (Model.CurrentState == 0)
                                {
                                    <input type="text" readonly class="selector active w-100 dotted-border" id="DateFor" name="DateFor" placeholder="Date" autocomplete="off" data-input value="@Model.DateFor.ToString("dd/MM/yyyy")" />
                                }
                                else
                                {
                                    <input disabled type="text" class="selector active w-100 dotted-border" id="DateFor" name="DateFor" placeholder="Date" autocomplete="off" readonly data-input value="@Model.DateFor.ToString("dd/MM/yyyy")" />
                                }
                            </div>
                        </div>
                    </div>
                    <div class="cell-md-6">
                        <div class="row">
                            <div class="container">
                                <label for="TimeFor">Time for:</label>
                                @if ((Model.CurrentState == 0 && (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || (Model.CurrentState == 0 && Model.CreateBy == Session["UserName"].ToString()))))
                                {
                                    <input type="time" class="w-100" id="TimeFor" name="TimeFor" value="@Model.TimeFor">
                                }
                                else
                                {
                                    <input disabled type="time" class="w-100" id="TimeFor" name="TimeFor" value="@Model.TimeFor">
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-6">
                        @if ((Model.CurrentState == 0 && (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || (Model.CurrentState == 0 && Model.CreateBy == Session["UserName"].ToString()))))
                        {
                            <select data-role="select" data-prepend="Motive" data-validate="required not=-1" id="IdMotive" name="IdMotive">
                                <option value="-1" class="d-none"></option>
                                @foreach (var optionmotive in motives)
                                {
                                    if (optionmotive.IdMotive == Model.IdMotive)
                                    {
                                        <option selected value="@optionmotive.IdMotive">@optionmotive.DescriptionMotive</option>
                                    }
                                    else
                                    {
                                        <option value="@optionmotive.IdMotive">@optionmotive.DescriptionMotive</option>
                                    }
                                }
                            </select>
                        }
                        else
                        {
                            <select disabled data-role="select" data-prepend="Motive" data-validate="required not=-1" id="IdMotive" name="IdMotive">
                                <option value="-1" class="d-none"></option>
                                @foreach (var optionmotive in motives)
                                {
                                    if (optionmotive.IdMotive == Model.IdMotive)
                                    {
                                        <option selected value="@optionmotive.IdMotive">@optionmotive.DescriptionMotive</option>
                                    }
                                    else
                                    {
                                        <option value="@optionmotive.IdMotive">@optionmotive.DescriptionMotive</option>
                                    }
                                }
                            </select>
                        }
                    </div>
                    <div class="cell-md-6">
                        @if ((Model.CurrentState == 0 && (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || (Model.CurrentState == 0 && Model.CreateBy == Session["UserName"].ToString()))))
                        {
                            <select data-role="select" data-prepend="Salary" data-validate="required not=-1" id="IdSalary" name="IdSalary">
                                <option value="-1" class="d-none"></option>
                                @if (Model.IdSalary == 1)
                                {
                                    <option selected value="1">Sin Goce</option>
                                    <option value="2">Con Goce</option>
                                }
                                else
                                {
                                    <option value="1">Sin Goce</option>
                                    <option selected value="2">Con Goce</option>
                                }
                            </select>
                        }
                        else
                        {
                            <select disabled data-role="select" data-prepend="Salary" data-validate="required not=-1" id="IdSalary" name="IdSalary">
                                <option value="-1" class="d-none"></option>
                                @if (Model.IdSalary == 1)
                                {
                                    <option selected value="1">Sin Goce</option>
                                    <option value="2">Con Goce</option>
                                }
                                else
                                {
                                    <option value="1">Sin Goce</option>
                                    <option selected value="2">Con Goce</option>
                                }
                            </select>
                        }
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-12">
                        @if((Model.CurrentState == 0 && (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || (Model.CurrentState == 0 && Model.CreateBy == Session["UserName"].ToString()))))
                        {
                            <select data-role="select" data-prepend="Type" data-validate="required not=-1" id="Type" name="IdType">
                                <option value="-1" class="d-none"></option>
                                @foreach (var optiontype in types)
                                {
                                    if (optiontype.IdType == Model.IdType)
                                    {
                                        <option selected value="@optiontype.IdType">@optiontype.DescriptionType</option>
                                    }
                                    else
                                    {
                                        <option value="@optiontype.IdType">@optiontype.DescriptionType</option>
                                    }
                                }
                            </select>
                        }
                        else
                        {
                            <select disabled data-role="select" data-prepend="Type" data-validate="required not=-1" id="Type" name="IdType">
                                <option value="-1" class="d-none"></option>
                                @foreach (var optiontype in types)
                                {
                                    if (optiontype.IdType == Model.IdType)
                                    {
                                        <option selected value="@optiontype.IdType">@optiontype.DescriptionType</option>
                                    }
                                    else
                                    {
                                        <option value="@optiontype.IdType">@optiontype.DescriptionType</option>
                                    }
                                }
                            </select>
                        }
                        
                    </div>
                </div>
            </div>
            <input type="text" readonly style="display:none;" id="CurrentState" name="CurrentState" value="@Model.CurrentState"/>
            <input type="text" readonly style="display:none;" id="CreateBy" name="CreateBy" value="@Model.CreateBy" />
            <input type="text" readonly style="display:none;" id="CreateDate" value="@Model.CreateDate"/>
        </div>
        <div class="row">
            <div class="dialog-actions d-flex flex-justify-between w-100">
                <div>
                    <!--Save button, existe si:-->
                    <!--CreateBy = HttpContext.Session["Name"]-->
                    <!--CurrentState = 0-->
                    <!--Role.QueryRole("HR", Convert.ToInt64(Session["UserId"]))-->
                    @if ((Model.CreateBy == Session["UserName"].ToString()) || Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])))
                    {
                        if (Model.CurrentState == 0)
                        {
                            <button id="SaveCheckInOut" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button>
                        }
                    }
                    <span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    $(document).ready(function () {
        flatpickr("#DateFor", {
            dateFormat: "d-m-Y", // Formato de fecha: Día-Mes-Año
        });
    });
</script>