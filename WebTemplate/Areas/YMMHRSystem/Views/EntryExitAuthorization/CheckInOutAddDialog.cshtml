@using YMMHRSystemLogic
@model DtoEntryExitAuthorization

@{
    WorkerFile workerFile = new WorkerFile();
    var associateList = workerFile.LoadMultiple();
    Types type = new Types();
    var types = type.GetTypes();
    Motive motive = new Motive();
    var motives = motive.GetMotives();
}

<div class="dialog-title">Staff check-in/check-out</div>

<div class="dialog-content">
    <form id="CheckInOutForm" data-role="validator" data-on-validate-form="AddRegister()" action="javascript:">
        <div class="row">
            <div class="cell-md-6">
                <div class="row d-flex flex-align-center flex-justify-between mx-5">
                    <div><h6 style="color:black">Associates</h6></div>
                    <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="Metro.dialog.open('#MultiSelectAssociateImporter')"><span class="mif-user-plus"></span><span class="actionButton"> Add </span></a></div>
                </div>
                <div id="AssociateTable">
                    <!---------------------------------------TABLA ------------------------------------------>
                    <table id="dttAssociateList" class="display compact" style="width:100%">
                        <thead>
                            <tr>
                                <th style="text-align: center">Names</th>
                                <th style="text-align: center">Process</th>
                                <th style="text-align: center"></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <!---SPLIT--->
            <div class="cell-md-6">
                <div class="row mb-2">
                    <div class="cell-md-6">
                        <div class="row">
                            <div class="container">
                                <label for="DateFor">Date for:</label>
                                <input type="text" class="selector active w-100 dotted-border" id="DateFor" name="DateFor" placeholder="Date" autocomplete="off" readonly data-input />
                            </div>
                        </div>
                    </div>
                    <div class="cell-md-6">
                        <div class="row">
                            <div class="container">
                                <label for="TimeFor">Time for:</label>
                                <input type="time" class="w-100" id="TimeFor" name="TimeFor" value="@DateTime.Now.ToString("HH:mm")">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-6">
                        <select data-role="select" data-prepend="Motive" data-validate="required not=-1" id="IdMotive" name="IdMotive">
                            <option value="-1" class="d-none"></option>
                            @foreach (var optionmotive in motives)
                            {
                                <option value="@optionmotive.IdMotive">@optionmotive.DescriptionMotive</option>
                            }
                        </select>
                    </div>
                    <div class="cell-md-6">
                        <select data-role="select" data-prepend="Salary" data-validate="required not=-1" id="IdSalary" name="IdSalary">
                            <option value="-1" class="d-none"></option>
                            <option value="1">Sin Goce</option>
                            <option value="2">Con Goce</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-12">
                        <select data-role="select" data-prepend="Type" data-validate="required not=-1" id="Type" name="IdType">
                            <option value="-1" class="d-none"></option>
                            @foreach (var optiontype in types)
                            {
                                <option value="@optiontype.IdType">@optiontype.DescriptionType</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="dialog-actions d-flex flex-justify-between w-100">
                <div>
                    <button id="SaveCheckInOut" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button>
                    <span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span>
                </div>
            </div>
        </div>
    </form>
</div>

<div data-overlay="true" data-role="dialog" data-width="900" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="MultiSelectAssociateImporter" name="MultiSelectAssociateImporter" class="dialog">
    @Html.Partial("~/Areas/YMMHRSystem/Views/Shared/MultiSelectAssociateList.cshtml", associateList)
</div>


<script>
    $(document).ready(function () {
        table = $('#dttAssociateList').DataTable({
            responsive: true,
            retrieve: true,
            searching: false,
            info: false,
            compact: true,
            paging: false,
            ordering: false,
            scrollY: "33vh",
            scrollCollapse: true
        });
    });

    $(document).ready(function () {
        flatpickr("#DateFor", {
            dateFormat: "d-m-Y", // Formato de fecha: Día-Mes-Año
            minDate: "today",    // La fecha mínima será hoy
            defaultDate: "today" // Por defecto, selecciona la fecha actual
        });
    });

    function SelectAssociates(names, process, id) {
        var same = false;
        $("#dttAssociateList td").each(function () {
            if ($(this).text() === names) {
                same = true;
            }
        });

        if (same) {
            Metro.toast.create("Associate already added.", null, null, "bg-red fg-white");
        } else {
            tableAssociates.row($('#' + id)).remove().draw();

            var node = table.row.add([
                names,
                process,
                '<a class="button small bg-red fg-white" style="cursor: pointer;" onclick="RemoveAssociate(\'' + names + '\')"><span class="mif-bin"></span></a>'
            ]).draw(false).node();

            $(node).css('text-align', 'center');

            var lastRowIndex = $("#dttAssociateList").find("tr").length - 2;
            $("#dttAssociateList").find("tr").last().append(
                "<input type='hidden' name='WorkerList[" + lastRowIndex + "].Names' value='" + names + "'>"
            );
            $("#dttAssociateList").find("tr").last().append(
                "<input type='hidden' name='WorkerList[" + lastRowIndex + "].Process' value='" + process + "'>"
            );

            Metro.toast.create("Associate added.", null, null, "bg-green fg-white");
        }
    }

</script>