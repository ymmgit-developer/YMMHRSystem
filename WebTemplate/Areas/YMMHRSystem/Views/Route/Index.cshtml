@model List<DtoRoute>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Routes";
}
<head>
    <script>
        $LoadRoute = '@Url.Action("LoadRoute", "Route", new { area = "YMMHRSystem" })';
        $DeleteRoute = '@Url.Action("DeleteRoute", "Route", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/Route.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Routes</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSaveRoute"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' href="@Url.Action("LoadRoute", "Route", new { Area = "YMMHRSystem" , nMR4z = 0 })"><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>

    <div class="container-fluid mt-5">
        <div id="RouteTable" data-step="2" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttRoutes" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th style="text-align: center">Route</th>
                        <th style="text-align: center">Created By</th>
                        <th style="text-align: center">Date Added</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting" data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td style="text-align: center">
                                <span> @item.Name </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.UserCreated </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.DateAdded </span>
                            </td>

                            <td style="text-align: center">
                                <a class="button bg-black fg-white"  style="cursor: pointer; " href="@Url.Action("LoadRoute", "Route", new { Area = "YMMHRSystem", nMR4z = item.RouteId })"><span class="mif-eye"></span><span class="actionButton"> View</span></a>
                                @if (HttpContext.Current.Session["CanDeleteRoute"].Equals(true))
                                {
                                    <a class="button bg-red fg-white"style="cursor: pointer; " onclick="ConfirmDeleteRoute(@item.RouteId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteRoute" name="DeleteRoute" class="dialog" data-role="dialog">
        <div class="dialog-title">Delete</div>
        <div class="dialog-content"> Are you sure you want to delete this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="DeleteRoute()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#DeleteRoute')"> No</button>
        </div>
    </div>
</body>

