@model DtoTranslationAttachment
@using YMMHRSystemLogic
@{
    Layout = null;
}
<div class="dialog-title">Attachment</div>
<div class="dialog-content">
    <form id="TranslationAttachmentForm" data-role="validator" accept-charset="utf-8" data-on-validate-form="AddAttachment()" action="javascript:">
       
        <div class="row mb-2">
            @if ((Role.QueryRole("GA", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"]))) && Convert.ToBoolean(Session["IsTranslated"]))
            {
                <div class="cell-md-10">
                    <input type="file" id="file" name="file" data-role="file" data-validate="required" data-button-title="<span class='mif-folder mif-2x'></span>">
                </div>

                <div class="cell-md-2">
                    <input type="checkbox" data-role="checkbox" data-style="2" data-caption="Translation" class="translationCheck">
                </div>
            }
            else
            {
                <div class="cell-md-12">
                    <input type="file" id="file" name="file" data-role="file" data-validate="required" data-button-title="<span class='mif-folder mif-2x'></span>">
                </div>
            }
        </div>
            @Html.Hidden("IsTranslated", Model.IsTranslated)
            <div class="dialog-actions d-flex px-0 flex-justify-between mt-2">
                <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>
                <div><button id="AddAttachment" class="button my-control-colors"><span class="mif-checkmark"> OK</span></button></div>
            </div>
        </form>
</div>

<script>
    $(".translationCheck").on("change", function (e) {
        if (e.target.checked) {
            $('#IsTranslated').val("true");
        } else {
            $('#IsTranslated').val("false");
        }
    });
</script>

