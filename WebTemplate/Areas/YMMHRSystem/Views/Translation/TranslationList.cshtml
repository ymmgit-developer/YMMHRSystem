@model List<DtoTranslationAttachment>
@using YMMHRSystemLogic
@{
    Layout = null;
}


<div class="dialog-content">
    <div class="row d-flex flex-align-center flex-justify-between mx-2">
        <div><h6>Translations</h6></div>
        @if (Role.QueryRole("GA", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
        {
            <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenAttachmentDialog(true)"><span class="mif-plus"></span><span class="actionButton"> Add </span></a></div>
        }
    </div>
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttTranslation" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">File</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="@item.TranslationAttachmentId">
                    <td style="text-align: center">
                        <span> @Path.GetFileName(item.FileName) </span>
                    </td>
                    <td style="text-align: center">
                        <a class="button small my-button-colors" style="cursor: pointer;" href="@Url.Action("GetAttachment", "Translation", new { Area = "YMMHRSystem" , translationAttachmentId = item.TranslationAttachmentId })" target="_blank"><span class="mif-download"></span></a>
                        @if (HttpContext.Current.Session["CanDeleteTranslation"].Equals(true))
                        {
                            <a class="button small bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteTranslation(@item.TranslationAttachmentId)"><span class="mif-bin"></span></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-width="400" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="AttachmentDialog" name="AttachmentDialog" class="dialog" data-role="dialog">
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteTranslation" name="DeleteTranslation" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeleteTranslation()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeleteTranslation')"> No</button>
    </div>
</div>

<script>
    var tableTranslation;
    $(document).ready(function () {

        tableTranslation = $('#dttTranslation').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "20vh",
            scrollCollapse: true
        });

    });


    function DeleteTranslation() {
        var aux;
        $("#dttTranslation tr").each(function () {
            if ($(this).attr("id") == window.$TranslationId) {
                aux = $(this);
            }
        });

        $.ajax({
            method: "POST",
            url: window.$DeleteAttachment,
            data: { translationAttachmentId: window.$TranslationId },
            success: function (result) {
                if (result === "true") {
                    tableTranslation.row(aux).remove().draw();
                    Metro.toast.create("Translation deleted.", null, null, "bg-green fg-white");
                } else {
                    Metro.toast.create("Error deleting the translation or translation is complete.", null, null, "bg-red fg-white");
                }              
                Metro.dialog.close('#DeleteTranslation')
            }
        });
    }

    function ConfirmDeleteTranslation(translationId) {
        var dialog = Metro.getPlugin('#DeleteTranslation', 'dialog');
        dialog.open();
        window.$TranslationId = translationId;
    }
</script>


