@model List<DtoTranslation>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Translation";
}
<head>
    <script>
        $SaveTranslation = '@Url.Action("SaveTranslation", "Translation", new { area = "YMMHRSystem" })';
        $LoadTranslation = '@Url.Action("LoadTranslation", "Translation", new { area = "YMMHRSystem" })';
        $StartTranslation = '@Url.Action("StartTranslation", "Translation", new { area = "YMMHRSystem" })';
        $EndTranslation = '@Url.Action("EndTranslation", "Translation", new { area = "YMMHRSystem" })';
        $DeleteTranslation = '@Url.Action("DeleteTranslation", "Translation", new { area = "YMMHRSystem" })';
        $AttachmentDialog = '@Url.Action("AttachmentDialog", "Translation", new { area = "YMMHRSystem" })';
        $AddAttachment = '@Url.Action("AddAttachment", "Translation", new { area = "YMMHRSystem" })';
        $DeleteAttachment = '@Url.Action("DeleteAttachmentFile", "Translation", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/Translation.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Translation</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSaveTranslation"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' onclick="TranslationDetailDialog(0)"><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>

    <div class="container-fluid mt-5">
        <div id="TranslationsTable" data-step="2" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttTranslations" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th style="text-align: center">Associate</th>
                        <th style="text-align: center">Requested Date</th>
                        <th style="text-align: center">Deadline</th>
                        <th style="text-align: center">Issue</th>
                        @if (Role.QueryRole("GA", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                        {
                            <th style="text-align: center">Assigned To</th>
                        }
                        <th style="text-align: center">Status</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td style="text-align: center">
                                <span> @item.Associate </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.DateAdded </span>
                            </td>

                            <td style="text-align: center">
                                <span> @(item.Deadline?.ToShortDateString()) </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Issue </span>
                            </td>
                            @if (Role.QueryRole("GA", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                            {
                                <td style="text-align: center">
                                    <span> @item.AssignedTo </span>
                                </td>
                            }
                            <td style="text-align: center">
                                <span> @(item.Status == 3 ? "Complete" : item.Status == 2 ? "In Progress" : "New") </span>
                            </td>

                            <td style="text-align: center">
                                <a class="button bg-black fg-white" style="cursor: pointer;" onclick="TranslationDetailDialog(@item.TranslationId)"><span class="mif-eye"></span><span class="actionButton"> View</span></a>
                                @if (Role.QueryRole("GA", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                                {
                                    <a class="button bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteTranslation(@item.TranslationId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                                }
                                else if (HttpContext.Current.Session["CanDeleteTranslation"].Equals(true) && item.Status == 1)
                                {
                                    <a class="button bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteTranslation(@item.TranslationId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-width="1400" data-default-action="false" data-on-close="setTimeout(function () {location.reload();}, 500)" data-close-button="true" data-overlay-click-close="true" id="TranslationDetail" name="TranslationDetail" class="dialog" data-role="dialog">
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="Error" name="Error" class="dialog" data-role="dialog">
        <div class="dialog-title">Error</div>
        <div class="dialog-content">
            <p>- Translation already exists</p>
        </div>
        <div class="dialog-actions ml-auto">
            <button class="button alert" onclick="Metro.dialog.close('#Error')">OK</button>
        </div>
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteTranslation" name="DeleteTranslation" class="dialog" data-role="dialog">
        <div class="dialog-title">Delete</div>
        <div class="dialog-content"> Are you sure you want to delete this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="DeleteTranslation()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#DeleteTranslation')"> No</button>
        </div>
    </div>
</body>

