@model DtoPrizeTeam
@using YMMHRSystemLogic
@{
    Layout = null;
}
<div class="dialog-title">Team</div>
<div class="dialog-content">
    <form id="TeamForm" data-role="validator" data-on-validate-form="SavePrizeTeam()" action="javascript:">

        <div class="row">
            <div class="cell-md-12">
                <input type="text" name="Name" id="Name" data-role="input" data-prepend="Name:" data-validate="required" autocomplete="off" value="@Model.Name">
                <span class="invalid_feedback">
                    Enter a Name
                </span>
            </div>
        </div>
        @Html.Hidden("CreatedBy", Model.CreatedBy)
        @Html.Hidden("DateAdded", Model.DateAdded)
        @Html.Hidden("TeamPoints", Model.TeamPoints)
        <div class="dialog-actions d-flex px-0 flex-justify-between mt-2">
            <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>
            <div><button id="SavePrizeTeam" class="button my-control-colors"><span class="mif-checkmark"> OK</span></button></div>
        </div>
    </form>
</div>

