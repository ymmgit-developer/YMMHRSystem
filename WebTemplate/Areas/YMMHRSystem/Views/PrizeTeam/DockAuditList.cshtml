@model List<DtoPrizeTeamDockAudit>
@using YMMHRSystemLogic
@{
    Layout = null;
}

<div class="row d-flex flex-align-center flex-justify-between mx-5">
    <div><h6 style="color:black">Dock Audit</h6></div>
    <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenPrizeTeamDockAuditDialog()"><span class="mif-plus"></span><span class="actionButton"> New </span></a></div>
</div>
<div id="DockAuditTable" style="display:none;">
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttPrizeTeamDockAudit" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">Year</th>
                <th style="text-align: center">Month</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="@item.PrizeTeamDockAuditId">
                    <td style="text-align: center">
                        <span> @item.Year </span>
                    </td>
                    <td style="text-align: center">
                        <span> @item.Month </span>
                    </td>
                    <td style="text-align: center">
                        @if (HttpContext.Current.Session["CanDeletePrizeTeam"].Equals(true))
                        {
                            <a class="button small bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteDockAudit(@item.PrizeTeamDockAuditId)"><span class="mif-bin"></span><span class="actionButton"> Delete </span></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteDockAudit" name="DeleteDockAudit" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeletePrizeTeamDockAudit()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeleteDockAudit')"> No</button>
    </div>
</div>

<script>
    var tableDockAudit;
    $(document).ready(function () {

        tableDockAudit = $('#dttPrizeTeamDockAudit').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "37vh",
            scrollCollapse: true,
            initComplete: function () {
                $("#DockAuditTable").show();
            }
        });

    });

    function DeletePrizeTeamDockAudit() {
        var aux;
        $("#dttPrizeTeamDockAudit tr").each(function () {
            if ($(this).attr("id") == window.$DockAuditId) {
                aux = $(this);
            }
        });
        table = $('#dttPrizeTeamDockAudit').DataTable();
        $.ajax({
            method: "POST",
            url: window.$DeletePrizeTeamDockAudit,
            data: { prizeTeamDockAuditId: window.$DockAuditId },
            success: function (result) {
                if (result === "true") {
                    Metro.toast.create("Dock audit deleted.", null, null, "bg-green fg-white");
                } else {
                    Metro.toast.create("Error deleting the dock audit.", null, null, "bg-red fg-white");
                }
                tableDockAudit.row(aux).remove().draw();
                Metro.dialog.close('#DeleteDockAudit')
            }
        });
    }

    function ConfirmDeleteDockAudit(dockAuditId) {
        var dialog = Metro.getPlugin('#DeleteDockAudit', 'dialog');
        dialog.open();
        window.$DockAuditId = dockAuditId;
    }
</script>

