@model List<DtoPrizeTeam>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Prize System";
}
<head>
    <script>
        $PrizeTeamDialog = '@Url.Action("PrizeTeamDialog", "PrizeTeam", new { area = "YMMHRSystem" })';
        $SavePrizeTeam = '@Url.Action("SavePrizeTeam", "PrizeTeam", new { area = "YMMHRSystem" })';
        $LoadPrizeTeam = '@Url.Action("LoadPrizeTeam", "PrizeTeam", new { area = "YMMHRSystem" })';
        $DeletePrizeTeam = '@Url.Action("DeletePrizeTeam", "PrizeTeam", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/PrizeTeam.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Prize System: Team</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSavePrizeTeam"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' onclick="OpenPrizeTeamDialog(0)"><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>
    <div class="container-fluid mt-5">
        <div id="PrizeTeamTable" style="display: none" data-step="2" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttPrizeTeam" class="display" style="width:100%;">
                <thead>
                    <tr>
                        <th style="text-align: center">Team</th>
                        <th style="text-align: center">Team Points</th>
                        <th style="text-align: center">Date</th>
                        <th style="text-align: center">Created By</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td style="text-align: center">
                                <span> @item.Name </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.TeamPoints </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.DateAdded </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.CreatedBy </span>
                            </td>

                            <td style="text-align: center">
                                <a class="button bg-black fg-white" style="cursor: pointer;" href="@Url.Action("LoadPrizeTeam", "PrizeTeam", new { Area = "YMMHRSystem" , nMR4z = item.PrizeTeamId })"><span class="mif-eye"></span><span class="actionButton"> View</span></a>
                                @if (HttpContext.Current.Session["CanDeletePrizeTeam"].Equals(true))
                                {
                                    <a class="button bg-blue fg-white" style="cursor: pointer;" onclick="OpenPrizeTeamDialog(@item.PrizeTeamId)"><span class="mif-pencil"></span><span class="actionButton"> Edit</span></a>
                                    <a class="button bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeletePrizeTeam(@item.PrizeTeamId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-width="400" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="NewTeamDialog" name="NewTeamDialog" class="dialog" data-role="dialog">
    </div>

    <div data-overlay="true" data-default-action="false" data-role="dialog" id="preloader" class="dialog">
        <div class="dialog-content">
            <span id="preloaderSave" class="mif-2x mif-spinner4 ani-spin"></span>
            <span>Loading....</span>
        </div>
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeletePrizeTeam" name="DeletePrizeTeam" class="dialog" data-role="dialog">
        <div class="dialog-title">Delete</div>
        <div class="dialog-content"> Are you sure you want to delete this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="DeletePrizeTeam()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#DeletePrizeTeam')"> No</button>
        </div>
    </div>
</body>

