@model List<DtoPrizeTeamScrap>
@using YMMHRSystemLogic
@{
    Layout = null;
}

<div class="row d-flex flex-align-center flex-justify-between mx-5">
    <div><h6 style="color:black">Scrap</h6></div>
    <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenPrizeTeamScrapDialog()"><span class="mif-plus"></span><span class="actionButton"> New </span></a></div>
</div>
<div id="PrizeTeamScrapTable" style="display:none;">
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttPrizeTeamScrap" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">Year</th>
                <th style="text-align: center">Month</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr id="@item.PrizeTeamScrapId">

                <td style="text-align: center">
                    <span> @item.Year </span>
                </td>

                <td style="text-align: center">
                    <span> @item.Month </span>
                </td>

                <td style="text-align: center">
                    @if (HttpContext.Current.Session["CanDeletePrizeTeam"].Equals(true))
                    {
                        <a class="button small bg-red fg-white" style="cursor: pointer; " onclick="ConfirmDeletePrizeTeamScrap(@item.PrizeTeamScrapId)"><span class="mif-bin"></span><span class="actionButton"> Delete </span></a>
                    }
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeletePrizeTeamScrap" name="DeletePrizeTeamScrap" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeletePrizeTeamScrap()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeletePrizeTeamScrap')"> No</button>
    </div>
</div>

<script>
    var tablePrizeTeamScrap;
    $(document).ready(function () {

        tablePrizeTeamScrap = $('#dttPrizeTeamScrap').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "37vh",
            scrollCollapse: true,
            initComplete: function () {
                $("#PrizeTeamScrapTable").show();
            }
        });

    });

    function DeletePrizeTeamScrap() {
        var aux;
        $("#dttPrizeTeamScrap tr").each(function () {
            if ($(this).attr("id") == window.$PrizeTeamScrapId) {
                aux = $(this);
            }
        });
        table = $('#dttPrizeTeamScrap').DataTable();
        $.ajax({
            method: "POST",
            url: window.$DeletePrizeTeamScrap,
            data: { prizeTeamScrapId: window.$PrizeTeamScrapId },
            success: function (result) {
                if (result === "true") {
                    Metro.toast.create("Scrap deleted.", null, null, "bg-green fg-white");
                } else {
                    Metro.toast.create("Error deleting the scrap.", null, null, "bg-red fg-white");
                }
                tablePrizeTeamScrap.row(aux).remove().draw();
                Metro.dialog.close('#DeletePrizeTeamScrap')
            }
        });
    }

    function ConfirmDeletePrizeTeamScrap(prizeTeamScrapId) {
        var dialog = Metro.getPlugin('#DeletePrizeTeamScrap', 'dialog');
        dialog.open();
        window.$PrizeTeamScrapId = prizeTeamScrapId;
    }
</script>

