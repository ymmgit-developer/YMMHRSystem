@model List<DtoPrizeTeamSecurityCross>
@using YMMHRSystemLogic
@{
    Layout = null;
}

<div class="row d-flex flex-align-center flex-justify-between mx-5">
    <div><h6 style="color:black">Security Cross</h6></div>
    <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenPrizeTeamSecurityCrossDialog()"><span class="mif-plus"></span><span class="actionButton"> New </span></a></div>
</div>
<div id="PrizeTeamSecurityCrossTable" style="display:none;">
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttPrizeTeamSecurityCross" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">Year</th>
                <th style="text-align: center">Month</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr id="@item.PrizeTeamSecurityCrossId">

                <td style="text-align: center">
                    <span> @item.Year </span>
                </td>

                <td style="text-align: center">
                    <span> @item.Month </span>
                </td>

                <td style="text-align: center">
                    @if (HttpContext.Current.Session["CanDeletePrizeTeam"].Equals(true))
                    {
                        <a class="button small bg-red fg-white" style="cursor: pointer; " onclick="ConfirmDeletePrizeTeamSecurityCross(@item.PrizeTeamSecurityCrossId)"><span class="mif-bin"></span><span class="actionButton"> Delete </span></a>
                    }
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeletePrizeTeamSecurityCross" name="DeletePrizeTeamSecurityCross" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeletePrizeTeamSecurityCross()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeletePrizeTeamSecurityCross')"> No</button>
    </div>
</div>

<script>
    var tablePrizeTeamSecurityCross;
    $(document).ready(function () {

        tablePrizeTeamSecurityCross = $('#dttPrizeTeamSecurityCross').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "37vh",
            scrollCollapse: true,
            initComplete: function () {
                $("#PrizeTeamSecurityCrossTable").show();
            }
        });

    });

    function DeletePrizeTeamSecurityCross() {
        var aux;
        $("#dttPrizeTeamSecurityCross tr").each(function () {
            if ($(this).attr("id") == window.$PrizeTeamSecurityCrossId) {
                aux = $(this);
            }
        });
        table = $('#dttPrizeTeamSecurityCross').DataTable();
        $.ajax({
            method: "POST",
            url: window.$DeletePrizeTeamSecurityCross,
            data: { prizeTeamSecurityCrossId: window.$PrizeTeamSecurityCrossId },
            success: function (result) {
                if (result === "true") {
                    Metro.toast.create("Security Cross deleted.", null, null, "bg-green fg-white");
                } else {
                    Metro.toast.create("Error deleting the security cross.", null, null, "bg-red fg-white");
                }
                tablePrizeTeamSecurityCross.row(aux).remove().draw();
                Metro.dialog.close('#DeletePrizeTeamSecurityCross')
            }
        });
    }

    function ConfirmDeletePrizeTeamSecurityCross(prizeTeamSecurityCrossId) {
        var dialog = Metro.getPlugin('#DeletePrizeTeamSecurityCross', 'dialog');
        dialog.open();
        window.$PrizeTeamSecurityCrossId = prizeTeamSecurityCrossId;
    }
</script>

