@model List<DtoPrizeTeamAttendance>
@using YMMHRSystemLogic
@{
    Layout = null;
}

<div class="row d-flex flex-align-center flex-justify-between mx-5">
    <div><h6 style="color:black">Attendance</h6></div>
    <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenPrizeTeamAttendanceDialog()"><span class="mif-plus"></span><span class="actionButton"> New </span></a></div>
</div>
<div id="PrizeTeamAttendanceTable" style="display:none;">
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttPrizeTeamAttendance" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">Year</th>
                <th style="text-align: center">Month</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="@item.PrizeTeamAttendanceId">
                    <td style="text-align: center">
                        <span> @item.Year </span>
                    </td>
                    <td style="text-align: center">
                        <span> @item.Month </span>
                    </td>
                    <td style="text-align: center">
                        @if (HttpContext.Current.Session["CanDeletePrizeTeam"].Equals(true))
                        {
                            <a class="button small bg-red fg-white" style="cursor: pointer; " onclick="ConfirmDeleteAttendance(@item.PrizeTeamAttendanceId)"><span class="mif-bin"></span><span class="actionButton"> Delete </span></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteAttendance" name="DeleteAttendance" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeletePrizeTeamAttendance()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeleteAttendance')"> No</button>
    </div>
</div>

<script>
    var tableAttendance;
    $(document).ready(function () {

        tableAttendance = $('#dttPrizeTeamAttendance').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "37vh",
            scrollCollapse: true,
            initComplete: function () {
                $("#PrizeTeamAttendanceTable").show();
            }
        });

    });

    function DeletePrizeTeamAttendance() {
        var aux;
        $("#dttPrizeTeamAttendance tr").each(function () {
            if ($(this).attr("id") == window.$AttendanceId) {
                aux = $(this);
            }
        });
        table = $('#dttPrizeTeamAttendance').DataTable();
        $.ajax({
            method: "POST",
            url: window.$DeletePrizeTeamAttendance,
            data: { prizeTeamAttendanceId: window.$AttendanceId },
            success: function (result) {
                if (result === "true") {
                    Metro.toast.create("Attendance deleted.", null, null, "bg-green fg-white");
                } else {
                    Metro.toast.create("Error deleting the attendance.", null, null, "bg-red fg-white");
                }
                tableAttendance.row(aux).remove().draw();
                Metro.dialog.close('#DeleteAttendance')
            }
        });
    }

    function ConfirmDeleteAttendance(attendanceId) {
        var dialog = Metro.getPlugin('#DeleteAttendance', 'dialog');
        dialog.open();
        window.$AttendanceId = attendanceId;
    }
</script>

