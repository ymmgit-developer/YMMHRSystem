@model List<DtoPrizeTeamProductivity>
@using YMMHRSystemLogic
@{
    Layout = null;
}

<div class="row d-flex flex-align-center flex-justify-between mx-5">
    <div><h6 style="color:black">Productivity</h6></div>
    <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenPrizeTeamProductivityDialog()"><span class="mif-plus"></span><span class="actionButton"> New </span></a></div>
</div>
<div id="ProductivityTable" style="display:none;">
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttProductivity" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">Year</th>
                <th style="text-align: center">Month</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="@item.PrizeTeamProductivityId">
                    <td style="text-align: center">
                        <span> @item.Year </span>
                    </td>
                    <td style="text-align: center">
                        <span> @item.Month </span>
                    </td>
                    <td style="text-align: center">
                        @if (HttpContext.Current.Session["CanDeletePrizeTeam"].Equals(true))
                        {
                            <a class="button small bg-red fg-white" style="cursor: pointer; " onclick="ConfirmDeleteProductivity(@item.PrizeTeamProductivityId)"><span class="mif-bin"></span><span class="actionButton"> Delete </span></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteProductivity" name="DeleteProductivity" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeletePrizeTeamProductivity()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeleteProductivity')"> No</button>
    </div>
</div>

<script>
    var tableProductivity;
    $(document).ready(function () {

        tableProductivity = $('#dttProductivity').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "37vh",
            scrollCollapse: true,
            initComplete: function () {
                $("#ProductivityTable").show();
            }
        });

    });

    function DeletePrizeTeamProductivity() {
        var aux;
        $("#dttProductivity tr").each(function () {
            if ($(this).attr("id") == window.$ProductivityId) {
                aux = $(this);
            }
        });
        table = $('#dttProductivity').DataTable();
        $.ajax({
            method: "POST",
            url: window.$DeletePrizeTeamProductivity,
            data: { prizeTeamProductivityId: window.$ProductivityId },
            success: function (result) {
                if (result === "true") {
                    Metro.toast.create("Productivity deleted.", null, null, "bg-green fg-white");
                } else {
                    Metro.toast.create("Error deleting productivity.", null, null, "bg-red fg-white");
                }
                tableProductivity.row(aux).remove().draw();
                Metro.dialog.close('#DeleteProductivity')
            }
        });
    }

    function ConfirmDeleteProductivity(prizeTeamProductivityId) {
        var dialog = Metro.getPlugin('#DeleteProductivity', 'dialog');
        dialog.open();
        window.$ProductivityId = prizeTeamProductivityId;
    }
</script>

