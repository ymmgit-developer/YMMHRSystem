@model List<DtoImmigrationProcedure>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Immigration Procedures";
}
<head>
    <script>
        $SaveImmigrationProcedure = '@Url.Action("SaveImmigrationProcedure", "ImmigrationProcedure", new { area = "YMMHRSystem" })';
        $LoadImmigrationProcedure = '@Url.Action("LoadImmigrationProcedure", "ImmigrationProcedure", new { area = "YMMHRSystem" })';
        $DeleteImmigrationProcedure = '@Url.Action("DeleteImmigrationProcedure", "ImmigrationProcedure", new { area = "YMMHRSystem" })';
        $ApproveImmigrationProcedure = '@Url.Action("ApproveImmigrationProcedure", "ImmigrationProcedure", new { area = "YMMHRSystem" })';
        $RejectImmigrationProcedure = '@Url.Action("RejectImmigrationProcedure", "ImmigrationProcedure", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/ImmigrationProcedure.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Immigration Procedures</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSaveImmigrationProcedure"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' onclick="ImmigrationProcedureDetailDialog(0)"><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>   
    <div class="container-fluid mt-5">
        <div id="ImmigrationProcedureTable" data-step="2" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttImmigrationProcedures" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th style="text-align: center">Associate</th>
                        <th style="text-align: center">Process</th>
                        <th style="text-align: center">Document Type</th>
                        <th style="text-align: center">Procedure Type</th>
                        <th style="text-align: center">Status</th>
                        <th style="text-align: center">Motive</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                    <tr>

                        <td style="text-align: center">
                            <span> @item.Associate </span>
                        </td>

                        <td style="text-align: center">
                            <span> @item.Process </span>
                        </td>

                        <td style="text-align: center">
                            <span> @item.DocumentType </span>
                        </td>

                        <td style="text-align: center">
                            <span> @item.ProcedureType </span>
                        </td>

                        <td style="text-align: center">
                            <span> @(item.Status == 1 ? "New" : item.Status == 2 ? "Approved" : "Rejected" ) </span>
                        </td>

                        <td style="text-align: center">
                            <span> @item.Motive </span>
                        </td>

                        <td style="text-align: center">
                            <a class="button bg-black fg-white" style="cursor: pointer;" onclick="ImmigrationProcedureDetailDialog(@item.ImmigrationProcedureId)"><span class="mif-eye"></span><span class="actionButton"> View</span></a>
                            @if (HttpContext.Current.Session["CanDeleteImmigrationProcedure"].Equals(true))
                            {
                                <a class="button bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteImmigrationProcedure(@item.ImmigrationProcedureId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                            }
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-width="1000" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="ImmigrationProcedureDetail" name="ImmigrationProcedureDetail" class="dialog" data-role="dialog">

    </div>


    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="Error" name="Error" class="dialog" data-role="dialog">
        <div class="dialog-title">Error</div>
        <div class="dialog-content">
            <p>- Immigration Procedure already exists</p>
        </div>
        <div class="dialog-actions ml-auto">
            <button class="button alert" onclick="Metro.dialog.close('#Error')">OK</button>
        </div>
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteImmigrationProcedure" name="DeleteImmigrationProcedure" class="dialog" data-role="dialog">
        <div class="dialog-title">Delete</div>
        <div class="dialog-content"> Are you sure you want to delete this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="DeleteImmigrationProcedure()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#DeleteImmigrationProcedure')"> No</button>
        </div>
    </div>
</body>

