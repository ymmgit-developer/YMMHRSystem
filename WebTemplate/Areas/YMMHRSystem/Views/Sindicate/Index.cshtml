@model List<DtoSindicate>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Sindicate";
}
<head>
    <script>
        $SaveSindicate = '@Url.Action("SaveSindicate", "Sindicate", new { area = "YMMHRSystem" })';
        $LoadSindicate = '@Url.Action("LoadSindicate", "Sindicate", new { area = "YMMHRSystem" })';
        $DeleteSindicate = '@Url.Action("DeleteSindicate", "Sindicate", new { area = "YMMHRSystem" })';
        $AttachmentDialog = '@Url.Action("AttachmentDialog", "Sindicate", new { area = "YMMHRSystem" })';
        $AddAttachment = '@Url.Action("AddAttachment", "Sindicate", new { area = "YMMHRSystem" })';
        $AttachmentListDialog = '@Url.Action("AttachmentListDialog", "Sindicate", new { area = "YMMHRSystem" })';
        $DeleteAttachment = '@Url.Action("DeleteAttachmentFile", "Sindicate", new { area = "YMMHRSystem" })';
        $ContractDialog = '@Url.Action("ContractDialog", "Sindicate", new { area = "YMMHRSystem" })';
        $AddContract = '@Url.Action("AddContract", "Sindicate", new { area = "YMMHRSystem" })';
        $DeleteContract = '@Url.Action("DeleteContractFile", "Sindicate", new { area = "YMMHRSystem" })';
        $ContractListDialog = '@Url.Action("ContractListDialog", "Sindicate", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/Sindicate.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Sindicate</h5>
        <div class="ml-auto pr-5">
            <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' onclick="OpenContractListDialog()"><span class="mif-file-text"></span><span class="actionButton"> Contracts </span></a>
            @if (HttpContext.Current.Session["CanSaveSindicate"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' onclick="SindicateDetailDialog(0)"><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>

    <div class="container-fluid mt-5">
        <div id="SindicateTable" data-step="2" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttSindicates" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th style="text-align: center">Issue</th>
                        <th style="text-align: center">Date</th>
                        <th style="text-align: center">Total</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td style="text-align: center">
                                <span> @item.Issue </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Date </span>
                            </td>

                            <td style="text-align: center">
                                <span> @(item.AdministrativeSupport + item.UnionFee) </span>
                            </td>

                            <td style="text-align: center">
                                <a class="button bg-black fg-white" style="cursor: pointer;" onclick="SindicateDetailDialog(@item.SindicateId)"><span class="mif-eye"></span><span class="actionButton"> View</span></a>
                                @if (HttpContext.Current.Session["CanDeleteSindicate"].Equals(true))
                                {
                                    <a class="button bg-blue fg-white" style="cursor: pointer;" onclick="OpenAttachmentListDialog(@item.SindicateId)"><span class="mif-file-text"></span><span class="actionButton"> Attach</span></a>
                                    <a class="button bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteSindicate(@item.SindicateId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-width="500" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="SindicateDetail" name="SindicateDetail" class="dialog" data-role="dialog">
    </div>
    <div data-overlay="true" data-width="700" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="AttachmentListDialog" name="AttachmentListDialog" class="dialog" data-role="dialog">
    </div>
    <div data-overlay="true" data-width="700" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="ContractListDialog" name="ContractListDialog" class="dialog" data-role="dialog">
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="Error" name="Error" class="dialog" data-role="dialog">
        <div class="dialog-title">Error</div>
        <div class="dialog-content">
            <p>- Sindicate already exists</p>
        </div>
        <div class="dialog-actions ml-auto">
            <button class="button alert" onclick="Metro.dialog.close('#Error')">OK</button>
        </div>
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteSindicate" name="DeleteSindicate" class="dialog" data-role="dialog">
        <div class="dialog-title">Delete</div>
        <div class="dialog-content"> Are you sure you want to delete this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="DeleteSindicate()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#DeleteSindicate')"> No</button>
        </div>
    </div>
</body>

