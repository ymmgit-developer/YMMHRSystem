@model List<DtoExtraordinaryTransport>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Extraordinary Transports";
}
<head>
    <script>
        $SaveExtraordinaryTransport = '@Url.Action("SaveExtraordinaryTransport", "Transport", new { area = "YMMHRSystem" })';
        $AddExtraordinaryTransport = '@Url.Action("AddExtraordinaryTransport", "Transport", new { area = "YMMHRSystem" })';
        $LoadExtraordinaryTransport = '@Url.Action("LoadExtraordinaryTransport", "Transport", new { area = "YMMHRSystem" })';
        $CancelExtraordinaryTransport = '@Url.Action("CancelExtraordinaryTransport", "Transport", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/Transport.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Extra Transports</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSaveExtraordinaryTransport"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' onclick="ExtraordinaryTransportAddDialog()"><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>

    <div class="container-fluid mt-5" style="font-size: 0.8rem">
        <div id="ExtraordinaryTransportTable" style="display: none" data-step="2" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttExtraordinaryTransports" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th style="text-align: center">Applicant</th>
                        <th style="text-align: center">Process</th>
                        <th style="text-align: center">Associate</th>
                        <th style="text-align: center">Route</th>
                        <th style="text-align: center">Stop</th>
                        <th style="text-align: center">Date For</th>
                        <th style="text-align: center">Status</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="text-align: center">
                                <span> @item.UserCreated </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Process </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.AssociateName </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Route </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Stop </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.StartDate.ToString().Substring(0,10) @item.StartTime.ToString(@"hh\:mm") </span>
                            </td>

                            <td style="text-align: center">
                                <span> @(item.Status == 1 ? "Generated" : item.Status == 3 ? "Confirmed" : "Cancelled") </span>
                            </td>

                            <td style="text-align: center">
                                <a class="button small bg-black fg-white" style="cursor: pointer;" onclick="ExtraordinaryTransportDetailDialog(@item.ExtraordinaryTransportId)">
                                    <span class="mif-eye"></span>
                                    <span class="actionButton"> View</span>
                                </a>

                                @if (HttpContext.Current.Session["CanCancelExtraordinaryTransport"].Equals(true))
                                {
                                    if (item.Status == 1) // Only allow cancellation if the status is pending (assuming status 1 is pending)
                                    {
                                        if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                                        {
                                            <a class="button small bg-red fg-white" style="cursor: pointer;" onclick="ConfirmCancelExtraordinaryTransport(@item.ExtraordinaryTransportId)">
                                                <span class="mif-cancel"></span>
                                                <span class="actionButton"> Cancel</span>
                                            </a>
                                        }
                                        else if ((!Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) && !Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"]))) &&
                                                 Convert.ToDateTime(item.StartDate + item.StartTime).Subtract(DateTime.Now).TotalHours > 2)
                                        {
                                            <a class="button small bg-red fg-white" style="cursor: pointer;" onclick="ConfirmCancelExtraordinaryTransport(@item.ExtraordinaryTransportId)">
                                                <span class="mif-cancel"></span>
                                                <span class="actionButton"> Cancel</span>
                                            </a>
                                        }
                                    }
                                }

                                @if (item.Status == 1 && (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"]))))
                                {
                                    <a class="button small bg-green fg-white" style="cursor: pointer;" href="@Url.Action("ConfirmExtraordinaryTransport", "Transport", new { Area = "YMMHRSystem", extraordinaryTransportId = item.ExtraordinaryTransportId })">
                                        <span class="mif-checkmark"></span>
                                        <span class="actionButton"> Confirm</span>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-width="900" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="ExtraordinaryTransportDetail" name="ExtraordinaryTransportDetail" class="dialog" data-role="dialog">

    </div>

    <div data-overlay="true" data-width="1500" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="ExtraordinaryTransportAddDialog" name="ExtraordinaryTransportAddDialog" class="dialog" data-role="dialog">

    </div>

    <div data-overlay="true" data-width="500" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="Error" name="Error" class="dialog" data-role="dialog">
        <div class="dialog-title">Error</div>
        <div class="dialog-content">
            @*<p>- Transport already exists</p>
            <p>- Please select an associate</p>
            <p>- Please request same day transport earlier than 3:30pm</p>
            <p>- Please request next day transport earlier than 4:56pm</p>
            <p>- Please request Saturday transport earlier than 10:30am Friday</p>
            <p>- Please request transport within 4 hour window </p>*@
        </div>
        <div class="dialog-actions ml-auto">
            <button class="button alert" onclick="Metro.dialog.close('#Error')">OK</button>
        </div>
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="CancelExtraordinaryTransport" name="CancelExtraordinaryTransport" class="dialog" data-role="dialog">
        <div class="dialog-title">Cancel</div>
        <div class="dialog-content"> Are you sure you want to cancel this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="CancelExtraordinaryTransport()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#CancelExtraordinaryTransport')"> No</button>
        </div>
    </div>
</body>

