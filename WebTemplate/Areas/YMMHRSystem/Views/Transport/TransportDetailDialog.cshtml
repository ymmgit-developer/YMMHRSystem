@model DtoTransport
@using YMMHRSystemLogic
@{
    Layout = null;
    YMMHRSystemLogic.Route route = new YMMHRSystemLogic.Route();
    var routeList = route.LoadMultiple();

}
<div class="dialog-title">Transports</div>

<div class="dialog-content">
    <form id="TransportForm" data-role="validator" data-on-validate-form="AddTransport()" action="javascript:">
        <div class="row">
            <div class="cell-md-12">
                <div class="row mb-2">
                    <div class="cell-md-5">
                        <select data-on-change="RouteSelected()" data-role="select" id="RouteSelect" name="RouteSelect" data-prepend="Route:">
                            @foreach (var item in routeList)
                            {
                                if (Model.Route == item.Name && Model.Shift == item.Shift)
                                {
                                    <option selected id="@item.Shift" value="@item.Cost">@item.Name</option>
                                }
                                else
                                {
                                    <option id="@item.Shift" value="@item.Cost">@item.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="cell-md-4">
                        <input type="text" name="Shift" id="Shift" data-role="input" readonly="readonly" data-prepend="Shift:" autocomplete="off" value="">
                    </div>
                    <div class="cell-md-3">
                        @if (Model.Type)
                        {
                            <input type="radio" checked class="routeCheck" id="Simple" name="transportTypeRadio" data-role="radio" data-style="2" data-caption="Simple">
                            <input type="radio" class="routeCheck" id="Round" name="transportTypeRadio" data-role="radio" data-style="2" data-caption="Round">
                        }
                        else
                        {
                            <input type="radio" class="routeCheck" id="Simple" name="transportTypeRadio" data-role="radio" data-style="2" data-caption="Simple">
                            <input type="radio" checked class="routeCheck" id="Round" name="transportTypeRadio" data-role="radio" data-style="2" data-caption="Round">
                        }
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <input data-prepend="Start Date:" autocomplete="off" id="StartDate" name="StartDate" value="@(Model.StartDate == DateTime.MinValue ? DateTime.Now : Model.StartDate )" data-validate="required" data-role="calendarpicker" data-cls-calendar="compact" data-input-format="%d/%m/%y">
                        <span class="invalid_feedback">
                            Enter a starting date
                        </span>
                    </div>
                    <div class="cell">
                        <input data-prepend="Finish Date:" autocomplete="off" id="FinishDate" name="FinishDate" value="@(Model.FinishDate == DateTime.MinValue ? DateTime.Now : Model.FinishDate )" data-validate="required" data-role="calendarpicker" data-cls-calendar="compact" data-input-format="%d/%m/%y">
                        <span class="invalid_feedback">
                            Enter a finishing date
                        </span>
                    </div>
                </div>
            </div>
        </div>
        @Html.Hidden("Route", Model.Route)
        @Html.Hidden("Cost", Model.Cost)
        @Html.Hidden("Type", Model.Type)
        @Html.Hidden("UserCreated", Model.UserCreated)
        @Html.Hidden("Date", Model.Date)
        <div class="row">
            <div class="dialog-actions d-flex flex-justify-start w-100">
                @if (HttpContext.Current.Session["CanSaveTransport"].Equals(true))
                {
                    <div><button id="SaveTransport" class="button my-control-colors"><span class="mif-floppy-disk"></span> Save </button></div>
                }
                <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>
            </div>
        </div>
    </form>
</div>
<script>
    $(document).ready(function () {

        $(".routeCheck").on("change", function (e) {
            if (e.target.checked) {
                if (e.target.id == "Simple") {
                    $('#Type').val("true");
                } else {
                    $('#Type').val("false");
                }
            }
        });

        RouteSelected();
    });

    function RouteSelected() {
        $("#Shift").val($("#RouteSelect option:selected").prop('id'));
        $("#Cost").val($("#RouteSelect option:selected").val());
    }
</script>
