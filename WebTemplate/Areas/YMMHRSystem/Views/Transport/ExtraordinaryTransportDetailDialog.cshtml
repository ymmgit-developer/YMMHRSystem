@model DtoExtraordinaryTransport
@using YMMHRSystemLogic
@{
    Layout = null;
    WorkerFile workerFile = new WorkerFile();
    var associateList = workerFile.LoadMultiple();
}


<div class="dialog-title">Extra Transport</div>

<div class="dialog-content">
    <form id="ExtraTransportForm" data-role="validator" data-on-validate-form="AddExtraordinaryTransport()" action="javascript:">
        <div class="row">
            <div class="cell-md-12">
                <div class="row mb-2">
                    <div class="cell">
                        @if (Model.ExtraordinaryTransportId == 0)
                        {
                            <input type="text" name="AssociateName" id="AssociateName" onclick="Metro.dialog.open('#AssociateImporter')" data-validate="required" data-role="input" readonly="readonly" data-prepend="Associate:" autocomplete="off" value="@Model.AssociateName">
                        }
                        else
                        {
                            <input type="text" name="AssociateName" id="AssociateName" data-role="input" readonly="readonly" data-prepend="Associate:" autocomplete="off" value="@Model.AssociateName">
                        }
                    </div>
                    @if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                    {
                        <div class="cell">
                            <input type="text" data-role="input" value="@Model.Cost" data-prepend="Cost: $" id="Cost" name="Cost">
                        </div>
                    }
                </div>
                <div class="row mb-2">
                    <div class="cell-md-6">
                        @if (Model.ExtraordinaryTransportId != 2)
                        {
                            <input data-prepend="Arrival Date:" autocomplete="off" id="StartDate" name="StartDate" value="@Model.StartDate" data-role="calendarpicker" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                        }
                        else
                        {
                            <input type="text" name="StartDate" id="StartDate" data-role="input" readonly="readonly" data-prepend="Arrival Date:" autocomplete="off" value="@(Model.StartDate?.ToString("yyyy-MM-dd") == "1900-01-01" ? null : Model.StartDate?.ToString("yyyy-MM-dd"))">
                        }

                    </div>
                    <div class="cell-md-6">
                        <input style="font-size:12px;" data-role="timepicker" data-seconds="false" data-value="@Model.StartTime" id="StartTime" name="StartTime">
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-6">
                        @if (Model.ExtraordinaryTransportId != 2)
                        {
                            <input data-prepend="Departure Date:" autocomplete="off" id="FinishDate" name="FinishDate" value="@Model.FinishDate" data-role="calendarpicker" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                        }
                        else
                        {
                            <input type="text" name="FinishDate" id="FinishDate" data-role="input" readonly="readonly" data-prepend="Departure Date:" autocomplete="off" value="@(Model.FinishDate?.ToString("yyyy-MM-dd") == "1900-01-01" ? null : Model.FinishDate?.ToString("yyyy-MM-dd"))">
                        }
                    </div>
                    <div class="cell-md-6">
                        <input style="font-size:12px;" data-role="timepicker" data-seconds="false" data-value="@Model.FinishTime" id="FinishTime" name="FinishTime">
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <input type="text" name="Route" id="Route" data-role="input" readonly="readonly" data-prepend="Route:" autocomplete="off" value="@Model.Route">
                    </div>
                    <div class="cell">
                        <input type="text" name="Stop" id="Stop" data-role="input" readonly="readonly" data-prepend="Stop:" autocomplete="off" value="@Model.Stop">
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <textarea data-role="textarea" data-prepend="Motive:" name="Motive" id="Motive" data-validate="required" autocomplete="off" value="">@Model.Motive</textarea>
                    </div>
                </div>
                <div class="row">

                    <div class="cell">
                        @if (Model.ShiftChange)
                        {
                            <input type="checkbox" data-role="checkbox" data-style="2" checked="checked" data-caption="Shift Change" class="shiftChangeCheck">
                        }
                        else
                        {
                            <input type="checkbox" data-role="checkbox" data-style="2" data-caption="Shift Change" class="shiftChangeCheck">
                        }
                    </div>
                </div>
            </div>
        </div>
        @Html.Hidden("Process", Model.Process)
        @Html.Hidden("UserCreated", Model.UserCreated)
        @Html.Hidden("Date", Model.Date)
        @Html.Hidden("Contacts", Model.Contacts)
        @Html.Hidden("Status", Model.Status)
        @Html.Hidden("CreatedBy", Model.CreatedBy)
        @Html.Hidden("ShiftChange", Model.ShiftChange)
        <div class="row">
            <div class="dialog-actions d-flex flex-justify-start w-100">
                @if (HttpContext.Current.Session["CanSaveExtraordinaryTransport"].Equals(true) && Model.Status <= 1)
                {
                    <div><button id="SaveTransport" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button></div>
                }
                else if(Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                {
                    <div><button id="SaveTransport" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button></div>
                }
                <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>
            </div>
        </div>
    </form>
</div>

<div data-overlay="true" data-width="900" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="AssociateImporter" name="AssociateImporter" class="dialog" data-role="dialog">
    @Html.Partial("~/Areas/YMMHRSystem/Views/Shared/AssociateList.cshtml", associateList)
</div>

<script>
    $(document).ready(function () {

        setInterval(function () {
            $("#Cost").val($("#Cost").val().toString().match(/^-?\d+(?:\.\d{0,2})?/));
        }, 500);
    });

    $(".shiftChangeCheck").on("change", function (e) {
        if (e.target.checked) {
            $('#ShiftChange').val("true");
        } else {
            $('#ShiftChange').val("false");
        }
    });
</script>
