@model DtoExtraordinaryTransport
@using YMMHRSystemLogic
@{
    Layout = null;
    WorkerFile workerFile = new WorkerFile();
    YMMHRSystemLogic.Route route = new YMMHRSystemLogic.Route();
    var routeList = route.LoadMultiple();
    var stopList = route.GetRouteStopList(routeList[0].RouteId);
    var associateList = workerFile.LoadMultiple();
}


<div class="dialog-title">Extra Transport</div>

<div class="dialog-content">
    <form id="ExtraTransportForm" data-role="validator" data-on-validate-form="AddExtraordinaryTransport()" action="javascript:">
        <div class="row">
            <div class="cell-md-12">
                <div class="row mb-2">
                    <div class="cell-md-10">
                        <input type="text" name="AssociateName" id="AssociateName" data-validate="required" data-role="input" readonly="readonly" data-prepend="Associate:" autocomplete="off" value="@Model.AssociateName">
                        <span class="invalid_feedback">
                            Select an Associate
                        </span>
                    </div>
                    <div class="cell-md-2">
                        <a class="button my-button-colors" style="cursor: pointer; color: white;" onclick="Metro.dialog.open('#AssociateImporter')"><span class="mif-user-plus"></span><span class="actionButton"> Select</span></a>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-6">
                        @if (Model.ExtraordinaryTransportId == 0)
                        {
                            <input type="checkbox" id="startCheck" class="dateCheck" data-role="checkbox" data-style="2" data-caption="Enable">
                            <input data-prepend="Start Date:" disabled autocomplete="off" id="StartDate" name="StartDate" value="@Model.StartDate" data-role="calendarpicker" data-cls-calendar="compact" data-input-format="%d/%m/%y">
                        }
                        else
                        {
                            <input type="text" name="StartDate" id="StartDate" data-role="input" readonly="readonly" data-prepend="Start Date:" autocomplete="off" value="@(Model.StartDate?.ToString("yyyy-MM-dd") == "1900-01-01" ? null : Model.StartDate?.ToString("yyyy-MM-dd"))">
                        }

                    </div>
                    <div class="cell-md-6">
                        @if (Model.ExtraordinaryTransportId == 0)
                        {
                            <input type="checkbox" id="finishCheck" class="dateCheck" data-role="checkbox" data-style="2" data-caption="Enable">
                            <input data-prepend="Finish Date:" disabled autocomplete="off" id="FinishDate" name="FinishDate" value="@Model.FinishDate" data-role="calendarpicker" data-cls-calendar="compact" data-input-format="%d/%m/%y">
                        }
                        else
                        {
                            <input type="text" name="FinishDate" id="FinishDate" data-role="input" readonly="readonly" data-prepend="Finish Date:" autocomplete="off" value="@(Model.FinishDate?.ToString("yyyy-MM-dd") == "1900-01-01" ? null : Model.FinishDate?.ToString("yyyy-MM-dd"))">
                        }
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-6">
                        <input style="font-size:12px;" data-role="timepicker" data-seconds="false" data-value="@Model.StartTime" id="StartTime" name="StartTime">
                    </div>
                    <div class="cell-md-6">
                        <input style="font-size:12px;" data-role="timepicker" data-seconds="false" data-value="@Model.FinishTime" id="FinishTime" name="FinishTime">
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <select data-on-change="RouteSelected()" data-role="select" id="RouteSelect" name="RouteSelect" data-prepend="Route:">
                            @foreach (var item in routeList)
                            {
                                if (Model.Route == item.Name)
                                {
                                    <option selected id="@item.Shift" value="@item.RouteId">@item.Name</option>
                                }
                                else
                                {
                                    <option id="@item.Shift" value="@item.RouteId">@item.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="cell">
                        <input type="text" name="Shift" id="Shift" data-role="input" readonly="readonly" data-prepend="Shift:" autocomplete="off" value="@Model.Shift">
                    </div>
                    <div class="cell">
                        <select data-role="select" id="Stop" name="Stop" data-prepend="Stop:">
                            @foreach (var item in stopList)
                            {
                                if (Model.Stop == item.StopName)
                                {
                                    <option selected value="@item.StopName">@item.StopName</option>
                                }
                                else
                                {
                                    <option value="@item.StopName">@item.StopName</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <textarea data-role="textarea" data-prepend="Motive:" name="Motive" id="Motive" data-validate="required" autocomplete="off" value="">@Model.Motive</textarea>
                        <span class="invalid_feedback">
                            Enter a Motive
                        </span>
                    </div>
                </div>
                @if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                {
                    <div class="row">
                        <div class="cell">
                            <input type="text" data-role="input" value="@Model.Cost" data-prepend="Cost: $" id="Cost" name="Cost">
                        </div>
                    </div>
                }
            </div>
        </div>
        @Html.Hidden("Process", Model.Process)
        @Html.Hidden("Route", Model.Route)
        @Html.Hidden("UserCreated", Model.UserCreated)
        @Html.Hidden("Date", Model.Date)
        <div class="row">
            <div class="dialog-actions d-flex flex-justify-start w-100">
                @if (HttpContext.Current.Session["CanSaveExtraordinaryTransport"].Equals(true))
                {
                    <div><button id="SaveTransport" class="button my-control-colors"><span class="mif-floppy-disk"></span> Save </button></div>
                }
                <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>
            </div>
        </div>
    </form>
</div>

<div data-overlay="true" data-width="900" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="AssociateImporter" name="AssociateImporter" class="dialog" data-role="dialog">
    @Html.Partial("~/Areas/YMMHRSystem/Views/Shared/AssociateList.cshtml", associateList)
</div>

<script>
    $(document).ready(function () {

        $(".dateCheck").on("change", function (e) {
            if (e.target.checked) {
                if (e.target.id == "finishCheck") {
                    $('#FinishDate').prop('disabled', false);
                } else {
                    $('#StartDate').prop('disabled', false);
                }
            } else {
                if (e.target.id == "finishCheck") {
                    $('#FinishDate').prop('disabled', true);
                } else {
                    $('#StartDate').prop('disabled', true);
                }
            }
        });

        setInterval(function () {
            $("#Cost").val($("#Cost").val().toString().match(/^-?\d+(?:\.\d{0,2})?/));
        }, 500);

        RouteSelected();
    });

    function RouteSelected() {
        var routeId = $("#RouteSelect option:selected").val();
        $("#Shift").val($("#RouteSelect option:selected").prop('id'));
        var StopSelect = Metro.getPlugin("#Stop", 'select');

        var output = [];

        $.ajax({
            type: 'POST',
            url: $LoadStops,
            data: { routeId: routeId },
            success: function (response) {
                StopSelect.data([]);
                var data = response;
                $.each(data, function (key, val) {
                    output.push("<option value='" + data[key].StopName + "'>" + data[key].StopName + "</option>");
                });
                StopSelect.data(output.join(''));
            },
        });
    }
</script>
