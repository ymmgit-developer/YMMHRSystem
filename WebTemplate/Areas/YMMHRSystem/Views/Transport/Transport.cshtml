@model List<DtoTransport>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Transports";
}
<head>
    <script>
        $SaveTransport = '@Url.Action("SaveTransport", "Transport", new { area = "YMMHRSystem" })';
        $LoadTransport = '@Url.Action("LoadTransport", "Transport", new { area = "YMMHRSystem" })';
        $DeleteTransport = '@Url.Action("DeleteTransport", "Transport", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/Transport.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Transports</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSaveTransport"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' onclick="TransportDetailDialog(0)"><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>

    <div class="container-fluid mt-5">
        <div id="TransportTable" data-step="2" style="display: none" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttTransports" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th style="text-align: center">Route</th>
                        <th style="text-align: center">Cost</th>
                        <th style="text-align: center">Start Date</th>
                        <th style="text-align: center">Finish Date</th>
                        <th style="text-align: center">Created By</th>
                        <th style="text-align: center">Date</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                    <tr>

                        <td style="text-align: center">
                            <span> @item.Route </span>
                        </td>

                        <td style="text-align: center">
                            <span> @item.Cost </span>
                        </td>

                        <td style="text-align: center">
                            <span> @item.StartDate.ToShortDateString() </span>
                        </td>

                        <td style="text-align: center">
                            <span> @item.FinishDate.ToShortDateString() </span>
                        </td>

                        <td style="text-align: center">
                            <span> @item.UserCreated </span>
                        </td>

                        <td style="text-align: center">
                            <span> @item.Date </span>
                        </td>

                        <td style="text-align: center">
                            <a class="button bg-black fg-white"  style="cursor: pointer;" onclick="TransportDetailDialog(@item.TransportId)"><span class="mif-eye"></span><span class="actionButton"> View</span></a>
                            @if (HttpContext.Current.Session["CanDeleteTransport"].Equals(true))
                            {
                                <a class="button bg-red fg-white"style="cursor: pointer;" onclick="ConfirmDeleteTransport(@item.TransportId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                            }
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-width="800" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="TransportDetail" name="TransportDetail" class="dialog" data-role="dialog">

    </div>


    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="Error" name="Error" class="dialog" data-role="dialog">
        <div class="dialog-title">Error</div>
        <div class="dialog-content">
            <p>- Transport already exists</p>
        </div>
        <div class="dialog-actions ml-auto">
            <button class="button alert" onclick="Metro.dialog.close('#Error')">OK</button>
        </div>
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteTransport" name="DeleteTransport" class="dialog" data-role="dialog">
        <div class="dialog-title">Delete</div>
        <div class="dialog-content"> Are you sure you want to delete this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="DeleteTransport()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#DeleteTransport')"> No</button>
        </div>
    </div>
</body>

