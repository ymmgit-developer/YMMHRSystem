                            </div>
                        </div>
                        @if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                        {
                            @*<input data-prepend="Arrival Date:" autocomplete="off" id="StartDate" name="StartDate" value="" data-role="calendarpicker" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">*@

                        }
                        else
                        {
                            @*<input data-prepend="Arrival Date:" data-min-date="@DateTime.Now" autocomplete="off" id="StartDate" name="StartDate" value="" data-role="calendarpicker" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">*@
                        }
                    </div>
                    <div class="cell-md-6">
                        <div class="row">
                            @if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                            {
                                DateTime now = DateTime.Now;
                                string hour = now.Hour.ToString("D2");
                                string minute = now.Minute.ToString("D2");
                                string value = hour + ":" + minute;
                                <div class="cell-12">
                                    @*<div class="form-group">
            <label>Arrival Time:</label>
            <input type="time" class="w-100" id="StartTime" name="StartTime" disabled>
        </div>*@
                                    <input data-role="input" type="time" data-prepend="Arrival Time:" autocomplete="off" id="StartTime" name="StartTime" disabled>
                                </div>
                            }
                            else
                            {
                                DateTime now = DateTime.Now;
                                now = now.AddHours(2);
                                string hour = now.Hour.ToString("D2");
                                string minute = now.Minute.ToString("D2");
                                string value = hour + ":" + minute;
                        <div class="cell-12">
                            <div class="row">
                                <div class="col-6">
                                    @*<label>Arrival Time:</label>
        <input type="time" class="form-control w-100" id="StartTime" name="StartTime" min="@value" disabled>*@
                                    <input data-role="input" type="time" data-prepend="Arrival Time:" autocomplete="off" id="StartTime" name="StartTime" disabled>
                                    <div id="SuggestedTimeTooltip" style="display: none;" class="fg-green">
                                        Suggested time
                                    </div>
                                    <div id="InvalidTimeTooltip" class="invalid_feedback">
                                        The scheduled time cannot be less
                                    </div>
                                </div>
                                <div class="col-6">
                                    <input type="checkbox" data-role="switch" name="NoStartTime" id="NoStartTime" data-caption="No start time">
                                </div>
                            </div>
                        </div>
                                @*<input style="font-size:12px;" data-role="timepicker" data-seconds="false" data-value="0" id="StartTime" name="StartTime">*@
