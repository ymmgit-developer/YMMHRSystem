@model DtoExtraordinaryTransport
@using YMMHRSystemLogic
@{
    Layout = null;
    WorkerFile workerFile = new WorkerFile();
    var associateList = workerFile.LoadMultiple();
}

<div class="dialog-title">Extra Transport</div>

<div class="dialog-content">
    <form id="ExtraTransportForm" data-role="validator" data-on-validate-form="AddExtraordinaryTransport()" action="javascript:">
        <div class="row">
            <div class="cell-md-6">
                <div class="row d-flex flex-align-center flex-justify-between mx-5">
                    <div><h6 style="color:black">Associates</h6></div>
                    <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="Metro.dialog.open('#MultiSelectAssociateImporter')"><span class="mif-user-plus"></span><span class="actionButton"> Add </span></a></div>
                </div>
                <div id="AssociateTable">
                    <!---------------------------------------TABLA ------------------------------------------>
                    <table id="dttAssociateList" class="display compact" style="width:100%">
                        <thead>
                            <tr>
                                <th style="text-align: center">Names</th>
                                <th style="text-align: center">Process</th>
                                <th style="text-align: center"></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <!---SPLIT--->
            <div class="cell-md-6">
                <div class="row mb-2 flex-justify-center flex-align-center">
                    <div class="cell-md-12">
                        <label>Email Contacts</label>
                        <input id="Contacts" value="" name="Contacts" data-on-before-tag-add="onBeforeTagAdd" data-max-tags="10" type="text" data-role="taginput">
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-6">
                        @if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                        {
                            <input data-prepend="Arrival Date:" autocomplete="off" id="StartDate" name="StartDate" value="" data-role="calendarpicker" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                        }
                        else
                        {
                            <input data-prepend="Arrival Date:" data-min-date="@DateTime.Now" autocomplete="off" id="StartDate" name="StartDate" value="" data-role="calendarpicker" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                        }
                    </div>
                    <div class="cell-md-6">
                        <input style="font-size:12px;" data-role="timepicker" data-seconds="false" data-value="0" id="StartTime" name="StartTime">
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell-md-6">
                        @if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                        {
                            <input data-prepend="Departure Date:" autocomplete="off" id="FinishDate" name="FinishDate" value="" data-role="calendarpicker" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                        }
                        else
                        {
                            <input data-prepend="Departure Date:" data-min-date="@DateTime.Now" autocomplete="off" id="FinishDate" name="FinishDate" value="" data-role="calendarpicker" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                        }
                    </div>
                    <div class="cell-md-6">
                        <input style="font-size:12px;" data-role="timepicker" data-seconds="false" data-value="0" id="FinishTime" name="FinishTime">
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <textarea data-role="textarea" data-prepend="Motive:" name="Motive" id="Motive" data-validate="required maxlength=400" data-chars-counter="#chars-counter" data-chars-counter-template=" $1 char(s)" autocomplete="off" value="">@Model.Motive</textarea>
                        <p style="font-size: 0.8rem" id="chars-counter"> 0 char(s)</p>
                    </div>
                </div>
            </div>
        </div>
        @Html.Hidden("ShiftChange", Model.ShiftChange)
        @Html.Hidden("Process", Model.Process)
        @Html.Hidden("UserCreated", Model.UserCreated)
        @Html.Hidden("Date", Model.Date)
        <div class="row">
            <div class="dialog-actions d-flex flex-justify-between w-100">
                @if (HttpContext.Current.Session["CanSaveExtraordinaryTransport"].Equals(true) && Model.Status != 2)
                {
                    <div>
                        <button id="SaveTransport" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button>
                        <span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span>
                    </div>
                }
                <div>
                    @if (Model.ShiftChange)
                    {
                        <input type="checkbox" data-role="checkbox" data-style="2" checked="checked" data-caption="Shift Change" class="shiftChangeCheck">
                    }
                    else
                    {
                        <input type="checkbox" data-role="checkbox" data-style="2" data-caption="Shift Change" class="shiftChangeCheck">
                    }
                </div>
            </div>
        </div>
    </form>
</div>

<div data-overlay="true" data-width="800" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="MultiSelectAssociateImporter" name="MultiSelectAssociateImporter" class="dialog" data-role="dialog">
    @Html.Partial("~/Areas/YMMHRSystem/Views/Shared/MultiSelectAssociateList.cshtml", associateList)
</div>

<script>
    var table;
    $(document).ready(function () {

        table = $('#dttAssociateList').DataTable({
            responsive: true,
            retrieve: true,
            searching: false,
            info: false,
            compact: true,
            paging: false,
            ordering: false,
            scrollY: "33vh",
            scrollCollapse: true,
        });

        setInterval(function () {
            $("#Cost").val($("#Cost").val().toString().match(/^-?\d+(?:\.\d{0,2})?/));
        }, 500);
    });

    function RemoveAssociate(names) {
        var aux;
        $("#dttAssociateList td").each(function () {
            if ($(this).text() === names) {
                aux = $(this).parents('tr');
            }
        });
        table.row(aux).remove().draw();
        Metro.toast.create("Associate removed.", null, null, "bg-green fg-white");
    }

    $(".shiftChangeCheck").on("change", function (e) {
        if (e.target.checked) {
            $('#ShiftChange').val("true");
        } else {
            $('#ShiftChange').val("false");
        }
    });
</script>
<script>
    function onBeforeTagAdd(val) {

        var regex = /^[a-zA-Z0-9._-]+@@yachiyo.com.mx\s*$/;
        if (regex.test(val)) {
            return true;
        } else {
            regex = /^[a-zA-Z0-9._-]+@@yachiyo-ind.co.jp\s*$/;
            if (regex.test(val)) {
                return true;
            } else {
                Metro.toast.create("Enter a correct email", null, null, "bg-red fg-white");
                return false;
            }

        }
    }
</script>