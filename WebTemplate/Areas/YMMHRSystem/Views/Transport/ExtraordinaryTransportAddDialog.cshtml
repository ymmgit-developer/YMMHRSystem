                                    <input type="time" class="w-100" id="FinishTime" name="FinishTime" disabled>*@
                                    <input data-role="input" type="time" data-prepend="Departure Time:" autocomplete="off" id="FinishTime" name="FinishTime" disabled data-input>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="display: none;">
                    <input autocomplete="off" id="FinishDate" name="FinishDate" value="">
                    
                </div>
                @*<div class="row mb-2">
                        <div class="cell-md-6">
                            @if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
                            {
                                <input data-prepend="Departure Date:" autocomplete="off" id="FinishDate" name="FinishDate" value="" data-role="calendarpicker" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                            }
                            else
                            {
                                <input data-prepend="Departure Date:" data-min-date="@DateTime.Now" autocomplete="off" id="FinishDate" name="FinishDate" value="" data-role="calendarpicker" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                            }
                        </div>
                        <div class="cell-md-6">
                            <input style="font-size:12px;" data-role="timepicker" data-seconds="false" data-value="0" id="FinishTime" name="FinishTime">
                        </div>
                    </div>*@
                <div class="row mb-2">
                    <div class="cell">
                        <textarea data-role="textarea" data-prepend="Motive:" name="Motive" id="Motive" data-validate="required maxlength=400" data-chars-counter="#chars-counter" data-chars-counter-template=" $1 char(s)" autocomplete="off" value="">@Model.Motive</textarea>
                        <p style="font-size: 0.8rem" id="chars-counter"> 0 char(s)</p>
                    </div>
                </div>
            </div>
        </div>
        @Html.Hidden("ShiftChange", Model.ShiftChange)
        @Html.Hidden("Process", Model.Process)
        @Html.Hidden("UserCreated", Model.UserCreated)
        @Html.Hidden("Date", Model.Date)
        <div class="row">
            <div class="dialog-actions d-flex flex-justify-between w-100">
                @if (HttpContext.Current.Session["CanSaveExtraordinaryTransport"].Equals(true) && Model.Status != 2)
                {
                    <div>
                        <button id="SaveTransport" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button>
                        <span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span>
                    </div>
                }
                @*<div>
                    @if (Model.ShiftChange)
                    {
                        <input type="checkbox" data-role="checkbox" data-style="2" checked="checked" data-caption="Shift Change" class="shiftChangeCheck">
                    }
                    else
                    {
                        <input type="checkbox" data-role="checkbox" data-style="2" data-caption="Shift Change" class="shiftChangeCheck">
                    }
