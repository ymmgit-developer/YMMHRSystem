    </form>
</div>

<div data-overlay="true" data-width="800" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="MultiSelectAssociateImporter" name="MultiSelectAssociateImporter" class="dialog" data-role="dialog">
    @Html.Partial("~/Areas/YMMHRSystem/Views/Shared/MultiSelectAssociateList.cshtml", associateList)
</div>

<div style="display:none;">
    @if (Role.QueryRole("HR", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
    {<input type="number" value=1 id="RolUser" />}
    else { <input type="number" value=0 id="RolUser" /> }
</div>

<script>
    var table;
    $(document).ready(function () {

        table = $('#dttAssociateList').DataTable({
            responsive: true,
            retrieve: true,
            searching: false,
            info: false,
            compact: true,
            paging: false,
            ordering: false,
            scrollY: "33vh",
            scrollCollapse: true,
        });

        setInterval(function () {
            if ($("#Cost").length) {
                $("#Cost").val($("#Cost").val().match(/^-?\d+(?:\.\d{0,2})?/));
            }
        }, 500);
    });

    function RemoveAssociate(names) {
        var aux;
        $("#dttAssociateList td").each(function () {
            if ($(this).text() === names) {
                aux = $(this).parents('tr');
            }
        });
        table.row(aux).remove().draw();
        Metro.toast.create("Associate removed.", null, null, "bg-green fg-white");
    }

    $(".shiftChangeCheck").on("change", function (e) {
        if (e.target.checked) {
            $('#ShiftChange').val("true");
        } else {
            $('#ShiftChange').val("false");
        }
    });
</script>
<script>
    function onBeforeTagAdd(val) {

        var regex = /^[a-zA-Z0-9._-]+@@yachiyo.com.mx\s*$/;
        if (regex.test(val)) {
            return true;
        } else {
            regex = /^[a-zA-Z0-9._-]+@@yachiyo-ind.co.jp\s*$/;
            if (regex.test(val)) {
                return true;
            } else {
                regex = /^[a-zA-Z0-9._-]+@@motherson.com\s*$/;
                if (regex.test(val)) {
                    return true;
                } else {
                    Metro.toast.create("Enter a correct email", null, null, "bg-red fg-white");
                    return false;
                }
            }
        }
    }
</script>

<script>
    /*Sugererencias de correo*/
    $(document).ready(function () {
        // Inicializa Flexdatalist en el input
        $('.flexdatalist').flexdatalist({
            minLength: 1,
            searchIn: ['value', 'name'],  // Buscar en el valor y en el nombre
            searchByWord: true,
            multiple: true,
            textProperty: 'label',
            valueProperty: 'value',
            visibleProperties: ["value", "label"],
            searchContain: true,
            maxShownResults: 100
        });
    });
</script>

<script>
    $(document).ready(function () {
        // Función para inicializar Flatpickr con la configuración adecuada
        function initializeFlatpickr(mode) {
            // Obtener el valor del rol del usuario
            var rolUser = parseInt($("#RolUser").val());

            // Configurar minDate basado en el rol
            var minDateValue = rolUser == 1 ? null : "today";

            // Inicializar flatpickr
            $("#StartDate_Front").flatpickr({
                mode: mode,
                minDate: minDateValue,
                dateFormat: "Y-m-d",
                onClose: function (selectedDates, dateStr, instance) {
                    updateStartAndFinishDate(mode, selectedDates);
                }
            });
        }

        // Inicializar Flatpickr con la configuración predeterminada (One day)
        initializeFlatpickr("single");

        // Manejar cambios en los radio buttons
        $("input[name='TypeTransport']").change(function () {
            // Destruir el Flatpickr existente
            $("#StartDate_Front").flatpickr().destroy();

            // Obtener el valor del radio button seleccionado
            let mode;
            if ($("#radio_oneday").is(":checked")) {
                mode = "single";
            } else if ($("#radio_range").is(":checked")) {
                mode = "range";
            } else if ($("#radio_multiday").is(":checked")) {
                mode = "multiple";
            }

            // Inicializar Flatpickr con el nuevo modo
            initializeFlatpickr(mode);
        });
    });
</script>
<script>
    $(document).ready(function () {

        // Habilita los inputs StartTime y FinishTime en cuanto cambia StartDate_Front
        $('#StartDate_Front').change(function () {
            if (!$('#NoStartTime').is(':checked')) { // Verifica si NoStartTime no está marcado
                $('#StartTime').prop('disabled', false);
            } else {
                $('#StartTime').prop('disabled', true);
            }
            $('#FinishTime').prop('disabled', false);
        });

        // Deshabilita/Habilita el input StartTime si se desmarca el checkbox NoStartTime
        $('#NoStartTime').change(function () {
            if ($(this).is(':checked')) {
                $('#StartTime').prop('disabled', true);
            } else {
                $('#StartTime').prop('disabled', false);
            }
        });

        // Si el tipo de solicitud es multi-day se asigna la lista de fechas al input ListMultiday
        $("#Motive").on("click", function () {
            var TypeTransportSelect = $("input[name='TypeTransport']:checked").val();
            if (TypeTransportSelect == 3) {
                $("#ListMultiday").val($("#StartDate_Front").val());
            }
        });
    });
</script>

<script>
    // Función para actualizar los valores de StartDate y FinishDate
    function updateStartAndFinishDate(mode, selectedDates) {
        if (mode === "single") {
            let date = selectedDates[0] ? selectedDates[0].toISOString().split('T')[0] : '';
            $("#StartDate").val(date);
            $("#FinishDate").val(date);
        } else if (mode === "range") {
            let startDate = selectedDates[0] ? selectedDates[0].toISOString().split('T')[0] : '';
            let finishDate = selectedDates[1] ? selectedDates[1].toISOString().split('T')[0] : '';
            $("#StartDate").val(startDate);
            $("#FinishDate").val(finishDate);
        } else if (mode === "multiple") {
            // Aquí se tomará la primera fecha para StartDate y la última fecha para FinishDate
            let startDate = selectedDates[0] ? selectedDates[0].toISOString().split('T')[0] : '';
            let finishDate = selectedDates[selectedDates.length - 1] ? selectedDates[selectedDates.length - 1].toISOString().split('T')[0] : '';
            $("#StartDate").val(startDate);
            $("#FinishDate").val(finishDate);
        }
    }
</script>