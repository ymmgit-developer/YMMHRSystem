    @{
        Layout = null;
    }
    <div class="dialog-title">Attachment</div>
    <div class="dialog-content">
        <form id="WorkerAttachmentForm" data-role="validator" data-on-validate-form="AddAttachment()" action="javascript:">

            <div class="row">
                <div class="cell-md-12">
                    <div class="row mb-2">
                        <div class="cell">
                            <input type="file" id="file" name="file" data-role="file" data-validate="required" data-button-title="<span class='mif-folder'></span>">
                            <span class="invalid_feedback">
                                Upload a file
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="dialog-actions d-flex px-0 flex-justify-between mt-2">
                <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>
                <div><button id="AddAttachment" class="button my-control-colors"><span class="mif-checkmark">  OK</span></button></div>
            </div>
        </form>
    </div>

