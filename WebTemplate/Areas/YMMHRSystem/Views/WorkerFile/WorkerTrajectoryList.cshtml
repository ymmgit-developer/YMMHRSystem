@model List<DtoTrajectory>
@using YMMHRSystemLogic
@{
    Layout = null;
}
<div class="row d-flex flex-align-center flex-justify-between mx-5">
    <div><h6 style="color:black">Trajectory</h6></div>
    <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenTrajectoryDialog()"><span class="mif-plus"></span><span class="actionButton"> New </span></a></div>
</div>
<div id="TrajectoryTable">
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttTrajectory" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">File</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="@item.TrajectoryId">
                    <td style="text-align: center">
                        <span> @Path.GetFileName(item.FileName) </span>
                    </td>
                    <td style="text-align: center">
                        <a class="button small my-button-colors" style="cursor: pointer; " href="@Url.Action("GetTrajectoryPDF", "WorkerFile", new { Area = "YMMHRSystem" , trajectoryId = item.TrajectoryId })" target="_blank"><span class="mif-eye"></span><span class="actionButton"> View </span></a>
                        @if (HttpContext.Current.Session["CanDeleteWorkerFile"].Equals(true))
                        {
                            <a class="button small bg-red fg-white"style="cursor: pointer; " onclick="ConfirmDeleteTrajectory(@item.TrajectoryId)"><span class="mif-bin"></span><span class="actionButton"> Delete </span></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteTrajectory" name="DeleteTrajectory" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeleteTrajectory()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeleteTrajectory')"> No</button>
    </div>
</div>

<script>
    var tableTrajectory;
    $(document).ready(function () {

        tableTrajectory = $('#dttTrajectory').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "20vh",
            scrollCollapse: true
        });

    });

    function DeleteTrajectory() {
        var aux;
        $("#dttTrajectory tr").each(function () {
            if ($(this).attr("id") == window.$TrajectoryId) {
                aux = $(this);
            }
        });
        $.ajax({
            method: "POST",
            url: window.$DeleteTrajectory,
            data: { trajectoryId: window.$TrajectoryId },
            success: function (result) {
                if (result === "true") {
                    Metro.toast.create("Trajectory deleted.", null, null, "bg-green fg-white");
                } else {
                    Metro.toast.create("Error deleting the trajectory.", null, null, "bg-red fg-white");
                }
                tableTrajectory.row(aux).remove().draw();
                Metro.dialog.close('#DeleteTrajectory')
            }
        });
    }

    function ConfirmDeleteTrajectory(trajectoryId) {
        var dialog = Metro.getPlugin('#DeleteTrajectory', 'dialog');
        dialog.open();
        window.$TrajectoryId = trajectoryId;
    }
</script>

