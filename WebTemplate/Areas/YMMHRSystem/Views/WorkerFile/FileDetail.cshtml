<script>
    $(document).ready(function () {

        $(".genderCheck").on("change", function (e) {
            debugger;
            if (e.target.checked) {
                if (e.target.id == "Female") {
                    $('#Gender').val("false");
                } else {
                    $('#Gender').val("true");
                }
            }
        });

        //RouteSelected();
    });

    function RouteSelected() {
        var routeId = $("#RouteSelect option:selected").val();
        var StopSelect = Metro.getPlugin("#Stop", 'select');

        var output = [];

        $.ajax({
            type: 'POST',
            url: $LoadStops,
            data: { routeId: routeId },
            success: function (response) {
                StopSelect.data([]);
                var data = response;
                $.each(data, function (key, val) {
                    output.push("<option value='" + data[key].StopName + "'>" + data[key].StopName + "</option>");
                });
                StopSelect.data(output.join(''));
            },
        });
    }
</script>
