@model DtoWorkerFile
@using YMMHRSystemLogic
@{
    ViewBag.Title = "Worker Record";
    List<string> educationList = new List<string> { "Primary School", "High School", "Preparatory", "University" };
    List<string> jobList = new List<string> { "Associate Production", "Team Leader", "Coordinator", "Assistant Manager", "Manager", "Senior Manager", "Vice President", "President", "Intern", "Senior Technical Staff" };
    List<string> civilStatusList = new List<string> { "Single", "Married", "Free Union", "Divorced", "Widower" };
    List<string> workerTypeList = new List<string> { "Union Worker", "Staff" };
    YMMHRSystemLogic.Route route = new YMMHRSystemLogic.Route();
    var routeList = route.LoadMultiple();
    var stopList = route.GetRouteStopList(route.GetRouteId(Model.Route));
    Process process = new Process();
    var processList = process.LoadMultiple();
}
<script src="~/Areas/YMMHRSystem/Scripts/WorkerFile.js"></script>
<script>
    $LoadStops = '@Url.Action("LoadStops", "WorkerFile", new { area = "YMMHRSystem" })';
