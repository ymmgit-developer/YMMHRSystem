                            }
                            else
                            {
                                <input type="text" name="GetAdmissionDate" id="GetAdmissionDate" data-role="input" readonly="readonly" data-prepend="Admission Date:" autocomplete="off" value="@(Model.AdmissionDate?.ToShortDateString())">
