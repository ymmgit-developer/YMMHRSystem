@model DtoWarning
@using YMMHRSystemLogic
@{
    Layout = null;
}
<div class="dialog-title">Warning</div>
<div class="dialog-content">
    <form id="WorkerWarningForm" data-role="validator" data-on-validate-form="AddWarning()" action="javascript:">

        <div class="row">
            <div class="cell-md-12">
                <div class="row mb-2">
                    <div class="cell">
                        <input data-prepend="Date:" id="GetDate" name="GetDate" value="" data-validate="required" data-role="calendarpicker" data-cls-calendar="compact" data-input-format="%d/%m/%y">
                        <span class="invalid_feedback">
                            Enter a Date
                        </span>
                        @Html.Hidden("Date", Model.Date)
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <textarea data-role="textarea" data-prepend="Motive:" name="Motive" id="Motive" data-validate="required" autocomplete="off" value=""></textarea>
                        <span class="invalid_feedback">
                            Enter a Motive
                        </span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <input type="file" id="file" name="file" data-role="file" data-validate="required" data-button-title="<span class='mif-folder'></span>">
                        <span class="invalid_feedback">
                            Upload a file
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="dialog-actions d-flex px-0 flex-justify-between mt-2">
            <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>
            <div><button id="AddWarning" class="button my-control-colors"><span class="mif-checkmark"> OK</span></button></div>
        </div>
    </form>
</div>

