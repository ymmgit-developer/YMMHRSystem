@model DtoAdmission
    @using YMMHRSystemLogic
    @{
        Layout = null;
    }
    <div class="dialog-title">Admission</div>
    <div class="dialog-content">
        <form id="WorkerAdmissionForm" data-role="validator" data-on-validate-form="AdmitWorker()" action="javascript:">

            <div class="row">
                <div class="cell-md-12">
                    <input data-prepend="Date:" id="GetDate" name="GetDate" value="" data-validate="required" data-role="calendarpicker" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                    <span class="invalid_feedback">
                        Enter a Date
                    </span>
                    @Html.Hidden("Admission", Model.Admission)
                </div>
            </div>
            <div class="dialog-actions d-flex px-0 flex-justify-between mt-2">
                <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>
                <div><button id="AdmitWorker" class="button my-control-colors"><span class="mif-checkmark"> OK</span></button></div>
            </div>
        </form>
    </div>
