@model List<DtoLegalRequirement>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Legal Requirement";
}
<head>
    <script>
        $SaveLegalRequirement = '@Url.Action("SaveLegalRequirement", "LegalRequirement", new { area = "YMMHRSystem" })';
        $LoadLegalRequirement = '@Url.Action("LoadLegalRequirement", "LegalRequirement", new { area = "YMMHRSystem" })';
        $DeleteLegalRequirement = '@Url.Action("DeleteLegalRequirement", "LegalRequirement", new { area = "YMMHRSystem" })';
        $AttachmentDialog = '@Url.Action("AttachmentDialog", "LegalRequirement", new { area = "YMMHRSystem" })';
        $AddAttachment = '@Url.Action("AddAttachment", "LegalRequirement", new { area = "YMMHRSystem" })';
        $AttachmentListDialog = '@Url.Action("AttachmentListDialog", "LegalRequirement", new { area = "YMMHRSystem" })';
        $DeleteAttachment = '@Url.Action("DeleteAttachmentFile", "LegalRequirement", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/LegalRequirement.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Legal Requirement</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSaveLegalRequirement"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' onclick="LegalRequirementDetailDialog(0)"><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>

    <div class="container-fluid mt-5">
        <div id="LegalRequirementTable" data-step="2" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttLegalRequirements" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th style="text-align: center">Legal Procedure</th>
                        <th style="text-align: center">Institution</th>
                        <th style="text-align: center">Emission Date</th>
                        <th style="text-align: center">Expiration Date</th>
                        <th style="text-align: center">Renewal Date</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                    <tr>

                        <td style="text-align: center">
                            <span> @item.LegalProcedure </span>
                        </td>

                        <td style="text-align: center">
                            <span> @item.Institution </span>
                        </td>

                        <td style="text-align: center">
                            <span> @(item.EmissionDate?.ToString("dd/MM/yyyy")) </span>
                        </td>

                        <td style="text-align: center">
                            <span> @(item.ExpirationDate?.ToString("dd/MM/yyyy")) </span>
                        </td>

                        <td style="text-align: center">
                            <span> @(item.RenewalDate?.ToString("dd/MM/yyyy")) </span>
                        </td>

                        <td style="text-align: center">
                            <a class="button bg-black fg-white" style="cursor: pointer;" onclick="LegalRequirementDetailDialog(@item.LegalRequirementId)"><span class="mif-eye"></span><span class="actionButton"> View</span></a>
                            @if (HttpContext.Current.Session["CanDeleteLegalRequirement"].Equals(true))
                            {
                                <a class="button bg-blue fg-white" style="cursor: pointer;" onclick="OpenAttachmentListDialog(@item.LegalRequirementId)"><span class="mif-file-text"></span><span class="actionButton"> Attach</span></a>
                                <a class="button bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteLegalRequirement(@item.LegalRequirementId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                            }
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <!---------------------------------------DIALOGS ------------------------------------------>
    <div data-overlay="true" data-width="1000" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="LegalRequirementDetail" name="LegalRequirementDetail" class="dialog" data-role="dialog">
    </div>
    <div data-overlay="true" data-width="700" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="AttachmentListDialog" name="AttachmentListDialog" class="dialog" data-role="dialog">
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="Error" name="Error" class="dialog" data-role="dialog">
        <div class="dialog-title">Error</div>
        <div class="dialog-content">
            <p>- Legal requirement already exists</p>
        </div>
        <div class="dialog-actions ml-auto">
            <button class="button alert" onclick="Metro.dialog.close('#Error')">OK</button>
        </div>
    </div>

    <div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteLegalRequirement" name="DeleteLegalRequirement" class="dialog" data-role="dialog">
        <div class="dialog-title">Delete</div>
        <div class="dialog-content"> Are you sure you want to delete this item?</div>
        <div class="dialog-actions ml-auto">
            <button class="button my-control-colors" onclick="DeleteLegalRequirement()"> Yes</button>
            <button class="button alert" onclick="Metro.dialog.close('#DeleteLegalRequirement')"> No</button>
        </div>
    </div>
</body>

