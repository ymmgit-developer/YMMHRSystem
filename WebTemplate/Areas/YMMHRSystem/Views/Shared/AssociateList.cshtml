@model List<DtoWorkerFile>
@using YMMHRSystemLogic;
@{
    Layout = null;
}
<div class="dialog-title">Associate Importer</div>

<div class="dialog-content">
    <div class="container-fluid">
        <div id="AssociateTable">
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttAssociates" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th style="text-align: center">Names</th>
                        <th style="text-align: center">Process</th>
                        <th style="text-align: center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td style="text-align: center">
                                <span> @item.Names </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Process </span>
                            </td>

                            <td style="text-align: center">
                                <a class="button my-control-colors fg-white" style="cursor: pointer; " onclick="SelectAssociate('@item.Names', '@item.Process')"><span class="mif-checkmark"></span><span class="actionButton"> Select</span></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="dialog-actions d-flex flex-justify-start w-100">
</div>
<script>
    $(document).ready(function () {

        $('#dttAssociates').DataTable({
            responsive: true,
            retrieve: true,
            searching: true,
            info: false,
            compact: true,
            paging: false,
            ordering: false,
            scrollY: "30vh",
            scrollCollapse: true,
        });
    });
</script>
