@model DtoRoom
@using YMMHRSystemLogic
@{
    Layout = null;
}
<div class="dialog-title">Room</div>

<div class="dialog-content">
    <form id="RoomForm" data-role="validator" data-on-validate-form="AddRoom()" action="javascript:">
        <div class="row">
            <div class="cell-md-12">
                <div class="row mb-2">
                    <div class="cell">
                        <input type="text" name="Name" id="Name" data-role="input" data-prepend="Name:" data-validate="required" autocomplete="off" value="@Model.Name">
                        <span class="invalid_feedback">
                            Enter a Name
                        </span>
                    </div>
                </div>
            </div>
        </div>
        @Html.Hidden("UserCreated", Model.UserCreated)
        @Html.Hidden("DateAdded", Model.DateAdded)
        <div class="row">
            <div class="row mt-2 mb-2">
                <div class="dialog-actions p-0 d-flex flex-justify-start">
                    @if (HttpContext.Current.Session["CanSaveRoom"].Equals(true))
                    {
                        <div><button id="SaveRoom" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button></div>
                    }
                    <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>
                    
                </div>
            </div>
        </div>
    </form>
</div>


