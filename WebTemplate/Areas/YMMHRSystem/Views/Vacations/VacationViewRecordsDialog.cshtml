@model List<DtoVacationRecordView>
@using YMMHRSystemLogic

@{
    ViewBag.Title = "Vacation Records Details";
}

<head>
    <script>
        /*Variables Global*/
        $EditRecordVacation = '@Url.Action("EditRegisterVacation", "Vacations", new { area = "YMMHRSystem" })';
    </script>
</head>

<div class="dialog-title">Vacation Data</div>
<div class="dialog-content">
    <div class="container">
        <table id="dttHistoryVacations" class="display" style="width:100%;">
            <thead>
                <tr>
                    <th style="text-align: center">Show dates</th> <!-- Columna para el botón de expansión -->
                    <th style="text-align: center">Date request</th>
                    <th style="text-align: center">Days Request</th>
                    <th style="text-align: center">Comments</th>
                    <th style="text-align: center">Status</th>
                    <th style="text-align: center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var data in Model)
                {
                    <tr>
                        <td style="text-align: center">
                            <button class="btn-details" data-id="@data.VacationId">+</button>
                        </td>
                        <td style="text-align: center">
                            <span>@data.DateRequest.ToString("yyyy-MM-dd")</span>
                        </td>
                        <td style="text-align: center">
                            <span>@data.DaysRequest</span>
                        </td>
                        <td style="text-align: center">
                            <span>@data.Comments</span>
                        </td>
                        <td style="text-align: center">
                            <span>@data.GralStatus</span>
                        </td>
                        <td style="text-align: center">
                            <a class="button small bg-gray fg-black" style="cursor: pointer;" onclick="">
                                <span class="mif-backward"></span><span class="actionButton"> Revert</span>
                            </a>
                            <a class="button small bg-black fg-white" style="cursor: pointer;" onclick="RecordsVacationsEditDialog(@data.VacationId)">
                                <span class="mif-eye"></span><span class="actionButton"> Edit</span></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Contenedor de filas hijas -->
<div id="child-rows-container" style="display: none;">
    @foreach (var data in Model)
    {
        <div id="child-row-@data.VacationId" class="child-row-content">
            <ul style="list-style-type: none; margin: 0; padding: 0;">
                @foreach (var date in data.DatesList)
                {
                    <li>@date</li>
                }
            </ul>
        </div>
    }
</div>

<script>
    $(document).ready(function () {
        // Inicializa DataTables
        var table = $('#dttHistoryVacations').DataTable({
            responsive: true,
            searching: true,
            info: true,
            paging: true,
            ordering: false,
            scrollY: "50vh",
            scrollCollapse: true,
            columnDefs: [
                { orderable: false, targets: [0] } // Desactiva el orden en la columna del botón
            ]
        });

        // Maneja la expansión/cierre de filas hijas
        $('#dttHistoryVacations tbody').on('click', '.btn-details', function () {
            var $button = $(this);
            var tr = $(this).closest('tr');
            var row = table.row(tr);

            if (row.child.isShown()) {
                // Cierra la fila hija
                row.child.hide();
                $button.text('+');
            } else {
                // Abre la fila hija
                var vacationId = tr.find('.btn-details').data('id');
                var childContent = $('#child-row-' + vacationId).html();
                row.child(childContent).show();
                $button.text('-');
            }
        });
    });

    function RecordsVacationsEditDialog(vacationId)
    {
        $.ajax({
            method: "POST",
            url: window.$EditRecordVacation,
            data: { VacationId: vacationId },
            success: function (result) {
                var dialog = Metro.getPlugin("#VacationEditDialog", "dialog");
                dialog.setContent(result);
                setTimeout(function () { dialog.open(); }, 100);
            }
        });
    }
</script>
