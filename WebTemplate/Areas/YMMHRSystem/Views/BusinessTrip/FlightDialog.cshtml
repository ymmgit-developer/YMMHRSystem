@model DtoFlightReservation
@using YMMHRSystemLogic
@{
    Layout = null;
    var typeList = new List<string> { "One Way", "Round Trip" };
    var flightClassList = new List<string> { "First", "Business", "Economy" };
    var whoPaysList = new List<string> { "YMM", "Others" };
    var costCenterList = new List<string> { "", "1100 PFT BM Direct", "1200 PFT 2P Assy Direct", "1300 PFT Injection", "1500 PFT Semi Direct", "2100 SR Direct", "2200 SR Semi Direct", "6100 Quality", "6200 Maintenance", "6300 Production Control", "6400 New Model", "7100 Accounting", "7200 Purchasing", "7300 IT", "7400 HR", "7500 Staff Administration", "7600 EHS" };
}
<div class="dialog-title">Flight</div>

<div class="dialog-content">
    <form id="FlightForm" data-role="validator" data-on-validate-form="AddFlight()" action="javascript:">
        @Html.Hidden("FlightReservationId", Model.FlightReservationId)
        @if (Role.QueryRole("GA", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
        {
            <div class="row mb-1">
                <div class="cell-md-4">
                    <input type="text" data-prepend="Flight Number:" name="FlightNumber" id="FlightNumber" value="@Model.FlightNumber" data-role="input" data-validate="required" autocomplete="off">
                </div>
                <div class="cell-md-4">
                    <input type="text" data-prepend="Departure Airport:" name="DepartureAirport" id="DepartureAirport" value="@Model.DepartureAirport" data-role="input" data-validate="required" autocomplete="off">
                </div>
                <div class="cell-md-4">
                    <input type="text" data-prepend="Arrival Airport:" name="ArrivalAirport" id="ArrivalAirport" value="@Model.ArrivalAirport" data-role="input" data-validate="required" autocomplete="off">
                </div>
            </div>
            <div class="row mb-1">
                <div class="cell-md-4">
                    <input data-prepend="Flight Date:" data-min-date="@DateTime.Now" id="FlightDate" name="FlightDate" value="@(Model.FlightDate?.ToString("yyyy-MM-dd") == "1900-01-01" ? DateTime.Now.ToString("dd-MM-yyyy") : Model.FlightDate?.ToString("dd-MM-yyyy"))" autocomplete="off" data-role="calendarpicker" data-validate="required" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                </div>
                <div class="cell-md-4">
                    <input style="font-size:12px;" data-role="timepicker" data-seconds="false" data-value="@Model.FlightTime" id="FlightTime" name="FlightTime">
                </div>
                <div class="cell-md-4">
                    <select data-role="select" id="Class" name="Class" data-prepend="Flight Class:">
                        @foreach (var item in flightClassList)
                        {
                            if (Model.Class == item)
                            {
                                <option selected value="@item">@item</option>
                            }
                            else
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="row mb-1">
                <div class="cell-md-4">
                    <input type="text" data-prepend="Airline:" name="Airline" id="Airline" value="@Model.Airline" data-role="input" data-validate="required" autocomplete="off">
                </div>
                <div class="cell-md-4">
                    <input type="text" data-role="input" value="@Model.Cost" data-prepend="Cost: $" id="Cost" name="Cost">
                </div>
                <div class="cell-md-4">
                    <input type="text" data-role="input" value="@Model.FlyerMilesCard" data-prepend="Flyer Miles Card:" id="FlyerMilesCard" name="FlyerMilesCard">
                </div>
            </div>
            <div class="row mb-1">
                <div class="cell-md-4">
                    <select data-role="select" id="CompanyPaying" name="CompanyPaying" data-prepend="Cost Company:">
                        @foreach (var item in whoPaysList)
                        {
                            if (Model.CompanyPaying == item)
                            {
                                <option selected value="@item">@item</option>
                            }
                            else
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    </select>
                </div>
                <div class="cell-md-4">
                    <select data-role="select" id="CostCenter" name="CostCenter" data-prepend="Cost Center:">
                        @foreach (var item in costCenterList)
                        {
                            if (Model.CostCenter == item)
                            {
                                <option selected value="@item">@item</option>
                            }
                            else
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    </select>
                </div>
                <div class="cell-md-4">
                    <select data-role="select" id="FlightType" name="FlightType" data-prepend="Flight Type:">
                        @foreach (var item in typeList)
                        {
                            if (Model.FlightType == item)
                            {
                                <option selected value="@item">@item</option>
                            }
                            else
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    </select>
                </div>
            </div>
        }
            <div class="row mb-1">
                <div class="cell-md-4">
                    <input type="text" value="@Model.PassengerName" name="PassengerName" id="PassengerName" data-prepend="Passenger:" data-role="input" data-validate="required" autocomplete="off">
                </div>
                <div class="cell-md-4">
                    <input type="text" value="@Model.PassportNumber" name="PassportNumber" id="PassportNumber" data-prepend="Passport No.:" data-role="input" data-validate="required" autocomplete="off">
                </div>
                <div class="cell-md-4">
                    <input data-prepend="Departure:" data-min-date="@DateTime.Now" id="Departure" name="Departure" value="@(Model.Departure?.ToString("yyyy-MM-dd") == "1900-01-01" ? DateTime.Now.ToString("dd-MM-yyyy") : Model.Departure?.ToString("dd-MM-yyyy"))" autocomplete="off" data-role="calendarpicker" data-validate="required" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                </div>              
            </div>
        <div class="row mb-1">
            <div class="cell-md-4">
                <input data-prepend="Arrival:" data-min-date="@DateTime.Now" id="Arrival" name="Arrival" value="@(Model.Arrival?.ToString("yyyy-MM-dd") == "1900-01-01" ? DateTime.Now.ToString("dd-MM-yyyy") : Model.Arrival?.ToString("dd-MM-yyyy"))" autocomplete="off" data-role="calendarpicker" data-validate="required" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
            </div>
            <div class="cell-md-4">
                <input type="text" name="Origin" id="Origin" data-role="input" data-prepend="Origin:" data-validate="required" autocomplete="off" value="@Model.Origin">
            </div>
            <div class="cell-md-4">
                <input type="text" name="Destination" id="Destination" data-role="input" data-prepend="Destination:" data-validate="required" autocomplete="off" value="@Model.Destination">
            </div>
        </div>
        <div class="row">
            <div class="row mt-2 mb-1">
                <div class="dialog-actions p-0 d-flex flex-justify-start">
                    @if (HttpContext.Current.Session["CanSaveBusinessTrip"].Equals(true))
                    {
                        <div><button id="SaveFlight" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button></div>
                    }
                    <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>

                </div>
            </div>
        </div>
    </form>
</div>

<script>
    $(document).ready(function () {

        setInterval(function () {
            $("#Cost").val($("#Cost").val().toString().match(/^-?\d+(?:\.\d{0,2})?/));
        }, 500);
    });
</script>
