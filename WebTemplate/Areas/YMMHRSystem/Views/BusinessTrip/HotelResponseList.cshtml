@model List<DtoHotelReservation>
@using YMMHRSystemLogic
@{
    Layout = null;
}

<div class="dialog-content">
    <div class="row d-flex flex-align-center flex-justify-between mx-2">
        <div><h6>Hotel</h6></div>
        <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenHotelDialog(0)"><span class="mif-plus"></span><span class="actionButton"> Add </span></a></div>
    </div>
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttHotelResponse" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">Hotel Name</th>
                <th style="text-align: center">Reservation No.</th>
                <th style="text-align: center">Check In</th>
                <th style="text-align: center">Check Out</th>
                <th style="text-align: center">Address</th>
                <th style="text-align: center">Telephone</th>
                <th style="text-align: center">Cost Center</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr id="@item.HotelReservationId">
                <td style="text-align: center">
                    <span> @item.HotelName </span>
                </td>

                <td style="text-align: center">
                    <span> @item.ReservationNumber </span>
                </td>

                <td style="text-align: center">
                    <span> @(item.CheckIn?.ToShortDateString()) </span>
                </td>

                <td style="text-align: center">
                    <span> @(item.CheckOut?.ToShortDateString()) </span>
                </td>

                <td style="text-align: center">
                    <span> @item.Address </span>
                </td>

                <td style="text-align: center">
                    <span> @item.Telephone </span>
                </td>

                <td style="text-align: center">
                    <span> @item.CostCenter </span>
                </td>

                <td style="text-align: center">
                    <a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenHotelDialog(@item.HotelReservationId)"><span class="mif-eye"></span></a>
                    @if (HttpContext.Current.Session["CanDeleteBusinessTrip"].Equals(true))
                    {
                        <a class="button small bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteHotelResponse(@item.HotelReservationId)"><span class="mif-bin"></span></a>
                    }
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteHotelResponse" name="DeleteHotelResponse" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeleteHotelResponse()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeleteHotelResponse')"> No</button>
    </div>
</div>

<script>
    var tableHotel;
    $(document).ready(function () {

        tableHotel = $('#dttHotelResponse').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "20vh",
            scrollCollapse: true,
            initComplete: function () {
                $("#HotelResponseTable").show();
            }
        });

    });


    function DeleteHotelResponse() {
        var aux;
        $("#dttHotelResponse tr").each(function () {
            if ($(this).attr("id") == window.$HotelId) {
                aux = $(this);
            }
        });

        $.ajax({
            method: "POST",
            url: window.$DeleteHotel,
            data: { hotelReservationId: window.$HotelId },
            success: function (result) {
                if (result === "true") {
                    Metro.toast.create("Hotel deleted.", null, null, "bg-green fg-white");
                    setTimeout(function () { location.reload(); }, 1000);
                } else {
                    Metro.toast.create("Error deleting the hotel or business trip is complete.", null, null, "bg-red fg-white");
                }
                Metro.dialog.close('#DeleteHotelResponse')
            }
        });
    }

    function ConfirmDeleteHotelResponse(hotelId) {
        var dialog = Metro.getPlugin('#DeleteHotelResponse', 'dialog');
        dialog.open();
        window.$HotelId = hotelId;
    }
</script>


