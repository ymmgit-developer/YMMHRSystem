@model List<DtoTaxiReservation>
@using YMMHRSystemLogic
@{
    Layout = null;
}

<div class="dialog-content">
    <div class="row d-flex flex-align-center flex-justify-between mx-2">
        <div><h6>Taxis</h6></div>
        <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenTaxiDialog(0)"><span class="mif-plus"></span><span class="actionButton"> Add </span></a></div>
    </div>
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttTaxiResponse" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">Quote Number</th>
                <th style="text-align: center">Date</th>
                <th style="text-align: center">Pick up Time</th>
                <th style="text-align: center">Pick up Place</th>
                <th style="text-align: center">Destination</th>
                <th style="text-align: center">Cost Company</th>
                <th style="text-align: center">Driver Name</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr id="@item.TaxiReservationId">
                <td style="text-align: center">
                    <span> @item.QuoteNumber </span>
                </td>

                <td style="text-align: center">
                    <span> @(item.PickupDate?.ToShortDateString()) </span>
                </td>

                <td style="text-align: center">
                    <span> @item.PickupTime </span>
                </td>

                <td style="text-align: center">
                    <span> @item.PickupPlace </span>
                </td>

                <td style="text-align: center">
                    <span> @item.Destination </span>
                </td>

                <td style="text-align: center">
                    <span> @item.CompanyPaying </span>
                </td>

                <td style="text-align: center">
                    <span> @item.DriverName </span>
                </td>

                <td style="text-align: center">
                    <a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenTaxiDialog(@item.TaxiReservationId)"><span class="mif-eye"></span></a>
                    @if (HttpContext.Current.Session["CanDeleteBusinessTrip"].Equals(true))
                    {
                        <a class="button small bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteTaxiResponse(@item.TaxiReservationId)"><span class="mif-bin"></span></a>
                    }
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteTaxiResponse" name="DeleteTaxiResponse" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeleteTaxiResponse()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeleteTaxiResponse')"> No</button>
    </div>
</div>

<script>
    var tableTaxiResponse;
    $(document).ready(function () {

        tableTaxiResponse = $('#dttTaxiResponse').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "20vh",
            scrollCollapse: true,
            initComplete: function () {
                $("#TaxiResponseTable").show();
            }
        });

    });


    function DeleteTaxiResponse() {
        var aux;
        $("#dttTaxiResponse tr").each(function () {
            if ($(this).attr("id") == window.$TaxiId) {
                aux = $(this);
            }
        });

        $.ajax({
            method: "POST",
            url: window.$DeleteTaxi,
            data: { taxiReservationId: window.$TaxiId },
            success: function (result) {
                if (result === "true") {
                    Metro.toast.create("Taxi deleted.", null, null, "bg-green fg-white");
                    setTimeout(function () { location.reload(); }, 1000);
                } else {
                    Metro.toast.create("Error deleting the taxi or business trip is complete.", null, null, "bg-red fg-white");
                }
                Metro.dialog.close('#DeleteTaxiResponse')
            }
        });
    }

    function ConfirmDeleteTaxiResponse(taxiId) {
        var dialog = Metro.getPlugin('#DeleteTaxiResponse', 'dialog');
        dialog.open();
        window.$TaxiId = taxiId;
    }
</script>


