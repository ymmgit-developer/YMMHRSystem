@model List<DtoCarRentalReservation>
@using YMMHRSystemLogic
@{
    Layout = null;
}

<div class="dialog-content">
    <div class="row d-flex flex-align-center flex-justify-between mx-2">
        <div><h6>Car Rentals</h6></div>
        <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenCarRentalDialog(0)"><span class="mif-plus"></span><span class="actionButton"> Add </span></a></div>
    </div>
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttCarRentalDetail" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">Driver Name</th>
                <th style="text-align: center">License Number</th>
                <th style="text-align: center">Pick up Date</th>
                <th style="text-align: center">Pick up Time</th>
                <th style="text-align: center">Pick up Place</th>
                <th style="text-align: center">Return Date</th>
                <th style="text-align: center">Return Time</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr id="@item.CarRentalReservationId">
                <td style="text-align: center">
                    <span> @item.DriverName </span>
                </td>

                <td style="text-align: center">
                    <span> @item.LicenseNumber </span>
                </td>

                <td style="text-align: center">
                    <span> @(item.PickupDate?.ToShortDateString()) </span>
                </td>

                <td style="text-align: center">
                    <span> @item.PickupTime </span>
                </td>

                <td style="text-align: center">
                    <span> @item.PickupPlace </span>
                </td>

                <td style="text-align: center">
                    <span> @(item.ReturnDate?.ToShortDateString()) </span>
                </td>

                <td style="text-align: center">
                    <span> @item.ReturnTime </span>
                </td>

                <td style="text-align: center">
                    <a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenCarRentalDialog(@item.CarRentalReservationId)"><span class="mif-eye"></span></a>
                    @if (HttpContext.Current.Session["CanDeleteBusinessTrip"].Equals(true))
                    {
                        <a class="button small bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteCarRentalDetail(@item.CarRentalReservationId)"><span class="mif-bin"></span></a>
                    }
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteCarRentalDetail" name="DeleteCarRentalDetail" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeleteCarRentalDetail()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeleteCarRentalDetail')"> No</button>
    </div>
</div>

<script>
    var tableCarRental;
    $(document).ready(function () {

        tableCarRental = $('#dttCarRentalDetail').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "20vh",
            scrollCollapse: true,
            initComplete: function () {
                $("#CarRentalDetailTable").show();
            }
        });

    });


    function DeleteCarRentalDetail() {
        var aux;
        $("#dttCarRentalDetail tr").each(function () {
            if ($(this).attr("id") == window.$CarRentalId) {
                aux = $(this);
            }
        });

        $.ajax({
            method: "POST",
            url: window.$DeleteCarRental,
            data: { carRentalReservationId: window.$CarRentalId },
            success: function (result) {
                if (result === "true") {
                    Metro.toast.create("Car rental deleted.", null, null, "bg-green fg-white");
                    setTimeout(function () { location.reload(); }, 1000);
                } else {
                    Metro.toast.create("Error deleting the car rental or business trip is complete.", null, null, "bg-red fg-white");
                }
                Metro.dialog.close('#DeleteCarRentalDetail')
            }
        });
    }

    function ConfirmDeleteCarRentalDetail(carRentalId) {
        var dialog = Metro.getPlugin('#DeleteCarRentalDetail', 'dialog');
        dialog.open();
        window.$CarRentalId = carRentalId;
    }
</script>


