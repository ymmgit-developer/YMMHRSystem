@model List<DtoFlightReservation>
@using YMMHRSystemLogic
@{
    Layout = null;
}

<div class="dialog-content">
    <div class="row d-flex flex-align-center flex-justify-between mx-2">
        <div><h6>Flights</h6></div>
        <div><a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenFlightDialog(0)"><span class="mif-plus"></span><span class="actionButton"> Add </span></a></div>
    </div>
    <!---------------------------------------TABLA ------------------------------------------>
    <table id="dttFlightDetail" class="display compact" style="width:100%">
        <thead>
            <tr>
                <th style="text-align: center">Passenger</th>
                <th style="text-align: center">Passport No.</th>
                <th style="text-align: center">Type</th>
                <th style="text-align: center">Departure</th>
                <th style="text-align: center">Arrival</th>
                <th style="text-align: center">Origin</th>
                <th style="text-align: center">Destination</th>
                <th style="text-align: center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr id="@item.FlightReservationId">
                <td style="text-align: center">
                    <span> @item.PassengerName </span>
                </td>

                <td style="text-align: center">
                    <span> @item.PassportNumber </span>
                </td>

                <td style="text-align: center">
                    <span> @item.FlightType </span>
                </td>

                <td style="text-align: center">
                    <span> @(item.Departure?.ToShortDateString()) </span>
                </td>

                <td style="text-align: center">
                    <span> @(item.Arrival?.ToShortDateString()) </span>
                </td>

                <td style="text-align: center">
                    <span> @item.Origin </span>
                </td>

                <td style="text-align: center">
                    <span> @item.Destination </span>
                </td>

                <td style="text-align: center">
                    <a class="button small my-button-colors" style="cursor: pointer;" onclick="OpenFlightDialog(@item.FlightReservationId)"><span class="mif-eye"></span></a>
                    @if (HttpContext.Current.Session["CanDeleteBusinessTrip"].Equals(true))
                    {
                        <a class="button small bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteFlightDetail(@item.FlightReservationId)"><span class="mif-bin"></span></a>
                    }
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteFlightDetail" name="DeleteFlightDetail" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeleteFlightDetail()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeleteFlightDetail')"> No</button>
    </div>
</div>

<script>
    var tableFlight;
    $(document).ready(function () {

        tableFlight = $('#dttFlightDetail').DataTable({
            retrieve: true,
            responsive: true,
            searching: false,
            info: false,
            paging: false,
            ordering: false,
            scrollY: "20vh",
            scrollCollapse: true,
            initComplete: function () {
                $("#FlightDetailTable").show();
            }
        });

    });


    function DeleteFlightDetail() {
        var aux;
        $("#dttFlightDetail tr").each(function () {
            if ($(this).attr("id") == window.$FlightId) {
                aux = $(this);
            }
        });

        $.ajax({
            method: "POST",
            url: window.$DeleteFlight,
            data: { flightReservationId: window.$FlightId },
            success: function (result) {
                if (result === "true") {
                    Metro.toast.create("Flight deleted.", null, null, "bg-green fg-white");
                    setTimeout(function () { location.reload(); }, 1000);
                } else {
                    Metro.toast.create("Error deleting the flight or business trip is complete.", null, null, "bg-red fg-white");
                }
                Metro.dialog.close('#DeleteFlightDetail')
            }
        });
    }

    function ConfirmDeleteFlightDetail(flightId) {
        var dialog = Metro.getPlugin('#DeleteFlightDetail', 'dialog');
        dialog.open();
        window.$FlightId = flightId;
    }
</script>


