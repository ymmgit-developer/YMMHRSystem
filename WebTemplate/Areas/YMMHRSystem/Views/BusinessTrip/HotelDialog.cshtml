@model DtoHotelReservation
@using YMMHRSystemLogic
@{
    Layout = null;
    var whoPaysList = new List<string> { "YMM", "Others" };
    var costCenterList = new List<string> { "", "1100 PFT BM Direct", "1200 PFT 2P Assy Direct", "1300 PFT Injection", "1500 PFT Semi Direct", "2100 SR Direct", "2200 SR Semi Direct", "6100 Quality", "6200 Maintenance", "6300 Production Control", "6400 New Model", "7100 Accounting", "7200 Purchasing", "7300 IT", "7400 HR", "7500 Staff Administration", "7600 EHS" };
}
<div class="dialog-title">Hotel</div>

<div class="dialog-content">
    <form id="HotelForm" data-role="validator" data-on-validate-form="AddHotel()" action="javascript:">
        @Html.Hidden("HotelReservationId", Model.HotelReservationId)
        @if (Role.QueryRole("GA", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
        {
            <div class="row mb-1">
                <div class="cell-md-4">
                    <input type="text" data-prepend="Hotel:" name="HotelName" id="HotelName" value="@Model.HotelName" data-role="input" data-validate="required" autocomplete="off">
                </div>
                <div class="cell-md-4">
                    <input type="text" data-prepend="Reservation No.:" name="ReservationNumber" id="ReservationNumber" value="@Model.ReservationNumber" data-role="input" data-validate="required" autocomplete="off">
                </div>
                <div class="cell-md-4">
                    <input type="text" data-prepend="Telephone:" name="Telephone" id="Telephone" value="@Model.Telephone" data-role="input" data-validate="required" autocomplete="off">
                </div>
            </div>
            <div class="row mb-1">
                <div class="cell-md-6">
                    <input type="text" data-role="input" value="@Model.Cost" data-prepend="Cost: $" id="Cost" name="Cost">
                </div>
                <div class="cell-md-6">
                    <input type="text" data-prepend="Address:" name="Address" id="Address" value="@Model.Address" data-role="input" autocomplete="off">
                </div>
            </div>
        }
            <div class="row mb-1">
                <div class="cell-md-4">
                    <input data-prepend="Check-In:" id="CheckIn" name="CheckIn" value="@(Model.CheckIn?.ToString("yyyy-MM-dd") == "1900-01-01" ? DateTime.Now.ToString("dd-MM-yyyy") : Model.CheckIn?.ToString("dd-MM-yyyy"))" autocomplete="off" data-role="calendarpicker" data-min-date="@DateTime.Now" data-validate="required" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                </div>
                <div class="cell-md-4">
                    <input data-prepend="Check-Out:" id="CheckOut" name="CheckOut" value="@(Model.CheckOut?.ToString("yyyy-MM-dd") == "1900-01-01" ? DateTime.Now.ToString("dd-MM-yyyy") : Model.CheckOut?.ToString("dd-MM-yyyy"))" autocomplete="off" data-role="calendarpicker" data-min-date="@DateTime.Now" data-validate="required" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
                </div>
                <div class="cell-md-4">
                    <input type="text" value="@Model.Place" name="Place" id="Place" data-role="input" data-prepend="Place:" data-validate="required" autocomplete="off">
                </div>
            </div>
        <div class="row mb-1">
            <div class="cell-md-6">
                <select data-role="select" id="CompanyPaying" name="CompanyPaying" data-prepend="Cost Company:">
                    @foreach (var item in whoPaysList)
                    {
                        if (Model.CompanyPaying == item)
                        {
                            <option selected value="@item">@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>
            </div>
            <div class="cell-md-6">
                <select data-role="select" id="CostCenter" name="CostCenter" data-prepend="Cost Center:">
                    @foreach (var item in costCenterList)
                    {
                        if (Model.CostCenter == item)
                        {
                            <option selected value="@item">@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="row mb-1">
            <div class="cell-md-12">
                <textarea data-role="textarea" data-prepend="Notes:" name="Notes" id="Notes" data-validate="required" autocomplete="off" value="@Model.Notes">@Model.Notes</textarea>
            </div>
        </div>

        <div class="row">
            <div class="row mt-2 mb-1">
                <div class="dialog-actions p-0 d-flex flex-justify-start">
                    @if (HttpContext.Current.Session["CanSaveBusinessTrip"].Equals(true))
                    {
                        <div><button id="SaveHotel" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button></div>
                    }
                    <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>

                </div>
            </div>
        </div>
    </form>
</div>
<script>
    $(document).ready(function () {

        setInterval(function () {
            $("#Cost").val($("#Cost").val().toString().match(/^-?\d+(?:\.\d{0,2})?/));
        }, 500);
    });
</script>

