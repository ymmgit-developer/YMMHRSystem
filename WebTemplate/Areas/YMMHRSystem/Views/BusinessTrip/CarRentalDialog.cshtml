@model DtoCarRentalReservation
@using YMMHRSystemLogic
@{
    Layout = null;
    var carTypeList = new List<string> { "Hatchback", "Sedan", "SUV" };
    var whoPaysList = new List<string> { "YMM", "Others" };
    var costCenterList = new List<string> { "", "1100 PFT BM Direct", "1200 PFT 2P Assy Direct", "1300 PFT Injection", "1500 PFT Semi Direct", "2100 SR Direct", "2200 SR Semi Direct", "6100 Quality", "6200 Maintenance", "6300 Production Control", "6400 New Model", "7100 Accounting", "7200 Purchasing", "7300 IT", "7400 HR", "7500 Staff Administration", "7600 EHS" };
}
<div class="dialog-title">Car Rental</div>

<div class="dialog-content">
    <form id="CarRentalForm" data-role="validator" data-on-validate-form="AddCarRental()" action="javascript:">
        @Html.Hidden("CarRentalReservationId", Model.CarRentalReservationId)
        @if (Role.QueryRole("GA", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"])))
        {
            <div class="row mb-1">
                <div class="cell-md-4">
                    <input type="text" data-prepend="Reservation Number:" name="ReservationNumber" id="ReservationNumber" value="@Model.ReservationNumber" data-role="input" data-validate="required" autocomplete="off">
                </div>
                <div class="cell-md-4">
                    <select data-role="select" id="CarType" name="CarType" data-prepend="Car Type:">
                        @foreach (var item in carTypeList)
                        {
                            if (Model.CarType == item)
                            {
                                <option selected value="@item">@item</option>
                            }
                            else
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    </select>
                </div>
                <div class="cell-md-4">
                    <input type="text" data-role="input" value="@Model.Cost" data-prepend="Cost: $" id="Cost" name="Cost">
                </div>
            </div>
            <div class="row mb-1">
                <div class="cell-md-6">
                    <select data-role="select" id="CostCenter" name="CostCenter" data-prepend="Cost Center:">
                        @foreach (var item in costCenterList)
                        {
                            if (Model.CostCenter == item)
                            {
                                <option selected value="@item">@item</option>
                            }
                            else
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    </select>
                </div>
                <div class="cell-md-6">
                    <select data-role="select" id="CompanyPaying" name="CompanyPaying" data-prepend="Cost Company:">
                        @foreach (var item in whoPaysList)
                        {
                            if (Model.CompanyPaying == item)
                            {
                                <option selected value="@item">@item</option>
                            }
                            else
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    </select>
                </div>
            </div>
        }
        <div class="row mb-1">
            <div class="cell-md-6">
                <input type="text" value="@Model.DriverName" name="DriverName" id="DriverName" data-role="input" data-prepend="Driver Name:" data-validate="required" autocomplete="off">
            </div>
            <div class="cell-md-6">
                <input type="text" value="@Model.LicenseNumber" name="LicenseNumber" id="LicenseNumber" data-role="input" data-prepend="License Number:" data-validate="required" autocomplete="off">
            </div>
        </div>
        <div class="row mb-1">
            <div class="cell-md-4">
                <input data-prepend="Pickup Date:" id="PickupDate" name="PickupDate" value="@(Model.PickupDate?.ToString("yyyy-MM-dd") == "1900-01-01" ? DateTime.Now.ToString("dd-MM-yyyy") : Model.PickupDate?.ToString("dd-MM-yyyy"))" autocomplete="off" data-role="calendarpicker" data-min-date="@DateTime.Now" data-validate="required" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
            </div>
            <div class="cell-md-4">
                <input style="font-size:12px;" data-role="timepicker" data-seconds="false" data-value="@Model.PickupTime" id="PickupTime" name="PickupTime">
            </div>
            <div class="cell-md-4">
                <input type="text" value="@Model.PickupPlace" name="PickupPlace" id="PickupPlace" data-role="input" data-prepend="Pickup Place:" data-validate="required" autocomplete="off">
            </div>
        </div>
        <div class="row mb-1">
            <div class="cell-md-4">
                <input data-prepend="Return Date:" id="ReturnDate" name="ReturnDate" value="@(Model.ReturnDate?.ToString("yyyy-MM-dd") == "1900-01-01" ? DateTime.Now.ToString("dd-MM-yyyy") : Model.ReturnDate?.ToString("dd-MM-yyyy"))" autocomplete="off" data-role="calendarpicker" data-min-date="@DateTime.Now" data-validate="required" data-cls-calendar="compact" data-format="%d/%m/%Y" data-input-format="%d/%m/%Y">
            </div>
            <div class="cell-md-4">
                <input style="font-size:12px;" data-role="timepicker" data-seconds="false" data-value="@Model.ReturnTime" id="ReturnTime" name="ReturnTime">
            </div>
            <div class="cell-md-4">
                <input type="text" value="@Model.ReturnPlace" name="ReturnPlace" id="ReturnPlace" data-role="input" data-prepend="Return Place:" data-validate="required" autocomplete="off">
            </div>
        </div>

        <div class="row">
            <div class="row mt-2 mb-1">
                <div class="dialog-actions p-0 d-flex flex-justify-start">
                    @if (HttpContext.Current.Session["CanSaveBusinessTrip"].Equals(true))
                    {
                        <div><button id="SaveCarRental" class="button my-control-colors"><span class="mif-floppy-disk"> Save</span> </button></div>
                    }
                    <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>

                </div>
            </div>
        </div>
    </form>
</div>
<script>
    $(document).ready(function () {

        setInterval(function () {
            $("#Cost").val($("#Cost").val().toString().match(/^-?\d+(?:\.\d{0,2})?/));
        }, 500);
    });
</script>


