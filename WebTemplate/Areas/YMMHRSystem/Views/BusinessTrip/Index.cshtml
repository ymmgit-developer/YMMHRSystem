@model List<DtoBusinessTrip>

@using YMMHRSystemLogic

@{
    ViewBag.Title = "Business Trips";
}
<head>
    <script>
        $SaveBusinessTrip = '@Url.Action("SaveBusinessTrip", "BusinessTrip", new { area = "YMMHRSystem" })';
        $LoadBusinessTrip = '@Url.Action("LoadBusinessTrip", "BusinessTrip", new { area = "YMMHRSystem" })';
        $DeleteBusinessTrip = '@Url.Action("DeleteBusinessTrip", "BusinessTrip", new { area = "YMMHRSystem" })';
    </script>
    <script src="~/Areas/YMMHRSystem/Scripts/BusinessTrip.js"></script>
</head>

<!------- BARRA  ------>
<body style="width: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Business Trips</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSaveBusinessTrip"].Equals(true))
            {
                <a class="button flat-button" style="color:white" data-step="1" data-intro="This button will open a window that allows the user to add a new register" data-position='auto' href="@Url.Action("NewBusinessTrip", "BusinessTrip", new { Area = "YMMHRSystem" })"><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home", new { Area = "" })">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"> <span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>
    <div class="container-fluid mt-5">
        <div id="BusinessTripTable" style="display: none" data-step="2" data-intro="This table shows all the registered information" data-position='auto'>
            <!---------------------------------------TABLA ------------------------------------------>
            <table id="dttBusinessTrips" class="display" style="width:100%;">
                <thead>
                    <tr>
                        <th style="text-align: center">Applicant</th>
                        <th style="text-align: center">Process</th>
                        <th style="text-align: center">Date</th>
                        <th style="text-align: center">Status</th>
                        <th style="text-align: center" data-step="3" data-intro="These are the action buttons for editing, viewing or deleting"
                            data-position='auto'>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td style="text-align: center">
                                <span> @item.Associate </span>
                            </td>

                            <td style="text-align: center">
                                <span> @item.Process </span>
                            </td>

                            <td style="text-align: center">
                                <span> @(item.DateAdded.ToShortDateString()) </span>
                            </td>

                            <td style="text-align: center">
                                <span> @(item.Status == 1 ? "New" : "Complete") </span>
                            </td>

                            <td style="text-align: center">
                                <a class="button bg-black fg-white" style="cursor: pointer;" href="@Url.Action("LoadBusinessTrip", "BusinessTrip", new { Area = "YMMHRSystem" , nMR4z = item.BusinessTripId })"><span class="mif-eye"></span><span class="actionButton"> View</span></a>
                                @if (HttpContext.Current.Session["CanSaveBusinessTrip"].Equals(true) && item.Status == 2 && (Role.QueryRole("GA", Convert.ToInt64(Session["UserId"])) || Role.QueryRole("Admin", Convert.ToInt64(Session["UserId"]))))
                                {
                                    <a class="button bg-green fg-white" style="cursor: pointer;" href="@Url.Action("CreateDocument", "BusinessTrip", new { area = "YMMHRSystem" , nMR4z = item.BusinessTripId })"><span class="mif-file-excel"></span><span class="actionButton"> Report</span></a>
                                }
                                @if (HttpContext.Current.Session["CanSaveBusinessTrip"].Equals(true) && item.Status == 1)
                                {
                                    <a class="button bg-red fg-white" style="cursor: pointer;" onclick="ConfirmDeleteBusinessTrip(@item.BusinessTripId)"><span class="mif-bin"></span><span class="actionButton"> Delete</span></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>

<div data-overlay="true" data-default-action="false" data-close-button="true" data-overlay-click-close="true" id="DeleteBusinessTrip" name="DeleteBusinessTrip" class="dialog" data-role="dialog">
    <div class="dialog-title">Delete</div>
    <div class="dialog-content"> Are you sure you want to delete this item?</div>
    <div class="dialog-actions ml-auto">
        <button class="button my-control-colors" onclick="DeleteBusinessTrip()"> Yes</button>
        <button class="button alert" onclick="Metro.dialog.close('#DeleteBusinessTrip')"> No</button>
    </div>
</div>
