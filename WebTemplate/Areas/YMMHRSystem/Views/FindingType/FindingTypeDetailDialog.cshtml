@model DtoFindingType
@using YMMHRSystemLogic
@{
    Layout = null;
}
<div class="dialog-title">Finding Type</div>

<div class="dialog-content">
    <form id="FindingTypeForm" data-role="validator" data-on-validate-form="AddFindingType()" action="javascript:">
        <div class="row">
            <div class="cell-md-12">
                <div class="row mb-2">
                    <div class="cell">
                        <input type="text" name="Name" id="Name" data-role="input" data-prepend="Name:" data-validate="required" class="shift" autocomplete="off" value="@Model.Name">
                        <span class="invalid_feedback">
                            Enter a Name
                        </span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="cell">
                        <input type="text" name="Points" id="Points" data-role="spinner" autocomplete="off" data-buttons-position="right" data-min-value="0" value="@Model.Name">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="row mt-2 mb-2">
                <div class="dialog-actions p-0 d-flex flex-justify-start">
                    @if (HttpContext.Current.Session["CanSaveFindingType"].Equals(true))
                    {
                        <div><button id="SaveFindingType" class="button my-control-colors"><span class="mif-floppy-disk"></span> Save </button></div>
                    }
                    <div><span id="Preloader" class="mif-2x mif-spinner4 ani-spin" style="visibility:hidden"></span></div>

                </div>
            </div>
        </div>
    </form>
</div>


