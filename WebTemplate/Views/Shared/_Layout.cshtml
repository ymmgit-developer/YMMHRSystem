@using System.Globalization
@using YMMHRSystemLogic

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@ViewBag.Title</title>
    @Scripts.Render("~/bundles/jquery")
    @Styles.Render("~/Content/css")
    @*@Scripts.Render("~/bundles/modernizr")*@

    <!-- METRO_UI -->
    @*<script src="https://cdn.metroui.org.ua/current/metro.js"></script>*@

    <!-- DataTables Core -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/v/dt/dt-2.0.8/af-2.7.0/b-3.0.2/cr-2.0.3/date-1.5.2/fc-5.0.1/fh-4.0.1/kt-2.12.1/r-3.0.2/rg-1.5.0/rr-1.5.0/sc-2.4.3/sb-1.7.1/sp-2.3.1/sl-2.0.3/datatables.min.css" />
    <script type="text/javascript" src="https://cdn.datatables.net/v/dt/dt-2.0.8/af-2.7.0/b-3.0.2/cr-2.0.3/date-1.5.2/fc-5.0.1/fh-4.0.1/kt-2.12.1/r-3.0.2/rg-1.5.0/rr-1.5.0/sc-2.4.3/sb-1.7.1/sp-2.3.1/sl-2.0.3/datatables.min.js"></script>

    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.10/pdfmake.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.10/vfs_fonts.js"></script>

    <!-- DataTables Extensions -->
    <link href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>

    <link href="https://cdn.datatables.net/select/2.0.3/css/select.dataTables.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.datatables.net/select/2.0.3/js/dataTables.select.min.js"></script>

    <link href="https://nightly.datatables.net/searchpanes/css/searchPanes.dataTables.css?_=1abb1d155e39f9bdd42ce7accaeb459d.css" rel="stylesheet" type="text/css" />
    <script src="https://nightly.datatables.net/searchpanes/js/dataTables.searchPanes.js?_=1abb1d155e39f9bdd42ce7accaeb459d"></script>

    @*jQueryflexdatalist, jQuery autocomplete plugin with support for <datalist>: https://projects.sergiodinislopes.pt/flexdatalist/*@
    <link href="https://cdnjs.cloudflare.com/ajax/libs/jquery-flexdatalist/2.3.0/jquery.flexdatalist.css" rel="stylesheet" type="text/css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-flexdatalist/2.3.0/jquery.flexdatalist.min.js"></script>

    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/timepicker/1.3.5/jquery.timepicker.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/timepicker/1.3.5/jquery.timepicker.min.js"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/airbnb.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    @*<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>*@

    <script src="https://cdn.jsdelivr.net/npm/alertifyjs@1.14.0/build/alertify.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/alertifyjs@1.14.0/build/css/alertify.min.css" />

    <script src="~/Scripts/intro.js"></script>
    <link href="~/Content/introjs.css" rel="stylesheet" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.30.1/moment.min.js" crossorigin="anonymous"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

    <style>
        .actionButton {
            display: inline;
        }

        .alt-header:nth-child(1), .h1:nth-child(1), .h2:nth-child(1), .h3:nth-child(1), .h4:nth-child(1), .h5:nth-child(1), .h6:nth-child(1), .header:nth-child(1), .leader:nth-child(1), .sub-alt-header:nth-child(1), .sub-header:nth-child(1), .sub-leader:nth-child(1), h1:nth-child(1), h2:nth-child(1), h3:nth-child(1), h4:nth-child(1), h5:nth-child(1), h6:nth-child(1) {
            margin-top: 1rem;
        }

        #titleBar {
            position: -webkit-sticky;
            position: sticky;
            top: 53px;
            z-index: 1;
            background-color: rgb(54, 54, 54);
            color: white;
        }

        .file, .input, .select, .spinner, .tag-input, .textarea, input[type=datetime-local], input[type=email], input[type=file], input[type=month], input[type=number], input[type=password], input[type=search], input[type=tel], input[type=text], input[type=time], input[type=url], input[type=week], select, textarea {
            font-size: 0.95rem;
        }

        @@media (max-width: 768px) {

            body {
                margin-bottom: 50px;
            }

            #titleBar {
                position: fixed;
                top: unset;
                bottom: 0;
                left: 0;
                right: 0;
                z-index: 100;
            }

            .actionButton {
                display: none;
            }
        }
    </style>
</head>

@{
    User user = new User();
    DtoUser dtoUser = user.Load(Convert.ToInt64(Session["UserId"]));
    int indice = 0;
}
<body style="width: 100%;overflow:visible;">
    <div id="appbar" data-expand-point="md" data-role="appbar">
        <a class="brand no-hover">
            <img src="~/Content/Resources/whitey.png" />
        </a>

        <ul class="app-bar-menu">
            @foreach (DtoPermission i in dtoUser.PermissionList.Where((value) => value.FatherCategoryId == indice))
            {
                <li>
                    @{
                        var submenu = dtoUser.PermissionList.Count(value => value.FatherCategoryId == i.TaskCategoryId);
                        if (i.Name.ToUpper() == "SETTINGS")
                        {
                            if (submenu > 0)
                            {
                                if (i.Url == "#")
                                {
                                    <a href="@i.Url"><span class="@i.Icon"></span></a>
                                }
                                else
                                {
                                    if (string.IsNullOrWhiteSpace(i.Url.Split('/')[3]))
                                    {
                                        <a href="@Url.Action(i.Url.Split('/')[2], i.Url.Split('/')[1], new { Area = "" })"><span class="@i.Icon"></span></a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action(i.Url.Split('/')[2], i.Url.Split('/')[1], new { Area = "YMMHRSystem"})"><span class="@i.Icon"></span></a>
                                    }
                                }

                            }
                        }
                        else
                        {
                            i.Name = i.Name.ToLower().ToString();
                            i.Name = CultureInfo.CurrentCulture.TextInfo.ToTitleCase(i.Name);
                            if (i.Url == "#")
                            {
                                <a href="@i.Url" class="dropdown-toggle"><span class="@i.Icon"></span> @i.Name</a>
                            }
                            else
                            {
                                if (string.IsNullOrWhiteSpace(i.Url.Split('/')[3]))
                                {
                                    <a href="@Url.Action(i.Url.Split('/')[2], i.Url.Split('/')[1], new { Area = "" })" class="dropdown-toggle"><span class="@i.Icon"></span> @i.Name</a>
                                }
                                else
                                {
                                    <a href="@Url.Action(i.Url.Split('/')[2], i.Url.Split('/')[1], new { Area = "YMMHRSystem"})" class="dropdown-toggle"><span class="@i.Icon"></span> @i.Name</a>
                                }
                            }
                        }


                        if (submenu > 0)
                        {
                            <ul class="d-menu" data-role="dropdown">

                                @foreach (DtoPermission j in dtoUser.PermissionList.Where((value) => value.FatherCategoryId == i.TaskCategoryId))
                                {
                                    @*<li class="divider bg-orangered"></li>*@
                                    <li>
                                        @{
                                            var submenu2 = dtoUser.PermissionList.Count(value => value.FatherCategoryId == j.TaskCategoryId);
                                            j.Name = j.Name.ToLower().ToString();
                                            j.Name = CultureInfo.CurrentCulture.TextInfo.ToTitleCase(j.Name);


                                            if (submenu2 > 0)
                                            {
                                                if (i.Url == "#")
                                                {
                                                    <a href="@j.Url" class="dropdown-toggle"><span class="@j.Icon" title="@j.Icon"></span> @j.Name</a>
                                                }
                                                else
                                                {
                                                    if (string.IsNullOrWhiteSpace(j.Url.Split('/')[3]))
                                                    {
                                                        <a href="@Url.Action(j.Url.Split('/')[2], j.Url.Split('/')[1], new { Area = "" })" class="dropdown-toggle">
                                                            <span class="@j.Icon" title="@j.Icon"></span> @j.Name
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a href="@Url.Action(j.Url.Split('/')[2], j.Url.Split('/')[1], new { Area = "YMMHRSystem"})" class="dropdown-toggle">
                                                            <span class="@j.Icon" title="@j.Icon"></span> @j.Name
                                                        </a>
                                                    }

                                                }

                                                <ul class="d-menu" data-role="dropdown">

                                                    @foreach (DtoPermission k in dtoUser.PermissionList.Where((value) => value.FatherCategoryId == j.TaskCategoryId))
                                                    {
                                                        @*<li class="divider bg-orangered"></li>*@
                                                        <li>
                                                            @{
                                                                k.Name = k.Name.ToLower().ToString();
                                                                k.Name = CultureInfo.CurrentCulture.TextInfo.ToTitleCase(k.Name);
                                                                if (string.IsNullOrWhiteSpace(k.Url.Split('/')[3]))
                                                                {
                                                                    <a href="@Url.Action(k.Url.Split('/')[2], k.Url.Split('/')[1], new { Area = "" })"><span class="@k.Icon" title="@k.Icon"></span> @k.Name</a>
                                                                }
                                                                else
                                                                {
                                                                    <a href="@Url.Action(k.Url.Split('/')[2], k.Url.Split('/')[1], new { Area = "YMMHRSystem" })"><span class="@k.Icon" title="@k.Icon"></span> @k.Name</a>
                                                                }

                                                            }
                                                        </li>

                                                    }<!--TERCER FOREACH-->
                                                </ul>
                                            }
                                            else
                                            {
                                                if (string.IsNullOrWhiteSpace(j.Url.Split('/')[3]))
                                                {
                                                    <a href="@Url.Action(j.Url.Split('/')[2], j.Url.Split('/')[1], new { Area = "" })">
                                                        <span class="@j.Icon" title="@j.Icon"></span> @j.Name
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a href="@Url.Action(j.Url.Split('/')[2], j.Url.Split('/')[1], new { Area = "YMMHRSystem" })">
                                                        <span class="@j.Icon" title="@j.Icon"></span> @j.Name
                                                    </a>
                                                }

                                            }
                                        }
                                    </li>

                                }<!--SEGUNDO FOREACH-->
                            </ul>
                        }
                    }
                </li>
            }<!--PRIMER FOREACH-->
        </ul>
        <div class="app-bar-container ml-auto">
            @Html.Partial("_LoginPartial", dtoUser)
        </div>

    </div>
    <div class="container-fluid">
        <div class="cell">
            @RenderBody()
        </div>
    </div>


</body>
</html>

<script>
    $(document).ready(function () {
        // Temporizador de 40 minutos (2400 segundos) var timerDuration = 40 * 60 * 1000;
        // Temporizador de 120 minutos (2400 segundos)
        var timerDuration = 2 * 60 * 60 * 1000;

        // Iniciar temporizador
        var sessionTimer = setTimeout(function () {
            alertify.alert("Expired Session", "Your session has expired. Click OK to reload the page.", function () {
                location.reload();
            });
        }, timerDuration);

        // Resetear el temporizador en algún evento (ej: al hacer clic en cualquier parte de la página)
        $(document).on('click keypress', function () {
            clearTimeout(sessionTimer);
            sessionTimer = setTimeout(function () {
                alertify.alert("Expired Session", "Your session has expired. Click OK to reload the page.", function () {
                    location.reload();
                });
            }, timerDuration);
        });
    });
</script>
