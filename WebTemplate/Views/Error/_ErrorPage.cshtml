
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    int error = ViewBag.Error;
    switch (error)
    {
        case 500:
            <img src="~/Images/Errores.png" style="width:80%; height:80%; display: block;
    margin-left: auto;
    margin-right: auto " alt="500">
            break;
        case 404:
            <img src="~/Images/Errores404.png" style="width: 80%; height: 80%; display: block;
    margin-left: auto;
    margin-right: auto " alt="404">
            break;
    }
}

