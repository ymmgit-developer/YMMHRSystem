@model List<DtoRole>
@using YMMHRSystemLogic
@{
    ViewBag.Title = "Roles";
    User user = new User();
}
<head>
    <title>Roles</title>
    <script>
        $EditRole = '@Url.Action("EditRole", "Role")';
        $DeleteRole = '@Url.Action("DeleteRole", "Role")';
    </script>
</head>
<script src="~/Scripts/AdminRole.js"></script>
<!------- BARRA  ------>
<body style="height: 100%">
    <div id="titleBar" class="d-flex flex-justify-start flex-align-center">
        <h5 class="pl-5">Roles</h5>
        <div class="ml-auto pr-5">
            @if (HttpContext.Current.Session["CanSaveRole"].Equals(true))
            {
                <a class="button flat-button" style="color:white" href="@Url.Action("AddNewRole", "Role")" data-step="1" data-intro="New user role" data-position='auto'><span class="mif-plus"></span><span class="actionButton"> New </span></a>
            }
            <a class="button flat-button" style="color:white" href="@Url.Action("Index", "Home")">
                <span class="mif-arrow-left"></span><span class="actionButton"> Back</span>
            </a>

            <a class="button flat-button" style="color:white" href="javascript:void(0);" onclick="introJs().start()"><span class="mif-question"></span><span class="actionButton"> Help </span></a>
        </div>
    </div>


    <!-----------------------------------FLEX GRID------------------------------>
    <div class="container-fluid mt-5">
        <table id="dttRoles" class="display" data-step="2" data-intro="Role List" data-position='auto'>
            <thead>
                <tr>
                    <!---------------------------------------TABLA ROL ------------------------------------------>
                    <th style="text-align: left">Role</th>
                    <th style="text-align: center">Description</th>
                    <th style="text-align: center" data-step="3" data-intro="Edit role button" data-position='auto'>Edit</th>
                    <th style="text-align: center" data-step="4" data-intro="Delete role button" data-position='auto'>Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span> @item.Name</span>
                        </td>
                        <td>
                            <span> @item.Description</span>
                        </td>
                        <td style="text-align: center">
                            <a class="mif-pencil" style="cursor: pointer;" href="@Url.Action("EditRole", "Role", new {nMR4z = item.RoleId})"></a>
                        </td>
                        <td style="text-align: center">
                            @if (HttpContext.Current.Session["CanDeleteRole"].Equals(true))
                            {
                                <a class="mif-bin" style="cursor: pointer;" onclick="OpenDeleteRolDialog(@item.RoleId)"></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!------------------------------------------------------------ELIMINAR DIALOG----------------------------------------------------------->
    <div data-overlay="true" data-default-action="false" data-role="dialog" id="DeleteRol" class="dialog">
        <div class="dialog-title">Delete Role</div>
        <div class="dialog-content"> Are you sure you want to delete this role?</div>
        <div class="dialog-actions">
            <button class="primary button" onclick="DeleteRol()"> Yes</button>
            <button class="button alert" onclick="CloseDeleteRolDialog()"> No</button>
        </div>
    </div>
</body>
