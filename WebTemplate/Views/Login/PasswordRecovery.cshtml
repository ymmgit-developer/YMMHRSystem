
@model YMMHRSystemLogic.DtoUser

@{
    Layout = null;
}

@Styles.Render("~/Content/css")
@Scripts.Render("~/bundles/modernizr")
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <style>
        .login-form {
            width: 350px;
            height: auto;
            top: 50%;
            margin-top: -160px;
        }
    </style>
    <script>
        $SaveUser = '@Url.Action("SendEmailPasswordRecovery", "Login")';
        $SaveUser = '@Url.Action("SendContactEmail", "Login")';

        function invalidForm() {
            var form = $(this);
            form.addClass("ani-ring");
            setTimeout(function () {
                form.removeClass("ani-ring");
            }, 1000);
        }

        function validateForm() {
            $(".login-form").animate({
                opacity: 0
            });
        }

    </script>
    <script src="~/Scripts/Login.js"></script>
    <title>Password Recovery</title>
</head>
<body class="h-vh-100 bg-brandColor2">
    <div class="login-form bg-white p-6 mx-auto border bd-default win-shadow" data-role="validator" action="javascript:" data-clear-invalid="2000" data-on-error-form="invalidForm" data-on-validate-form="validateForm">
        @using (Html.BeginForm("ChangePassword", "Login", FormMethod.Post, new { }))
        {
            <span class="mif-key mif-4x float-right" style="margin-top:-10px;"></span>
            <h2 class="text-light">Password Recovery</h2>
            <hr class="thin mt-4 mb-4 bg-white">
            <div class="form-group">
                <input type="password" id="Password" name="Password" data-role="input" data-prepend="<span class='mif-key'>" placeholder="Password" data-validate="required minlength=4">
            </div>
            <div class="form-group">
                <input type="password" id="ConfirmPassword" name="ConfirmPassword" data-role="input" data-prepend="<span class='mif-key'>" placeholder="Confirm Password" data-validate="required compare=Password">
            </div>
            <div class="form-group mt-10">
                <button class="button primary">Confirm</button>
            </div>
        }
    </div>

    @Scripts.Render("~/bundles/jquery")
</body>
